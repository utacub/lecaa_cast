hymeEmphasis":"Realzar el segmento desde la vocal tónica hasta el final conservando el acento natural.","derived":"Recortar las sílabas de la grabación natural correspondiente. Los tiempos empiezan en null. El resaltado cubre todas las unidades gráficas realmente audibles del recorte; no un solo grafema cuando suena una sílaba.","slowHighlightSchema":{"field":"voices.female.highlightSegments","pendingValue":null,"segment":{"start":"seconds in source audio","end":"seconds in source audio","unitIndices":"zero-based orthographic unit indices from corpus"},"validation":"Ordered non-overlapping intervals covering all word units. Timing must be reviewed against the actual recording. The natural word follows the connected model. Missing alignment keeps the activity in review mode."},"releaseGate":"Todas las rutas, tiempos y aprobaciones deben validarse por voz. La existencia de un archivo no acredita calidad fonética ni alineación. La falta de audio mantiene el material en revisión.","voice":"LECAA CAST utiliza exclusivamente voz femenina. Voces sintéticas generadas con ElevenLabs."},"sources":[{"name":"LECAA_CAST_programa_final_complet.docx","sha256":"2866639d7d35daffbe5e80ee06eba000e8ac6f649076c259da238274de69a521","extraction":"exact tables; initial/rime and syllable-unit mapping verified against all printed IPA and rhyme keys"},{"name":"LECAA v45.1.html","voice":"female","scope":"19 existing female isolated phoneme clips","sha256":"c08a0303fe5928f24d835d8b981c063579ed14e1c0496310287bc0abadf92682"},{"name":"LECAA_CAST_valoracions_fonemes.json","sha256":"c9a18f4343f49473d6e46acda3aff08362e4b644d5765d23ea4ffe76da2825ee","scope":"19 explicit user preferences"},{"name":"ElevenLabs_Locuciones_fonemas_faltantes.mp3","sha256":"df37538684d6633f8dcb19f4c6fedf7192d5edb0e155d18c5774872856328dc3","reference":"ElevenLabs_Locuciones_fonemas_faltantes.txt","scope":"Four new isolated-phoneme slots assigned in transcript order"}],"audioImported":true,"reusedFemalePhonemes":{"imported":1