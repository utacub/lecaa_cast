", "🦊": "data:image/png;base64,", "🐢": "data:image/png;base64,", "🐙": "data:image/png;base64,"};
// Guide clips are bound to explicit session events, never DOM appearance.
const GuideMotion={
 active:new Map(),timers:new Map(),speech:0,
 reduced(){return !guidesAnimated(S?.p)||!!S?.p?.pres?.reduceMotion||matchMedia('(prefers-reduced-motion: reduce)').matches;},
 bubbles(){
  const overlay=document.querySelector('.overlay .guide-bubble');
  return overlay?[overlay]:[...document.querySelectorAll('#app .stage .guide-bubble')];
 },
 cancelIdle(b){clearTimeout(this.timers.get(b));this.timers.delete(b);},
 stop(b){this.cancelIdle(b);this.active.get(b)?.finish();},
 reset(){for(const b of this.timers.keys())this.cancelIdle(b);for(const a of [...this.active.values()])a.finish();},
 play(b,n){
  if(!b?.isConnected||this.reduced()||document.hidden)return Promise.resolve();
  const src=GUIDE_CLIPS[b.dataset.guide]?.[n];if(!src)return Promise.resolve();
  this.stop(b);
  return new Promise(resolve=>{
   const still=b.querySelector('img')||h('img',{class:'guide-img',src:GUIDE_POSTERS[b.dataset.guide],alt:'','aria-hidden':'true'});
   const video=h('video',{class:'guide-video',playsinline:'',preload:'auto','aria-hidden':'true',tabindex:'-1'});
   video.muted=true;video.defaultMuted=true;video.playsInline=true;
   let settled=false,watchdog;
   const finish=()=>{
    if(settled)return;settled=true;clearTimeout(watchdog);
    video.onended=video.onerror=null;video.pause();video.removeAttribute('src');video.load();
    if(this.active.get(b)?.video===video)this.active.delete(b);
    if(b.isConnected){b.replaceChildren(still);b.dataset.motion='still';}
    resolve();
   };
   this.active.set(b,{video,finish});b.dataset.motion=String(n);
   // Keep the poster visible until a frame has decoded, avoiding white flashes.
   still.style.gridArea='1 / 1';video.style.gridArea='1 / 1';video.style.visibility='hidden';
   video.onplaying=()=>{video.style.visibility='visible';};
   video.onended=finish;video.onerror=finish;
   b.replaceChildren(still,video);video.src=src;
   watchdog=setTimeout(finish,15000);video.play().catch(finish);
  });
 },
 cue(n){
  const bubbles=this.bubbles();
  return Promise.all(bubbles.map(async b=>{await this.play(b,n);if(b.isConnected)this.schedule(b);}));
 },
 show(root,n){
  polishDOM(root);
  const bubbles=[...root.querySelectorAll('.guide-bubble')];
  return Promise.all(bubbles.map(async b=>{await this.play(b,n);if(b.isConnected)this.schedule(b);}));
 },
 schedule(b){
  this.cancelIdle(b);if(!b.isConnected||this.reduced())return;
  const timer=setTimeout(async()=>{
   this.timers.delete(b);
   if(!b.isConnected)return;
   if(!document.hidden&&!this.speech&&!this.active.has(b)&&(!S?.paused||b.closest('.overlay'))){
    let n;do{n=7+Math.floor(Math.random()*3);}while(n===b._lastIdle);
    b._lastIdle=n;await this.play(b,n);
   }
   if(b.isConnected)this.schedule(b);
  },12000+Math.random()*10000);
  this.timers.set(b,timer);
 },
 cleanup(){
  for(const b of this.timers.keys())if(!b.isConnected)this.cancelIdle(b);
  for(const [b,a] of this.active)if(!b.isConnected)a.finish();
 }
};
const motionMountStage=mountStage;
mountStage=function(...args){
 GuideMotion.reset();const result=motionMountStage(...args);
 GuideMotion.show(result.stage,result.stage.classList.contains('welcome')?1:4);
 return result;
};
const motionPauseSession=pauseSession;
pauseSession=function(...args){
 GuideMotion.reset();const result=motionPauseSession(...args);
 const overlay=[...document.querySelectorAll('.overlay')].at(-1);
 if(overlay){
  GuideMotion.show(overlay,6);
  const go=overlay.querySelector('.big-start'),resume=go?._act;
  if(resume)go._act=()=>{GuideMotion.reset();resume();for(const b of GuideMotion.bubbles())GuideMotion.schedule(b);};
 }
 return result;
};
const motionEndSession=endSession;
endSession=function(...args){
 GuideMotion.reset();const result=motionEndSession(...args);
 const app=document.getElementById('app');if(app.querySelector('.reward'))GuideMotion.show(app,3);
 return result;
};
const motionShowStart=showStart;
showStart=function(...args){GuideMotion.reset();return motionShowStart(...args);};
const motionAdultHome=adultHome;
adultHome=function(...args){GuideMotion.reset();return motionAdultHome(...args);};
const motionAskHelp=askHelp;
askHelp=function(...args){if(!S?.onHelp)GuideMotion.cue(5);return motionAskHelp(...args);};
const motionSay=Voice.say;
Voice.say=async function(...args){
 GuideMotion.speech++;
 try{return await motionSay.apply(this,args);}
 finally{GuideMotion.speech--;}
};
const motionFeedback=Voice.feedback;
Voice.feedback=async function(...args){
 const gesture=S&&!S.ended?GuideMotion.cue(2):Promise.resolve();
 await Promise.all([motionFeedback.apply(this,args),gesture]);
};
const motionObserver=new MutationObserver(()=>GuideMotion.cleanup());
motionObserver.observe(document.getElementById('app'),{childList:true,subtree:true});
document.addEventListener('visibilitychange',()=>{
 if(document.hidden)GuideMotion.reset();
 else for(const b of GuideMotion.bubbles())GuideMotion.schedule(b);
});
matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change',e=>{
 if(e.matches)GuideMotion.reset();else for(const b of GuideMotion.bubbles())GuideMotion.schedule(b);
});

