}
const shuffle = a => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
const pick = a => a[Math.floor(Math.random() * a.length)];
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const sleep = ms => new Promise(r => setTimeout(r, ms));
const fmtDate = t => new Date(t).toLocaleDateString("es-ES", { day: "numeric", month: "short" });
const fmtDateTime = t => new Date(t).toLocaleString("es-ES", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
const pct = x => Math.round(x * 100) + "%";
async function hashPw(pw) {
  try {
    const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode("lecaa|" + pw));
    return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, "0")).join("");
  } catch (e) { let x = 0; for (const c of "lecaa|" + pw) x = (x * 31 + c.charCodeAt(0)) | 0; return "w" + x; }
}

/* ===== Storage: profiles in localStorage, photos and recordings in IndexedDB ===== */
const KEY = "lecaa.cast.v1";
const Store = {
  data: { profiles: {} },
  ok: true,
  load() { try { const s = localStorage.getItem(KEY); if (s) this.data = JSON.parse(s); } catch (e) { this.ok = false; } if (!this.data.profiles) this.data.profiles = {}; },
  save() { try { localStorage.setItem(KEY, JSON.stringify(this.data)); this.ok = true; } catch (e) { this.ok = false; } },
};
const Media = {
  db: null, urls: {},
  open() {
    return new Promise(res => {
      try {
        const r = indexedDB.open("lecaa-cast-media", 1);
        r.onupgradeneeded = () => r.result.createObjectStore("m");
        r.onsuccess = () => { this.db = r.result; res(); };
        r.onerror = () => res();
      } catch (e) { res(); }
    });
  },
  tx(mode) { return this.db.transaction("m", mode).objectStore("m"); },
  put(pid, k, blob) {
    return new Promise(res => {
      if (!this.db) return res(false);
      const r = this.tx("readwrite").put(blob, pid + "|" + k);
      r.onsuccess = () => { if (this.urls[k]) URL.revokeObjectURL(this.urls[k]); this.urls[k] = URL.createObjectURL(blob); res(true); };
      r.onerror = () => res(false);
    });
  },
  del(pid, k) { return new Promise(res => { if (!this.db) return res(); const r = this.tx("readwrite").delete(pid + "|" + k); r.onsuccess = () => { delete this.urls[k]; res(); }; r.onerror = () => res(); }); },
  loadProfile(pid) {
    this.pid = pid;
    for (const u of Object.values(this.urls)) URL.revokeObjectURL(u);
    this.urls = {};
    return new Promise(res => {
      if (!this.db) return res();
      const st = this.tx("readonly"); const r = st.openCursor();
      r.onsuccess = () => {
        const c = r.result; if (!c) return res();
        const [p, k] = String(c.key).split(/\|(.*)/s);
        if (p === pid) this.urls[k] = URL.createObjectURL(c.value);
        c.continue();
      };
      r.onerror = () => res();
    });
  },
  removeProfile(pid) {
    return new Promise(res => {
      if (!this.db) return res();
      const st = this.tx("readwrite"); const r = st.openCursor();
      r.onsuccess = () => { const c = r.result; if (!c) return res(); if (String(c.key).startsWith(pid + "|")) c.delete(); c.continue(); };
      r.onerror = () => res();
    });
  },
};

/* ===== Voice: recorded human audio first, Catalan synthetic voice as fallback ===== */
const Voice = {
  voice: null, token: 0, rate: 0.9, volume: 1,
  init() {
    const pickV = () => {
      const vs = speechSynthesis.getVoices();
      this.voice = vs.find(v => /^ca(-|_|$)/i.test(v.lang)) || null;
    };
    try { pickV(); speechSynthesis.onvoiceschanged = pickV; } catch (e) {}
  },
  hasSynth() { return typeof speechSynthesis !== "undefined"; },
  stop() { this.token++; try { speechSynthesis.cancel(); } catch (e) {} if (this.audio) { this.audio.pause(); this.audio = null; } },
  speakText(text, opt = {}) {
    return new Promise(res => {
      if (!this.hasSynth() || !text) return res();
      try {
        const u = new SpeechSynthesisUtterance(text);
        u.lang = "es-ES"; if (this.voice) u.voice = this.voice;
        u.rate = (opt.rate || 1) * this.rate; u.volume = (opt.volume ?? 1) * this.volume;
        let done = false; const fin = () => { if (!done) { done = true; res(); } };
        u.onend = fin; u.onerror = fin;
        setTimeout(fin, 1200 + text.length * 140 / u.rate);
        speechSynthesis.speak(u);
      } catch (e) { res(); }
    });
  },
  playRec(k) {
    return new Promise(res => {
      const url = Media.urls["rec:" + k]; if (!url) return res(false);
      const a = new Audio(url); a.volume = this.volume; this.audio = a;
      a.onended = () => res(true); a.onerror = () => res(false);
      a.play().catch(() => res(false));
      setTimeout(() => res(true), 8000);
    });
  },
  // parts: strings (spoken) or {rec, alt} (recording key with spoken fallback) or {pause}
  async say(parts, opt = {}) {
    const my = ++this.token; try { speechSynthesis.cancel(); } catch (e) {}
    for (const p of [].concat(parts)) {
      if (my !== this.token) return;
      if (typeof p === "string") await this.speakText(p, opt);
      else if (p.pause) await sleep(p.pause);
      else if (p.rec) { const ok = await this.playRec(p.rec); if (!ok && p.alt) await this.speakText(p.alt, { ...opt, rate: p.rate || opt.rate }); }
    }
  },
  hasRec(k) { return !!Media.urls["rec:" + k]; },
};
// Short, gentle feedback tones (no negative sound for errors).
const Tone = {
  ctx: null, on: true,
  play(kind) {
    if (!this.on) return;
    try {
      this.ctx = this.ctx || new (window.AudioContext || window.webkitAudioContext)();
      const notes = kind === "ok" ? [523, 784] : kind === "help" ? [660, 660] : [440];
      notes.forEach((f, i) => {
        const o = this.ctx.createOscillator(), g = this.ctx.createGain();
        o.frequency.value = f; o.type = "sine";
        const t = this.ctx.currentTime + i * 0.14;
        g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.18, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
        o.connect(g).connect(this.ctx.destination); o.start(t); o.stop(t + 0.25);
      });
    } catch (e) {}
  },
};
const hasPic = w => !!(Media.urls["img:"+w] || WORD_ILLUSTRATIONS.contour[w]);
// Spoken cue for a grapheme: recorded sound, or the vowel itself, or a key-word description.
function soundParts(g) {
  if (VOWELS.has(g)) return [{ rec: "so:" + g, alt: g }];
  if (KEYWORD[g]) return [{ rec: "so:" + g, alt: "el primer sonido de " + KEYWORD[g] }];
  if (FINAL_KEYWORD[g]) return [{ rec: "so:" + g, alt: "el último sonido de " + FINAL_KEYWORD[g] }];
  return [{ rec: "so:" + g, alt: g }];
