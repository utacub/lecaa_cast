// Timbral feedback with a soft bell envelope. Speech always has priority.
Tone.duck=function(active){if(this.master&&this.ctx){this.master.gain.cancelScheduledValues(this.ctx.currentTime);this.master.gain.setTargetAtTime(active?.22:1,this.ctx.currentTime,.025);}};
Tone.play=function(kind){if(!this.on)return;try{this.ctx=this.ctx||new(window.AudioContext||window.webkitAudioContext)();if(this.ctx.state==='suspended')this.ctx.resume();if(!this.master){this.master=this.ctx.createGain();this.master.connect(this.ctx.destination);}const notes=({ok:[523.25,659.25,783.99],help:[440,554.37],finish:[523.25,659.25,783.99,1046.5],pause:[440,392],resume:[392,523.25],start:[523.25,659.25]})[kind]||[392];const vol=(Voice.volume??1)*.052;notes.forEach((f,i)=>{const t=this.ctx.currentTime+i*.09;[1,2,3.02].forEach((harm,j)=>{const o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type='sine';o.frequency.value=f*harm;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol*[1,.18,.06][j],t+.009);g.gain.exponentialRampToValueAtTime(.00001,t+.35);o.connect(g).connect(this.master);o.start(t);o.stop(t+.37);});});}catch(e){}};
Voice.getCatalanVoices=function(){try{return speechSynthesis.getVoices().filter(v=>/^ca(-|_|$)/i.test(v.lang));}catch(e){return[];}};
Voice.pick=function(uri){const vs=this.getCatalanVoices();this.voice=vs.find(v=>v.voiceURI===uri)||vs.find(v=>v.localService)||vs[0]||null;};
Voice.init=function(){const update=()=>this.pick(S?.p?.pres?.voiceURI||CUR?.pres?.voiceURI);update();if(this.hasSynth())speechSynthesis.addEventListener('voiceschanged',update);};
Voice.stop=function(){this.token++;try{speechSynthesis.cancel();}catch(e){}if(this.audio){const a=this.audio;this.audio=null;a.pause();a._finish?.(false);}Tone.duck(false);};
Voice.playRec=function(k){return new Promise(res=>{const url=Media.urls['rec:'+k];if(!url)return res(false);if(this.audio){this.audio.pause();this.audio._finish?.(false);}const a=new Audio(url);this.audio=a;a.volume=this.volume;Tone.duck(true);let done=false;const timer=setTimeout(()=>finish(false),120000);const finish=ok=>{if(done)return;done=true;clearTimeout(timer);if(this.audio===a)this.audio=null;Tone.duck(false);res(ok);};a._finish=finish;a.onended=()=>finish(true);a.onerror=()=>finish(false);a.play().catch(()=>finish(false));});};
Voice.speakText=function(text,opt={}){return new Promise(async res=>{if(!text)return res();const clean=String(text).trim();const rec='paraula:'+clean.toLocaleLowerCase('ca');if(Voice.hasRec(rec)){await Voice.playRec(rec);return res();}if(!this.hasSynth())return res();try{const u=new SpeechSynthesisUtterance(clean);u.lang='es-ES';if(this.voice)u.voice=this.voice;u.rate=(opt.rate||1)*this.rate;u.volume=(opt.volume??1)*this.volume;Tone.duck(true);let done=false;const timer=setTimeout(()=>fin(),Math.max(5000,2000+clean.length*180/u.rate));const fin=()=>{if(done)return;done=true;clearTimeout(timer);Tone.duck(false);res();};u.onend=fin;u.onerror=fin;speechSynthesis.speak(u);}catch(e){Tone.duck(false);res();}});};
Voice.say=async function(parts,opt={}){this.stop();const my=this.token;for(const p of[].concat(parts)){if(my!==this.token)return;if(typeof p==='string')await this.speakText(p,opt);else if(p.pause)await sleep(p.pause);else if(p.rec){const ok=await this.playRec(p.rec);if(my!==this.token)return;if(!ok&&p.alt)await this.speakText(p.alt,{...opt,rate:p.rate||opt.rate});}}};
// Complete, portable profile copies, including pictures and recordings.
function downloadBlob(blob,name){const url=URL.createObjectURL(blob),a=h('a',{href:url,download:name});document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),15000);}
const legacyWordsView=wordsView;
wordsView=function(p,rerender){const v=legacyWordsView(p,rerender);const n=v.querySelector('.note');if(n)n.textContent="El vocabulario incluye tres estilos: Sencillas, Detalladas y ARASAAC. Elige el estilo en Presentación → Imágenes de las tareas. Las fotografías que hayas subido para este perfil tienen prioridad; con «Quita» puedes volver a la colección elegida.";return v;};
const legacySoundsView=soundsView;
soundsView=function(p,rerender){const v=legacySoundsView(p,rerender);const n=v.querySelector('.note');if(n)n.textContent="Las locuciones en castellano, con voz femenina y masculina, están pendientes de incorporación. Los sonidos aislados requieren revisión fonética antes de utilizarlos.";const word=sel(WORDS[0].word,WORDS.map(w=>[w.word,w.word]),()=>{});const file=h('input',{type:'file',accept:'audio/*',hidden:true});const up=h('button',{class:'btn ghost small',type:'button'},"Sube una grabación");up.onclick=()=>file.click();const listen=h('button',{class:'btn ghost small',type:'button'},"Escucha");listen.onclick=()=>Voice.say(word.value);const status=h('span',{class:'muted','aria-live':'polite'});file.onchange=async()=>{const f=file.files[0];if(!f)return;const ok=await Media.put(p.id,'rec:paraula:'+word.value,f);status.textContent=ok?"Grabación incorporada.":"No se ha podido conservar el audio.";save(p,"Grabación de la palabra "+word.value);file.value='';};v.prepend(h('div',{class:'card stack'},h('h3',{},"Voz de las palabras"),h('p',{class:'muted'},"Las palabras del corpus tienen preparadas las variantes femenina y masculina; las grabaciones están pendientes."),word,h('div',{class:'row'},up,listen),status,file));return v;};
// Replace provisional UI emoji only; never alter the printed word or letter under assessment.
const UI_EMOJI={'👂':'listen','🔊':'listen','⏸️':'pause','▶':'play','🙋':'help','💬':'message','🏁':'finish','📈':'progress','✉️':'send','⚙️':'settings','⌫':'erase','✔':'check','👍':'yes','👎':'no','⭐':'star'};
function polishDOM(root){if(!root)return;root.querySelectorAll('.guide').forEach(e=>{if(S&&!guidesEnabled(S.p)){e.hidden=true;return;}e.hidden=false;if(!e.querySelector('.guide-bubble,img,video')){const key=e.textContent.trim();e.replaceChildren(guideImage(key));}});root.querySelectorAll('.pcard .av,.profile-heading .profile-emblem').forEach(()=>{});root.querySelectorAll('.modal h2,.adult header h1').forEach(e=>{for(const n of[...e.childNodes])if(n.nodeType===3){const t=n.textContent;for(const key of AVATARS)if(t.includes(key)){n.replaceWith(avatarImage(key),document.createTextNode(t.replace(key,'').trim()));break;}}});root.querySelectorAll('.btn,.key.fn,.ctl .i,.tile .lbl,.bubble-help').forEach(e=>{for(const n of[...e.childNodes]){if(n.nodeType!==3)continue;const t=n.textContent;for(const[emoji,ic]of Object.entries(UI_EMOJI))if(t.includes(emoji)){n.replaceWith(icon(ic),document.createTextNode(t.replace(emoji,'').trim()));break;}}});root.querySelectorAll('.tile .lbl').forEach(e=>e.classList.add('accessible-yesno'));root.querySelectorAll('.guide img').forEach(e=>e.setAttribute('draggable','false'));root.querySelectorAll('.av').forEach(e=>{if(AVATARS.includes(e.textContent.trim()))e.replaceChildren(avatarImage(e.textContent.trim()));});if(root.querySelector('.big-start')&&root.querySelector('.controls[hidden]'))root.querySelector('.stage')?.classList.add('welcome');}
let polishPending=false;const designObserver=new MutationObserver(()=>{if(polishPending)return;polishPending=true;requestAnimationFrame(()=>{polishDOM(document.getElementById('app'));polishDOM(document.querySelector('.overlay'));polishPending=false;});});designObserver.observe(document.body,{childList:true,subtree:true});
// Preserve the official UTAC mark; embed the original transparent asset offline.
function utacLogo(){return h('span',{class:'utac-mark',role:'img','aria-label':'UTAC'},h('img',{class:'utac-logo utac-black',src:'data:image/png;base64,',alt:'',draggable:'false'}),h('img',{class:'utac-logo utac-white',src:'data:image/png;base64,',alt:'',draggable:'false'}));}
const premiumBrand=brand;
brand=function(){const b=premiumBrand();b.prepend(utacLogo());return b;};
const premiumPolish=polishDOM;
polishDOM=function(root){premiumPolish(root);};
function pressFeedback(el){if(!el||el.disabled)return;clearTimeout(el._pressTimer);el.classList.add('is-pressed');el._pressTimer=setTimeout(()=>el.classList.remove('is-pressed'),260);}
const premiumSelect=Access.select;
Access.select=function(e){if(this.locked||!e||e.disabled)return;pressFeedback(e);return premiumSelect.call(this,e);};
const tactileSelector='button,.corner';
document.addEventListener('pointerdown',ev=>{const b=ev.target.closest(tactileSelector);if(b)pressFeedback(b);},{capture:true});
document.addEventListener('keydown',ev=>{if((ev.key==='Enter'||ev.key===' ')&&!ev.repeat){const b=ev.target.closest(tactileSelector);if(b)pressFeedback(b);}},{capture:true});
document.addEventListener('click',ev=>{const b=ev.target.closest(tactileSelector);if(b&&!b.hasAttribute('data-sel'))pressFeedback(b);},{capture:true});
// Clearer charts, using exactly the existing session values and mastery criterion.
function chartSVG(points,crit){
 const W=720,H=280,L=62,R=26,T=32,B=50,n=points.length;
 const x=i=>L+(n<=1?(W-L-R)/2:i*(W-L-R)/(n-1)),y=v=>T+(1-Math.min(1,Math.max(0,v)))*(H-T-B);
 const safe=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 let out=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Aciertos independientes con la correspondencia nueva, por sesión"><title>LECAA CAST · 0.6.4</title><desc>${safe(points.map(p=>p.label+': '+(p.v==null?'sin datos':pct(p.v))).join('; '))}. Criterio: ${pct(crit)}.</desc>`;
 for(const v of[0,.25,.5,.75,1])out+=`<line class="chart-grid" x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L-12}" y="${y(v)+4}" text-anchor="end">${v*100}%</text>`;
 out+=`<line class="crit" x1="${L}" x2="${W-R}" y1="${y(crit)}" y2="${y(crit)}"/>`;
 let segment=[];const flush=()=>{if(segment.length>1)out+=`<polyline class="ln" points="${segment.join(' ')}"/>`;segment=[];};
 for(const p of points){if(p.v==null){flush();continue;}segment.push(x(p.i)+','+y(p.v));}flush();
 for(const p of points){if(p.v!=null)out+=`<circle class="pt" cx="${x(p.i)}" cy="${y(p.v)}" r="5.5"><title>LECAA CAST · 0.6.4</title></circle>`;}
 const step=Math.max(1,Math.ceil(n/6));points.forEach((p,i)=>{if(i%step===0||i===n-1)out+=`<text x="${x(p.i)}" y="${H-19}" text-anchor="middle">${safe(p.label)}</text>`;});
 return out+'</svg>';
}
const finishProgressView=progressView;
progressView=function(p){const v=finishProgressView(p),chart=v.querySelector('.chart');if(chart?.querySelector('svg')){
 chart.append(h('div',{class:'chart-legend'},h('span',{class:'legend-value'},"Aciertos independientes"),h('span',{class:'legend-criterion'},"Criterio de avance · "+pct(p.plan.crit))));
 }return v;};
const finishShowTab=showTab;
showTab=function(body,p,tab){finishShowTab(body,p,tab);const view=body.lastElementChild;if(view){view.classList.remove('panel-arrival');void view.offsetWidth;view.classList.add('panel-arrival');}};
// Distinct opening, resting and closing compositions; the original guide art is unchanged.
const finishPolishDOM=polishDOM;
polishDOM=function(root){finishPolishDOM(root);if(!root)return;
 const reward=root.querySelector('.reward');if(reward&&!reward.dataset.finished){reward.dataset.finished='true';const paused=!!reward.closest('.overlay'),heading=h('div',{class:'scene-heading'},h('span',{class:'eyebrow'},paused?"Un momento de descanso":"LECAA CAST · Tu sesión"),h('h2',{},paused?'Pausa':"Sesión terminada"));const logo=reward.querySelector('.utac-logo');if(logo)logo.after(heading);else reward.prepend(heading);reward.classList.add(paused?'rest-scene':'finish-scene');}
 root.querySelectorAll('[aria-live]').forEach(e=>{if(e.classList.contains('slots')){e.classList.remove('inline-status');delete e.dataset.status;return;}e.classList.add('inline-status');const t=e.textContent.trim();e.dataset.status=!t?'empty':/no s’ha|no es|no permet|no és|vàlid|error/i.test(t)?'error':'info';});
 root.querySelectorAll('.err').forEach(e=>{e.setAttribute('role','alert');e.classList.add('form-error');});
 root.querySelectorAll('.card>p.muted').forEach(e=>{if(/^(Encara no hi ha|No hi ha)/.test(e.textContent))e.classList.add('empty-state');});
};
// One small sonic family, cancellable, with speech taking precedence.
const finishDuck=Tone.duck;
Tone.duck=function(active){this.speechActive=active;finishDuck.call(this,active);};
Tone.play=function(kind){if(!this.on||(kind==='select'&&this.speechActive))return;try{
 this.ctx=this.ctx||new(window.AudioContext||window.webkitAudioContext)();if(this.ctx.state==='suspended')this.ctx.resume();if(!this.master){this.master=this.ctx.createGain();this.master.connect(this.ctx.destination);this.duck(!!this.speechActive);}
 const now=this.ctx.currentTime;if(kind==='select'&&now-(this.lastSelect??-10)<.09)return;if(kind==='select')this.lastSelect=now;
 for(const o of this.playing||[]){try{o.stop(now+.012);}catch(e){}}this.playing=[];
 const notes=({select:[392],ok:[523.25,659.25],help:[440,554.37],finish:[523.25,659.25,783.99],pause:[440,392],resume:[392,523.25],start:[523.25,659.25]})[kind]||[392];
 const length=kind==='select'?.12:.24,vol=(Voice.volume??1)*(kind==='select'?.027:.043);
 notes.forEach((f,i)=>{const t=now+i*.075;[1,2].forEach((harm,j)=>{const o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type='sine';o.frequency.value=f*harm;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol*(j?.1:1),t+.008);g.gain.exponentialRampToValueAtTime(.00001,t+length);o.connect(g).connect(this.master);o.start(t);o.stop(t+length+.015);this.playing.push(o);o.onended=()=>g.disconnect();});});
 }catch(e){}};
const finishSelect=Access.select;
Access.select=function(e){if(this.locked||!e||e.disabled)return;Tone.play('select');return finishSelect.call(this,e);};

const AUDIO_BANK={"anna":{},"jordi":{}};
// Complete uploaded ElevenLabs phrase bank. All fixed utterances active; no system TTS.
const RecordedBank={
 norm(t){return String(t).normalize('NFC').toLocaleLowerCase('ca').replace(/[’‘]/g,"'").replace(/[.!?,:;«»]/g,'').replace(/\s+/g,' ').trim();},
 profile(){return S?.p||CUR;},
 voice(p=this.profile()){const mode=p?.pres?.recordedVoice||'anna';return mode==='mixed'?(Voice.bankTurn++%2?'jordi':'anna'):mode;},
 index:null,
 buildIndex(){
  this.index={anna:new Map(),jordi:new Map()};
  for(const who of ['anna','jordi'])for(const [block,b] of Object.entries(AUDIO_BANK[who]))
   b.items.forEach((it,i)=>{if(it.active===false)return;const key=this.norm(it.text);if(!this.index[who].has(key))this.index[who].set(key,{block,b,item:it,i});});
 },
 entry(who,block,i){
  let b=AUDIO_BANK[who]?.[block],item=b?.items[i];if(!item)return null;
  const replacement=item.replacement;
  if(replacement){block=replacement.block;i=replacement.item;b=AUDIO_BANK[who]?.[block];item=b?.items[i];if(!item)return null;}
  if(item.src)b={...b,src:item.src,duration:item.duration};
  return{block,b,item,i};
 },
 find(text,who){
  if(!this.index)this.buildIndex();
  const found=this.index[who]?.get(this.norm(text));if(!found)return null;
  const resolved=this.entry(who,found.block,found.i);if(!resolved)return null;
  const {block,b,item,i}=resolved,r=this.profile()?.pres?.audioReview?.[who+':'+block+':'+i];
  if(r?.disabled)return null;
  return{src:b.src,start:r?.approved?r.start:item.start,end:r?.approved?r.end:item.end};
 },
 parts(text,who){
  const direct=this.find(text,who);if(direct)return[direct];
  const n=this.norm(text);let m;
  if((m=n.match(/^quina comença com (.+)$/)))return this.compose(["Cuál empieza como",m[1]],who);
  if((m=n.match(/^(.+) comença com (.+)$/)))return this.compose([m[1],"empieza como",m[2]],who);
  if((m=n.match(/^rimen (.+) i (.+)$/)))return this.compose(["Riman",m[1],'i',m[2]],who);
  if((m=n.match(/^hola,? .+$/)))return this.compose(["¡Hola!"],who);
  if((m=n.match(/^molt bé,? .+$/)))return this.compose(["¡Muy bien!"],who);
  const ipa={e:'/e/',o:'/o/',u:'/u/'};
  if(ipa[n])return this.compose(["El sonido es "+ipa[n]],who);
  const words=n.split(' ');if(words.length>1)return this.compose(words,who);
  return null;
 },
 compose(words,who){const a=words.map(t=>this.find(t,who));return a.every(Boolean)?a:null;},
 play(clip,opt={}){
  return new Promise(resolve=>{
   if(Voice.audio){Voice.audio.pause();Voice.audio._finish?.(false);}
   const a=new Audio(clip.src);Voice.audio=a;let done=false,timer,watchdog;
   const finish=ok=>{if(done)return;done=true;clearTimeout(timer);clearTimeout(watchdog);a.pause();a.removeAttribute('src');a.load();if(Voice.audio===a)Voice.audio=null;Tone.duck(false);resolve(ok);};
   const check=()=>{if(done)return;if(a.currentTime>=clip.end)return finish(true);timer=setTimeout(check,20);};
   a._finish=finish;a.volume=Math.min(1,Math.max(0,(opt.volume??1)*Voice.volume));a.playbackRate=(opt.rate||1)*(Voice.rate||.9)/.9;
   a.onloadedmetadata=()=>{if(done)return;a.currentTime=clip.start;Tone.duck(true);a.play().then(check).catch(()=>finish(false));};
   a.ontimeupdate=()=>{if(a.currentTime>=clip.end)finish(true);};
   a.onended=()=>finish(true);a.onerror=()=>finish(false);
   watchdog=setTimeout(()=>finish(false),Math.min(600000,Math.max(30000,(clip.end-clip.start)*3000)));a.load();
  });
 }

};
Voice.bankTurn=0;
const ISOLATED_SOUND_BLOCKS={"a": "15", "e": "16", "è": "17", "i": "18", "o": "19", "ò": "20", "u": "21", "ə": "22", "s": "23", "ss": "23", "z": "24", "l": "25", "m": "26", "r": "27", "rr": "27", "ɾ": "28", "p": "29", "t": "30", "n": "31", "c": "32", "k": "32", "qu": "32", "g": "33", "gu": "33", "d": "34", "f": "35", "b": "36", "v": "36", "c·": "23", "g·": "37", "j": "37", "ll": "38", "ny": "39", "x": "40", "ix": "40", "tx": "41", "ig": "41", "tg": "42", "i-semivocal": "43", "u-semivocal": "44", "l·l": "45", "v-labiodental": "47"};
const ISOLATED_PHONEME_BLOCKS={"a": "isolated-15", "e": "isolated-16", "ɛ": "isolated-17", "i": "isolated-18", "o": "isolated-19", "ɔ": "isolated-20", "u": "isolated-21", "ə": "isolated-22", "s": "isolated-23", "z": "isolated-24", "l": "isolated-25", "m": "isolated-26", "r": "isolated-27", "ɾ": "isolated-28", "p": "isolated-29", "t": "isolated-30", "n": "isolated-31", "k": "isolated-32", "ɡ": "isolated-33", "d": "isolated-34", "f": "isolated-35", "b": "isolated-36", "ʒ": "isolated-37", "ʎ": "isolated-38", "ɲ": "isolated-39", "ʃ": "isolated-40", "t͡ʃ": "isolated-41", "d͡ʒ": "isolated-42", "j": "isolated-43", "w": "isolated-44", "lː": "isolated-45", "v": "isolated-47"};
RecordedBank.sound=function(key,who){
 let block;
 if(key.startsWith('so:')){const n=ISOLATED_SOUND_BLOCKS[key.slice(3)];if(n)block='isolated-'+n;}
 else if(key.startsWith('phoneme:'))block=ISOLATED_PHONEME_BLOCKS[key.slice(8)];
 if(!block)return null;
 const b=AUDIO_BANK[who]?.[block],item=b?.items[0];if(!item)return null;
 const r=this.profile()?.pres?.audioReview?.[who+':'+block+':0'];if(r?.disabled)return null;
 const start=r?.approved?r.start:item.start,end=r?.approved?r.end:item.end;
 if(!Number.isFinite(start)||!Number.isFinite(end)||start<0||end<=start||end>b.duration)return null;
 return {src:b.src,start,end};
};
const uploadedRecording=Voice.playRec;
Voice.hasRec=function(key){
 if(Media.urls['rec:'+key])return true;
 const mode=RecordedBank.profile()?.pres?.recordedVoice||'anna';
 return (mode==='mixed'?['anna','jordi']:[mode]).every(who=>!!RecordedBank.sound(key,who));
};
Voice.playRec=async function(key,opt={}){
 if(Media.urls['rec:'+key])return uploadedRecording.call(this,key);
 if(!key.startsWith('so:')&&!key.startsWith('phoneme:'))return false;
 const clip=RecordedBank.sound(key,opt.bankVoice||RecordedBank.voice());
 return clip?RecordedBank.play(clip,opt):false;
};
// Speech synthesis is disabled: unavailable texts are reported, never read by a different voice.
Voice.hasSynth=()=>false;
Voice.missingSpeech=new Set();
Voice.reportMissing=function(text){
 this.missingSpeech.add(String(text));
 if(typeof document==='undefined')return;
 let note=document.getElementById('speech-unavailable');
 if(!note){note=h('p',{id:'speech-unavailable',class:'note',role:'status',style:'position:fixed;bottom:8px;left:16px;right:16px;z-index:100;margin:0;font-size:14px;pointer-events:none'});document.body.append(note);}
 note.textContent="Este texto todavía no se puede escuchar: "+String(text);
 clearTimeout(this.missingTimer);this.missingTimer=setTimeout(()=>note.remove(),6000);
};
Voice.speakText=async function(text,opt={}){
 const clean=String(text||'').trim();if(!clean)return;
 const who=opt.bankVoice||RecordedBank.voice(),clips=RecordedBank.parts(clean,who);
 if(!clips){this.reportMissing(clean);return;}
 const token=this.token;
 for(let i=0;i<clips.length;i++){if(token!==this.token)return;if(i){await sleep(Feedback.gapMs());if(token!==this.token)return;}const ok=await RecordedBank.play(clips[i],opt);if(!ok&&token===this.token){this.reportMissing(clean);return;}}
};
Voice.say=async function(parts,opt={}){
 this.stop();const my=this.token,bankVoice=RecordedBank.voice();
 let spoken=false,paused=false;
 for(const p of[].concat(parts)){
  if(my!==this.token)return;
  if(p&&typeof p==='object'&&p.pause){await sleep(Math.max(p.pause,Feedback.gapMs()));paused=true;continue;}
  if(spoken&&!paused){await sleep(Feedback.gapMs());if(my!==this.token)return;}
  paused=false;
  if(typeof p==='string'){await this.speakText(p,{...opt,bankVoice});spoken=true;}
  else if(p?.rec){const ok=await this.playRec(p.rec,{...opt,bankVoice,rate:p.rate||opt.rate});if(my!==this.token)return;if(!ok&&p.alt)await this.speakText(p.alt,{...opt,bankVoice,rate:p.rate||opt.rate});spoken=true;}
 }
};
const voicePresentation=presView;
presView=function(p,rerender){
 const view=voicePresentation(p,rerender),card=view.querySelectorAll('.card')[1];
 card.querySelector('.voice-status')?.remove();
 for(const f of card.querySelectorAll('.f'))if(f.textContent.startsWith("Voz en castellano del dispositivo"))f.remove();
 for(const f of card.querySelectorAll('.f'))if(f.textContent.startsWith("Velocidad de la voz")&&f.firstChild)f.firstChild.textContent="Velocidad de la voz";
 const choice=sel(p.pres.recordedVoice||'anna',[['anna',"Femenina · pendiente"],['jordi',"Masculina · pendiente"],['mixed',"Combinadas · femenina y masculina"]],v=>{
  Voice.stop();p.pres.recordedVoice=v;Voice.bankTurn=0;save(p,"Voz grabada: "+v);
 });
 card.insertBefore(field("Voz grabada",choice),card.children[1]);
 card.insertBefore(h('p',{class:'muted'},"Combinadas alterna las voces entre intervenciones completas. Las variantes femenina y masculina están preparadas para incorporar las locuciones revisadas. El nombre del alumno se muestra en pantalla."),card.children[2]);
 return view;
};
const originalSounds=soundsView;
soundsView=function(p,rerender){
 const view=originalSounds(p,rerender);let who='anna',block='1',index=0;
 p.pres.audioReview=p.pres.audioReview||{};
 const box=h('div',{class:'card stack'}),editor=h('div',{class:'stack'});
 const voiceChoice=sel(who,[['anna',"Voz femenina"],['jordi',"Voz masculina"]],v=>{Voice.stop();who=v;index=Math.min(index,AUDIO_BANK[who][block].items.length-1);draw();});
 const blockChoice=sel(block,Object.entries(AUDIO_BANK.anna).map(([k,b])=>[k,b.title]),v=>{Voice.stop();block=v;index=0;draw();});
 const count=h('p',{class:'muted','aria-live':'polite'});
 function draw(){
  editor.replaceChildren();const originalBlock=AUDIO_BANK[who][block],available=originalBlock.items.map((it,i)=>({it,i})).filter(({it})=>it.active!==false);if(!available.some(x=>x.i===index))index=available[0].i;const position=available.findIndex(x=>x.i===index),resolved=RecordedBank.entry(who,block,index),{b,item}=resolved,id=who+':'+resolved.block+':'+resolved.i;
  const reviewed=p.pres.audioReview[id],cut=reviewed?.approved?reviewed:item;
  count.textContent=Object.values(p.pres.audioReview).filter(x=>x.approved).length+" fragmentos validados en este perfil. Solo deben activarse grabaciones revisadas.";
  const items=sel(String(index),available.map(({it,i})=>[String(i),(i+1)+'. '+it.text]),v=>{Voice.stop();index=+v;draw();});
  const begin=h('input',{type:'number',min:0,max:b.duration,step:.01,value:cut.start,'aria-label':"Inicio en segundos"});
  const end=h('input',{type:'number',min:0,max:b.duration,step:.01,value:cut.end,'aria-label':"Final en segundos"});
  const status=h('p',{class:'muted','aria-live':'polite'},reviewed?.disabled?"Desactivado.":reviewed?.approved?"Revisado y activo.":"Incorporado y activo. Puedes escucharlo y ajustar el corte si es necesario.");
  const valid=()=>Number.isFinite(+begin.value)&&Number.isFinite(+end.value)&&+begin.value>=0&&+end.value>+begin.value&&+end.value<=b.duration;
  const listen=h('button',{class:'btn',type:'button'},"Escucha el fragmento");
  listen.onclick=()=>{Voice.stop();if(!valid()){status.textContent="Revisa los tiempos: el final debe ser posterior al inicio y quedar dentro del bloque.";return;}Voice.volume=p.pres.volume??1;RecordedBank.play({src:b.src,start:+begin.value,end:+end.value});};
  const full=h('audio',{controls:true,preload:'none',src:b.src,'aria-label':"Bloque original completo"});
  full.onplay=()=>{Voice.stop();Voice.audio=full;full._finish=()=>{full.pause();if(Voice.audio===full)Voice.audio=null;};};full.onpause=()=>{if(Voice.audio===full)Voice.audio=null;};
  const approve=h('button',{class:'btn',type:'button'},"Valida y activa");
  approve.onclick=()=>{Voice.stop();full.pause();if(!valid()){status.textContent="Tiempos incorrectos.";return;}p.pres.audioReview[id]={start:+begin.value,end:+end.value,approved:true};save(p,"Locución validada: "+who+' · '+item.text);draw();};
  const revoke=h('button',{class:'btn ghost',type:'button'},"Desactiva");
  revoke.onclick=()=>{Voice.stop();p.pres.audioReview[id]={disabled:true};save(p,"Locución desactivada: "+item.text);draw();};
  const changed=()=>{if(p.pres.audioReview[id]?.approved){p.pres.audioReview[id]={disabled:true};save(p,"Corte modificado: pendiente de validación");status.textContent="Corte modificado: pendiente de nueva validación.";}};
  begin.onchange=changed;end.onchange=changed;
  const prev=h('button',{class:'btn ghost',type:'button',disabled:position===0},'Anterior');
  const next=h('button',{class:'btn ghost',type:'button',disabled:position===available.length-1},"Siguiente");
  prev.onclick=()=>{Voice.stop();full.pause();index=available[position-1].i;draw();};next.onclick=()=>{Voice.stop();full.pause();index=available[position+1].i;draw();};
  editor.append(field("Texto esperado",items),h('p',{},"Escucha el fragmento. Si necesitas ajustarlo, modifica los tiempos y guarda el corte con «Valida y activa»."),h('div',{class:'grid2'},field("Inicio (segundos)",begin),field("Final (segundos)",end)),h('div',{class:'row'},listen,approve,revoke),status,h('details',{},h('summary',{},"Escucha el bloque original para localizar el fragmento"),full),h('div',{class:'row'},prev,next));
 }
 box.append(h('h3',{},"Locuciones femeninas y masculinas"),h('p',{},"Banco de locuciones en castellano: instrucciones, controles, vocabulario, frases completas de las actividades, presentaciones de los guías e indicaciones de correspondencias. Las grabaciones están pendientes de producción e incorporación. Los sonidos aislados deberán revisarse fonéticamente antes de activarlos."),h('div',{class:'grid2'},field("Voz que revisas",voiceChoice),field("Bloque",blockChoice)),count,editor);
 view.prepend(box);draw();return view;
};

// Profile-specific pacing and optional feedback; task speech remains independent.
const Feedback={
 mode(){const m=RecordedBank.profile()?.pres?.feedbackMode;return ['voice','bell','visual'].includes(m)?m:'voice';},
 gapMs(){const raw=RecordedBank.profile()?.pres?.speechGap;const n=raw==null?1:Number(raw);return (Number.isFinite(n)?Math.max(0,Math.min(5,n)):1)*1000;},
 bell(){
  try{
   const ctx=Tone.ctx=Tone.ctx||new(window.AudioContext||window.webkitAudioContext)();
   if(ctx.state==='suspended')ctx.resume();
   const gain=ctx.createGain(),osc=ctx.createOscillator(),t=ctx.currentTime;
   osc.type='sine';osc.frequency.setValueAtTime(1046.5,t);
   gain.gain.setValueAtTime(.00001,t);gain.gain.exponentialRampToValueAtTime(.085*(Voice.volume??1)+.00001,t+.006);
   gain.gain.exponentialRampToValueAtTime(.00001,t+.22);
   osc.connect(gain);gain.connect(ctx.destination);osc.start(t);osc.stop(t+.23);osc.onended=()=>{gain.disconnect();osc.disconnect();};
  }catch(e){}
 },
 async play(parts){
  Voice.stop();const mode=this.mode();
  if(mode==='voice')return Voice.say(parts);
  if(mode==='bell'){this.bell();await sleep(250);}
 }
};
Voice.waitBetween=async function(){
 const token=this.token;await sleep(Feedback.gapMs());return token===this.token;
};
Voice.feedback=parts=>Feedback.play(parts);
const taskTone=Tone.play;
Tone.play=function(kind){
 if(['ok','finish'].includes(kind))return; // successful responses use exactly the selected feedback
 if(Feedback.mode()!=='voice')return;
 return taskTone.call(this,kind);
};
const pacedPresentation=presView;
presView=function(p,rerender){
 const v=pacedPresentation(p,rerender),card=v.querySelectorAll('.card')[1];
 for(const label of card.querySelectorAll('label'))if(label.textContent.startsWith("Sonidos de confirmación y ayuda"))label.remove();
 const gap=h('input',{type:'number',min:0,max:5,step:.25,value:p.pres.speechGap??1,'aria-label':"Pausa entre locuciones, en segundos"});
 gap.onchange=()=>{
  const n=Number(gap.value);if(!Number.isFinite(n)){gap.value=p.pres.speechGap??1;return;}
  p.pres.speechGap=Math.max(0,Math.min(5,n));gap.value=p.pres.speechGap;save(p,"Pausa entre locuciones: "+p.pres.speechGap+' s');
 };
 const mode=sel(p.pres.feedbackMode||'voice',[['voice',"Voz · confirmaciones habladas"],['bell',"Campanilla breve"],['visual',"Solo visual · sin respuesta sonora"]],m=>{
  Voice.stop();p.pres.feedbackMode=m;save(p,'Feedback: '+m);
 });
 card.append(field("Pausa entre locuciones (segundos)",gap,"Se aplica entre intervenciones y opciones leídas. Valor inicial: 1 segundo."),
  field("Respuesta a los aciertos",mode,"Las instrucciones, las opciones y los audios necesarios para responder se mantienen en todos los modos, cuando las locuciones estén incorporadas."));
 return v;
};




const supportPresentation=presView;
presView=function(p,rerender){
 const v=supportPresentation(p,rerender);
 const timing=sel(p.pres.supportTiming||'adaptive',[['adaptive',"Tiempo adaptativo actual"],['fixed',"Tiempo mínimo personalizado"]],value=>{p.pres.supportTiming=value;save(p,"Tiempo de los apoyos: "+value);refresh();});
 const seconds=h('input',{type:'number',min:5,max:3600,step:1,value:p.pres.supportWaitSeconds??30,'aria-label':"Tiempo mínimo antes de repetir u ofrecer ayuda, en segundos"});
 seconds.onchange=()=>{const n=Number(seconds.value);if(!Number.isFinite(n)||seconds.value===''){seconds.value=p.pres.supportWaitSeconds??30;return;}p.pres.supportWaitSeconds=Math.max(5,Math.min(3600,n));seconds.value=p.pres.supportWaitSeconds;save(p,"Espera de los apoyos: "+p.pres.supportWaitSeconds+' s');};
 const mode=sel(TaskSupport.mode(p),[['auto',"Repetición y ayudas automáticas"],['repeat',"Solo repetición automática del enunciado"],['manual',"Solo cuando se solicite"]],value=>{p.pres.supportMode=value;save(p,"Apoyos de las tareas: "+value);refresh();});
 function refresh(){const manual=TaskSupport.mode(p)==='manual';timing.disabled=manual;seconds.disabled=manual||p.pres.supportTiming!=='fixed';}
 refresh();
 v.append(h('div',{class:'card stack'},h('h3',{},"Repetición y ayudas durante las tareas"),field("Apoyos automáticos",mode),field("Tiempo de espera",timing),field("Tiempo mínimo personalizado (segundos)",seconds,"De 5 a 3.600 segundos. Se cuenta desde el final de la locución inicial o del apoyo anterior; se respeta un margen suficiente para el sistema de acceso."),h('p',{class:'muted'},"Con «Solo cuando se solicite» no se repite el enunciado ni se ofrecen pistas automáticamente, tampoco después de un error. «Repetir» repite la pregunta; «Ayuda» ofrece la siguiente pista. Estas opciones se conservan para cada perfil.")));
 return v;
};

