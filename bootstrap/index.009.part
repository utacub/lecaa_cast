    this.root = root; this.suspended=!!opts.suspend; this.onCue = opts.onCue || null; this.stats = sameRoot ? previousStats : { sels: 0, cycles: 0 };
    const els = [...root.querySelectorAll("[data-sel]")].filter(e => !e.disabled && !e.classList.contains("dim") && e.offsetParent !== null);
    const groups = new Map(); this.entries = [];
    for (const e of els) {
      const g = e.dataset.group;
      if (!g) { this.entries.push(e); continue; }
      if (!groups.has(g)) { const ent = { group: [], box: root.querySelector(`[data-groupbox="${g}"]`) || e.parentElement }; groups.set(g, ent); this.entries.push(ent); }
      groups.get(g).group.push(e);
    }
    for (const e of els) this.wire(e);
    this.level = null; this.idx = -1; this.cycle = 0; this.stopped = false;
    if (this.isScan()) this.startScan(opts.delay || 0);
  },
  refresh() { if (this.root) { const r = this.root, c = this.onCue; this.bind(r, { onCue: c, suspend: this.suspended }); } },
  wire(e) {
