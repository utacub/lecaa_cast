function avatarImage(key){
 const i=Math.max(0,AVATARS.indexOf(key));
 const colors=['#e3ede5','#f4e4d1','#ffe8ba','#dde8ec','#e7e1f0','#f2deda','#e1e9d8','#dce8ed','#f4e5d5','#efdcd9'];
 return h('span',{class:'profile-emblem',style:`--avatar-bg:${colors[i]}`,'data-profile-emblem':String(i+1),'aria-hidden':'true'},h('span',{class:'svg-icon',html:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${PROFILE_EMBLEM_PATHS[i]}</svg>`}));
}
function footer(){const b=h('button',{type:'button'},"Créditos");b.onclick=showCredits;return h('footer',{class:'page-footer'},h('div',{class:'stack',style:'gap:6px'},h('div',{class:'foot-note'},icon('lock'),h('span',{},"Los perfiles se guardan solo en este navegador y dispositivo, también en línea. Guarda una copia desde Copias de seguridad.")),h('small',{class:'app-revision','data-lecaa-revision':'guia-v45'},"Sencillas · Detalladas · ARASAAC · LECAA CAST 0.1")),b);}
const CREDIT_INSTITUTIONS=[{"id":"utac","name":"UTAC","caption":"Unitat de Tècniques Augmentatives i Alternatives de Comunicació","url":"https://www.utac.cat/","src":"data:image/png;base64,"},{"id":"ub","name":"Universitat de Barcelona","url":"https://web.ub.edu/","src":"data:image/png;base64,"},{"id":"fbg","name":"Fundació Bosch i Gimpera","url":"https://www.fbg.ub.edu/","src":"data:image/png;base64,"},{"id":"educacio","name":"Departament d’Educació i Formació Professional","caption":"UTAC Educació · Departament d’Educació i Formació Professional","url":"https://educacio.gencat.cat/","src":"data:image/png;base64,"},{"id":"drets","name":"Departament de Drets Socials i Inclusió","caption":"UTAC Sírius · Departament de Drets Socials i Inclusió","url":"https://dretssocials.gencat.cat/","src":"data:image/png;base64,"}];
const CREDIT_TOOLS=[
 ["Actividades y aplicación",'Claude','Anthropic','https://claude.ai/'],
 ["Actividades, aplicación, ilustraciones y marca",'ChatGPT','OpenAI','https://chatgpt.com/'],
 ["Voces sintéticas",'ElevenLabs','ElevenLabs','https://elevenlabs.io/'],
 ["Animaciones",'Flow','Google','https://labs.google/fx/tools/flow'],
 ["Pictogramas",'ARASAAC',"Gobierno de Aragón",'https://arasaac.org/'],
 ["Tipografía",'Andika','SIL International','https://software.sil.org/andika/'],
 ["Tipografía",'Manrope','The Manrope Project Authors','https://github.com/googlefonts/manrope']
];
function creditLink(label,url){return h('a',{href:url,target:'_blank',rel:'noopener noreferrer',referrerpolicy:'no-referrer'},label);}
function creditTool(row){return h('div',{class:'credit-tool','data-credit-tool':row[1]},h('span',{class:'credit-use'},row[0]),h('strong',{},row[1]),h('span',{},row[2]),creditLink(row[3].replace(/^https?:\/\//,'').replace(/\/$/,''),row[3]));}
function showCredits(){
 const {body}=localDialog("Créditos",'credits-modal');
 const institutions=h('div',{class:'credit-institutions','data-institution-logos':''},...CREDIT_INSTITUTIONS.map(item=>h('figure',{'data-institution':item.id,class:item.dark?'credit-institution-dark':''},creditLink(h('img',{src:item.src,alt:item.name,loading:'lazy',draggable:'false'}),item.url),h('figcaption',{},item.caption||item.name))));
 const intro=h('section',{class:'credits-section stack'},h('div',{class:'credits-brand'},lecaaLogo()),h('h3',{},"Origen e instituciones"),
  h('p',{},"Lectura y Escritura para usuarios de Comunicación Aumentativa y Alternativa (LECAA) se ha creado desde la Unitat de Tècniques Augmentatives i Alternatives de Comunicació (UTAC), utilizando herramientas de inteligencia artificial. LECAA CAST es la adaptación al castellano de España."),
  h('p',{},"La UTAC es un equipo de la Universitat de Barcelona y de la Fundació Bosch i Gimpera. Desarrolla su actividad a través de dos servicios de la Generalitat de Catalunya: UTAC Educació, del Departament d’Educació i Formació Professional, y UTAC Sírius, del Departament de Drets Socials i Inclusió."),institutions);
 const tools=h('section',{class:'credits-section stack'},h('h3',{},"Herramientas y recursos"),h('div',{class:'credit-tools','aria-label':"Uso, producto, organización y web"},h('div',{class:'credit-tool credit-tool-head','aria-hidden':'true'},h('span',{},"Uso"),h('span',{},"Producto"),h('span',{},"Organización"),h('span',{},'Web')),...CREDIT_TOOLS.map(creditTool)));
 const fontTexts=h('details',{class:'font-licenses'},h('summary',{},"Texto completo de las licencias de las tipografías"),...Object.entries(ART.licenses||{}).map(([name,text])=>h('section',{},h('h4',{},name==='andika'?'Andika':'Manrope'),h('pre',{},text))));
 const licenses=h('section',{class:'credits-section stack','data-component-licenses':''},h('h3',{},"Licencias y atribuciones"),
  h('div',{class:'credit-license'},h('h4',{},"Pictogramas ARASAAC"),h('p',{},"Autoría: Sergio Palao. Propiedad: Gobierno de Aragón. Procedencia: ",creditLink('ARASAAC','https://arasaac.org/'),". Licencia: ",creditLink('Creative Commons BY-NC-SA','https://arasaac.org/terms-of-use'),". Reconocimiento de la autoría, uso no comercial y la misma licencia para las adaptaciones.")),
  h('div',{class:'credit-license'},h('h4',{},"Tipografías Andika y Manrope"),h('p',{},"SIL Open Font License 1.1. Se conservan las atribuciones y los textos de licencia de las fuentes incorporadas."),creditLink('SIL Open Font License','https://openfontlicense.org/'),fontTexts),
  h('div',{class:'credit-license'},h('h4',{},'Marcas y logotipos institucionales'),h('p',{},"Los logotipos y nombres de producto identifican a las instituciones y empresas titulares. No están incluidos en la licencia de los pictogramas ARASAAC.")),
  h('div',{class:'credit-license'},h('h4',{},'Materiales creados para LECAA'),h('p',{},"Las ilustraciones, la marca y las animaciones se han creado para el proyecto con las herramientas acreditadas. Las locuciones de LECAA CAST son voces sintéticas generadas con ElevenLabs. Los sonidos de la interfaz se generan dentro de la aplicación.")));
 body.append(intro,tools,licenses);
}

function showStart(){
 S=null;CUR=null;clearOverlays();Voice.stop();Access.clear();Access.setConfig({mode:'direct'});document.documentElement.style.removeProperty('--tile');document.body.classList.remove('reduce-motion');document.body.classList.add('workspace-theme');
 const app=$('#app'),list=h('div',{class:'profiles profile-selection'});
 for(const p of profiles()){
  const last=p.sessions.length?fmtDate(p.sessions.at(-1).start):null;
  const card=h('button',{class:'pcard profile-choice',type:'button','aria-label':"Abre el perfil de "+p.name},h('span',{class:'profile-card-top'},h('span',{class:'av'},avatarImage(p.avatar)),p.example?h('span',{class:'tag'},"De exploración"):null),h('span',{class:'profile-card-name'},p.name),h('span',{class:'profile-card-meta'},p.example?"Explora LECAA CAST con un perfil de prueba.":last?"Última sesión · "+last:"Preparado para empezar"),h('span',{class:'profile-card-enter'},"Entrar",icon('play')));
  card.onclick=()=>adultGate(p,null);list.append(card);
 }
 const create=h('button',{class:'pcard create profile-create',type:'button'},h('span',{class:'create-mark'},icon('plus')),h('strong',{},"Nuevo perfil"),h('span',{},"Un espacio propio para cada alumno"));create.onclick=createProfileForm;list.append(create);
 const about=h('button',{class:'btn ghost small',type:'button','data-home-about':'','aria-haspopup':'dialog'},"Qué es LECAA CAST");about.onclick=showAboutLECAA;
 const guide=h('button',{class:'btn ghost small',type:'button','data-home-guide':'','aria-haspopup':'dialog'},"Guía y marco teórico");guide.onclick=showLECAAGuide;
 const credits=h('button',{class:'btn ghost small home-credits',type:'button','data-home-credits':'','aria-haspopup':'dialog'},"Créditos");credits.onclick=showCredits;
