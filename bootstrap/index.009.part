function mountStage(nodes,taskType=null){
 S.onHelp=null;S.pauseTrial=null;S.resumeTrial=null;
 const app=$('#app'),previous=app.querySelector('.stage');
 let stage,main,ctl;
 const newMentor=nodes.find(n=>n?.classList?.contains('mentor'));
 if(previous&&previous.dataset.session===S.sid&&previous.querySelector('#sm')&&previous.querySelector('.controls')){
  stage=previous;main=stage.querySelector('#sm');ctl=stage.querySelector('.controls');
  const oldMentor=main.querySelector('.mentor');
  if(oldMentor&&newMentor&&oldMentor.querySelector('img')?.src===newMentor.querySelector('img')?.src){
   oldMentor.querySelector('.speech').replaceChildren(...newMentor.querySelector('.speech').childNodes);
   nodes=nodes.map(n=>n===newMentor?oldMentor:n);
  }
  ctl.hidden=false;S.listenBtn=ctl.querySelector('.ctl');
  stage.classList.remove('welcome','message-stage','build-stage');
 }else{app.replaceChildren();({stage,main,ctl}=stageShell());stage.dataset.session=S.sid;app.append(stage,cornerExit());}
 stage.dataset.letterCase=exerciseLetterCase(S.p);
 const config=TASK_BANDS[taskType];
 stage.classList.toggle('task-banded',!!config);
 if(config){
  stage.dataset.taskType=taskType;
  stage.style.setProperty('--task-bg',config.bg);stage.style.setProperty('--task-edge',config.edge);
  const mentor=nodes.find(n=>n?.classList?.contains('mentor'));
  const content=h('div',{class:'task-content'},...nodes.filter(n=>n!==mentor));
  const identity=h('div',{class:'task-identity','aria-hidden':'true'},h('div',{html:config.svg}),h('span',{},config.label));
  main.replaceChildren(...(mentor?[mentor]:[]),h('div',{class:'task-band'},identity,content));
 }else{delete stage.dataset.taskType;stage.style.removeProperty('--task-bg');stage.style.removeProperty('--task-edge');main.replaceChildren(...nodes);}
 if(main.querySelector('.msgline'))stage.classList.add('message-stage');
 if(main.querySelector('.slots'))stage.classList.add('build-stage');
 stage.classList.toggle('welcome',!!main.querySelector('.big-start'));
 if(stage.classList.contains('welcome')){stage.style.setProperty('--classroom-image','url("'+CLASSROOM_ART+'")');for(const b of stage.querySelectorAll('.guide-bubble')){const img=b.querySelector('img');if(img)img.src=GUIDE_CUTOUTS[b.dataset.guide]||img.src;}}else stage.style.removeProperty('--classroom-image');
 for(const n of (main.querySelector('.task-content')||main).children){if(!n.classList.contains('mentor'))n.classList.add('task-arrival');}
 Access.locked=false;clearTimeout(Access.lockTimer);Access.stats={sels:0,cycles:0};
 return{stage,main,ctl};
}

