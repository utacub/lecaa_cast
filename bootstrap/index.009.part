etter.qu","letter.i","letter.o","letter.s","letter.c","letter.o"]}}},"counts":{"entries":2681,"byCategory":{"word":300,"write":261,"initial_prompt":300,"initial_feedback":596,"rhyme_prompt":304,"ui":76,"letter_name":27,"phoneme":23,"phoneme_carrier":23,"guide":9,"slow_connected":300,"initial_emphasis":300,"rhyme_emphasis":162},"entryVoiceSlots":2681,"derivedClips":684,"derivedVoiceSlots":684,"activeFemaleRecordings":1897},"productionRules":{"textOnly":"Enviar exclusivamente el campo text al sintetizador. Los identificadores, categorías, instrucciones y metadatos no se locutan.","phonemes":"Ensayar IPA entre barras únicamente con un modelo compatible. Verificar cada sonido en cada voz. No se acepta el nombre de la letra ni una vocal añadida a una oclusiva. Si la síntesis falla, realizar grabación humana o recorte revisado de un portador; nunca aprobar automáticamente.","carrier":"Los portadores son candidatos de producción. Recortar solo el segmento objetivo después de escucha y validación. No reproducir la frase portadora completa como fonema aislado.","tap":"La r suave se reproduce desde phoneme.ɾ, tomada del cuarto fragmento del nuevo audio del usuario. La ruta contextual /eɾa/ queda conservada como antecedente y no se usa en las actividades.","natural":"Conservar acento léxico, cinco vocales, hiatos y diptongos del corpus. No concatenar fonemas o sílabas para simular una palabra natural.","slow":"Pronunciar la palabra de forma lenta y conectada sin introducir nombres de letras, pausas artificiales, vocales de apoyo o división de diptongos. Después se reproduce la palabra natural.","initialEmphasis":"Realzar el fonema inicial sin añadir vocales ni transformar las oclusivas en sílabas. Mantener la palabra reconocible; no alargar la vibrante simple.","rhymeEmphasis":"Realzar el segmento desde la vocal tónica hasta el final conservando el acento natural.","derived":"Recortar las sílabas de la grabación natural correspondiente. Los tiempos empiezan en null. El resaltado cubre todas las unidades gráficas realmente audibles del recorte; no un solo grafema cuando suena una sílaba.","slowHighlightSchema":{"field":"voices.female.highlightSegments","pendingValue":null,"segment":{"start":"seconds in source audio","end":"seconds in source audio","unitIndices":"zero-based orthographic unit indices from corpus"},"validation":"Ordered non-overlapping intervals covering all word units. Timing must be reviewed against the actual recording. The natural word follows the connected model. Missing alignment keeps the activity in review mode."},"releaseGate":"Todas las rutas, tiempos y aprobaciones deben validarse por voz. La existencia de un archivo no acredita calidad fonética ni alineación. La falta de audio mantiene el material en revisión.","voice":"LECAA CAST utiliza exclusivamente voz femenina. Voces sintéticas generadas con ElevenLabs."},"sources":[{"name":"LECAA_CAST_programa_final_complet.docx","sha256":"2866639d7d35daffbe5e80ee06eba000e8ac6f649076c259da238274de69a521","extraction":"exact tables; initial/rime and syllable-unit mapping verified against all printed IPA and rhyme keys"},{"name":"LECAA v45.1.html","voice":"female","scope":"19 existing female isolated phoneme clips","sha256":"c08a0303fe5928f24d835d8b981c063579ed14e1c0496310287bc0abadf92682"},{"name":"LECAA_CAST_valoracions_fonemes.json","sha256":"c9a18f4343f49473d6e46acda3aff08362e4b644d5765d23ea4ffe76da2825ee","scope":"19 explicit user preferences"},{"name":"ElevenLabs_Locuciones_fonemas_faltantes.mp3","sha256":"df37538684d6633f8dcb19f4c6fedf7192d5edb0e155d18c5774872856328dc3","reference":"ElevenLabs_Locuciones_fonemas_faltantes.txt","scope":"Four new isolated-phoneme slots assigned in transcript order"}],"audioImported":true,"reusedFemalePhonemes":{"imported":19,"active":19,"pendingReview":[],"missingIsolated":[],"contextualTapPending":false},"importSummary":{"naturalRecordings":1874,"originalActivePhonemesPreserved":18,"phoneticCandidates":0,"wordUnits":1904,"recoveredWord