"N12","sandalia","san-da-lia"]];
/* ===== Static content: pictures, letter order, rhymes ===== */
// Emoji are provisional pictures until adults upload photos or validated pictograms.
const EMOJI = {
  sol:"☀️", mar:"🌊", mel:"🍯", sal:"🧂", nas:"👃", fum:"💨", fil:"🧵", mur:"🧱", nit:"🌃", nen:"👦", ram:"💐", pa:"🍞", pi:"🌲",
  gat:"🐈", gos:"🐕", got:"🥛", pot:"🫙", dit:"☝️", cuc:"🪱", suc:"🧃",
  bus:"🚌", bol:"🥣", cel:"🌤️", gel:"🧊", peu:"🦶", neu:"❄️", niu:"🪺", rei:"🤴", noi:"🧒", dau:"🎲", ou:"🥚", bou:"🐂", pop:"🐙", col:"🥬", cor:"❤️", pis:"🏢",
  llum:"💡", llit:"🛏️", llop:"🐺", llet:"🍼", gall:"🐓", full:"📄", ull:"👁️", pany:"🔒", peix:"🐟", llac:"🏞️", all:"🧄", camp:"🌾", pont:"🌉", dent:"🦷", vent:"🌬️", bosc:"🌳", porc:"🐖", serp:"🐍",
  tren:"🚆", drac:"🐉", plat:"🍽️", tro:"⛈️", flor:"🌸", clau:"🔑", creu:"✝️", fruit:"🍓", cranc:"🦀", bloc:"📒", fred:"🥶", brot:"🌱", brou:"🍲", grill:"🦗", gla:"🌰", crit:"😱", clip:"📎",
  pilota:"⚽", patata:"🥔", cadira:"🪑", maleta:"🧳", galeta:"🍪", piano:"🎹", escola:"🏫", sabata:"👞", camisa:"👕", pijama:"🛌", balena:"🐋", tortuga:"🐢", formiga:"🐜", bufanda:"🧣", taronja:"🍊", girafa:"🦒",
  mona:"🐒", sopa:"🥣", moto:"🏍️", foto:"📷", poma:"🍎", nina:"🪆", rata:"🐀", lupa:"🔍", mapa:"🗺️", foca:"🦭", oli:"🫒", vaca:"🐄", rosa:"🌹", casa:"🏠", boca:"👄", bici:"🚗", gelat:"🍦", taula:"🍽️", cotxe:"🚗", tigre:"🐅", llibre:"📕", granota:"🐸", estrella:"⭐", cocodril:"🐊", planeta:"🪐"
};
// Grapheme teaching order from the method (G1-G6). c· and g· are c/g before e, i.
const LETTER_ORDER = ["K01","K02","K03","K04","K05","K06","K07","K08","K09","K10","K11","K12","K13","K14","K15","K16","K17","K18","K19","K20","K21","K22","K23","K24","K25","K26","K27","K28","K29","K30"];
const GROUP_OF = {"K01":"a","K02":"s","K03":"l","K04":"o","K05":"m","K06":"e","K07":"r inicial","K08":"p","K09":"i","K10":"t","K11":"n","K12":"u","K13":"c ante a o u, l o r; coda","K14":"g ante a o u, l o r","K15":"d","K16":"f","K17":"r simple","K18":"rr","K19":"b","K20":"v","K21":"c ante e i","K22":"z","K23":"qu","K24":"j","K25":"g ante e i","K26":"gu davant e i","K27":"ll","K28":"ch","K29":"ñ","K30":"y"};
// How each grapheme is shown and how the consonant sound is cued when no recording exists.
const SHOW = {"K01":"a","K02":"s","K03":"l","K04":"o","K05":"m","K06":"e","K07":"r","K08":"p","K09":"i","K10":"t","K11":"n","K12":"u","K13":"c","K14":"g","K15":"d","K16":"f","K17":"r","K18":"rr","K19":"b","K20":"v","K21":"c","K22":"z","K23":"qu","K24":"j","K25":"g","K26":"gu","K27":"ll","K28":"ch","K29":"ñ","K30":"y"};
const KEYWORD = { s:"sol", l:"lupa", m:"mar", r:"rei", p:"pa", t:"tap", n:"nas", c:"cuc", g:"gat", d:"dit", f:"fum", b:"bou", v:"vaca", "c·":"cel", "g·":"gel", ll:"llum" };
const FINAL_KEYWORD = { ny:"pany", ix:"peix", ig:"raig" };
const VOWELS = new Set(["a","e","i","o","u"]);
// Rhyme families (same sound from the stressed vowel), taken from E4.1 of the method.
const RHYMES = [["gat","plat","blat","prat"],["sol","col","bol"],["pot","got","clot"],["pit","dit","nit","llit","crit"],["mar","bar"],["peu","neu","creu"],["riu","niu"],["cap","tap"],["cuc","suc"],["llum","fum"],["cel","gel","mel"],["nas","vas"],["fill","grill"],["llop","glop"],["pa","gra"]];
// Profile pictures: never a guide character and never a corpus word, so the student does not mix them up.
const AVATARS = ["🐻","🐼","🦁","🐨","🐧","🦄","🦖","🚀","🌈","🎨"];
// Guide characters: [emoji, spoken name, corpus word if the animal is also a corpus word].
// A corpus-word guide is kept out of the activities while it is the guide.
const GUIDES = [["🐘","Elefante",null],["🦔","Erizo","erizo"],["🐿️","Ardilla","ardilla"],["🦫","Castor",null],["🐝","Abeja","abeja"],["🤖","Robot",null],["🦊","Zorro","zorro"],["🐢","Tortuga","tortuga"],["🐙","Pulpo","pulpo"]];
const guideWord = p => guidesEnabled(p) ? (GUIDES.find(g => g[0] === p.pres.guide) || [])[2] || null : null;
const DIGRAPHS = ["l·l","ll","ny","rr","ss","tx","tg"];

function graphemes(w) {
  if(CAST_DATA.corpus[w])return CAST_DATA.corpus[w].units.slice();
  const out = [];
  for (let i = 0; i < w.length;) {
    const rest = w.slice(i);
    const d = DIGRAPHS.find(x => rest.startsWith(x));
    if (d) { out.push(d); i += d.length; continue; }
    const two = rest.slice(0, 2), next = rest[2] || "";
    if ((two === "qu" || two === "gu") && /[eiéèí]/.test(next)) { out.push(two); i += 2; continue; }
    if (two === "ix" && i > 0 && i + 2 === w.length && /[aeou]/.test(w[i - 1])) { out.push("ix"); i += 2; continue; }
    if (two === "ig" && i > 0 && i + 2 === w.length && /[aeou]/.test(w[i - 1])) { out.push("ig"); i += 2; continue; }
    const ch = w[i];
    if ((ch === "c" || ch === "g") && /[eiéèí]/.test(rest[1] || "")) { out.push(ch + "·"); i += 1; continue; }
    out.push(ch); i += 1;
  }
  return out;
}
const showG = g => SHOW[g] || g;
const WORDS = CORPUS.map(([id, level, word, syl]) => ({ id, level, word, syl, g: graphemes(word) }));
const WORD = Object.fromEntries(WORDS.map(w => [w.word, w]));
const LEVELS = ["N1","N2","N3","N4","N5","N6","N7","N8","N9","N10","N11","N12"];

/* ===== Utilities ===== */
const $ = (s, r = document) => r.querySelector(s);
function h(tag, attrs = {}, ...kids) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (v == null || v === false) continue;
    if (k === "class") e.className = v;
    else if (k === "style") e.style.cssText = v;
    else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
    else if (k === "html") e.innerHTML = v;
    else e.setAttribute(k, v === true ? "" : v);
  }
  for (const c of kids.flat()) if (c != null && c !== false) e.append(c instanceof Node ? c : document.createTextNode(String(c)));
  return e;
}
const shuffle = a => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
const pick = a => a[Math.floor(Math.random() * a.length)];
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const sleep = ms => new Promise(r => setTimeout(r, ms));
const fmtDate = t => new Date(t).toLocaleDateString("es-ES", { day: "numeric", month: "short" });
const fmtDateTime = t => new Date(t).toLocaleString("es-ES", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
const pct = x => Math.round(x * 100) + "%";
async function hashPw(pw) {
  try {
    const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode("lecaa|" + pw));
    return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, "0")).join("");
  } catch (e) { let x = 0; for (const c of "lecaa|" + pw) x = (x * 31 + c.charCodeAt(0)) | 0; return "w" + x; }
}

/* ===== Storage: profiles in localStorage, photos and recordings in IndexedDB ===== */
const KEY = "lecaa.cast.v1";
const Store = {
  data: { profiles: {} },
  ok: true,
  load() { try { const s = localStorage.getItem(KEY); if (s) this.data = JSON.parse(s); } catch (e) { this.ok = false; } if (!this.data.profiles) this.data.profiles = {}; },
  save() { try { localStorage.setItem(KEY, JSON.stringify(this.data)); this.ok = true; } catch (e) { this.ok = false; } },
};
const Media = {
  db: null, urls: {},
  open() {
    return new Promise(res => {
      try {
        const r = indexedDB.open("lecaa-cast-media", 1);
        r.onupgradeneeded = () => r.result.createObjectStore("m");
        r.onsuccess = () => { this.db = r.result; res(); };
        r.onerror = () => res();
      } catch (e) { res(); }
    });
  },
  tx(mode) { return this.db.transaction("m", mode).objectStore("m"); },
  put(pid, k, blob) {
    return new Promise(res => {
      if (!this.db) return res(false);
      const r = this.tx("readwrite").put(blob, pid + "|" + k);
      r.onsuccess = () => { if (this.urls[k]) URL.revokeObjectURL(this.urls[k]); this.urls[k] = URL.createObjectURL(blob); res(true); };
      r.onerror = () => res(false);
    });
  },
  del(pid, k) { return new Promise(res => { if (!this.db) return res(); const r = this.tx("readwrite").delete(pid + "|" + k); r.onsuccess = () => { delete this.urls[k]; res(); }; r.onerror = () => res(); }); },
  loadProfile(pid) {
    this.pid = pid;
    for (const u of Object.values(this.urls)) URL.revokeObjectURL(u);
    this.urls = {};
    return new Promise(res => {
      if (!this.db) return res();
      const st = this.tx("readonly"); const r = st.openCursor();
      r.onsuccess = () => {
        const c = r.result; if (!c) return res();
        const [p, k] = String(c.key).split(/\|(.*)/s);
        if (p === pid) this.urls[k] = URL.createObjectURL(c.value);
        c.continue();
      };
      r.onerror = () => res();
    });
  },
  removeProfile(pid) {
    return new Promise(res => {
      if (!this.db) return res();
      const st = this.tx("readwrite"); const r = st.openCursor();
      r.onsuccess = () => { const c = r.result; if (!c) return res(); if (String(c.key).startsWith(pid + "|")) c.delete(); c.continue(); };
      r.onerror = () => res();
    });
  },
};

/* ===== Voice: recorded human audio first, Catalan synthetic voice as fallback ===== */
const Voice = {
  voice: null, token: 0, rate: 0.9, volume: 1,
  init() {
    const pickV = () => {
      const vs = speechSynthesis.getVoices();
      this.voice = vs.find(v => /^ca(-|_|$)/i.test(v.lang)) || null;
    };
    try { pickV(); speechSynthesis.onvoiceschanged = pickV; } catch (e) {}
