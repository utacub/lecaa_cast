document.addEventListener("contextmenu", ev => { if (Access.root && Access.isScan() && Access.cfg.clickAsSwitch) ev.preventDefault(); });

/* ===== Learner model derived from the trial log ===== */
function learnedSet(p) { return new Set(p.plan.learned); }
function currentLetter(p) { const L = learnedSet(p); return LETTER_ORDER.find(g => !L.has(g)) || null; }
function decodable(p, w) { const L = learnedSet(p); return w.g.every(g => L.has(g)); }
function usableWords(p) { const ex = new Set([...p.plan.excluded, guideWord(p)]); return WORDS.filter(w => !ex.has(w.word) && hasPic(w.word)); }
function readableWords(p) { return usableWords(p).filter(w => decodable(p, w)); }
function wordStats(p) {
  const m = {};
  for (const t of p.log) {
    if (t.valid === false || !t.word) continue;
    const s = m[t.word] = m[t.word] || { read: new Set(), write: new Set(), readTry: 0, writeTry: 0 };
    if (t.tpl === "T9") { s.readTry++; if (t.indep) s.read.add(t.sid); }
    if (t.tpl === "T11") { s.writeTry++; if (t.indep) s.write.add(t.sid); }
  }
  return m;
}
const readMastered = (st, w) => (st[w]?.read.size || 0) >= 2;
const writeMastered = (st, w) => (st[w]?.write.size || 0) >= 2;
// Mastery of a new letter uses ONLY the trials whose target is that letter (method, E8.1).
function letterSessions(p, g) {
  const by = new Map();
  for (const t of p.log) {
    if (t.tpl !== "T8" || t.target !== g || t.valid === false) continue;
    const s = by.get(t.sid) || { n: 0, ok: 0, t: t.t }; s.n++; if (t.indep) s.ok++; by.set(t.sid, s);
  }
  return [...by.values()].sort((a, b) => a.t - b.t);
}
function applyMastery(p) {
  const news = [];
  const g = currentLetter(p);
  if (g) {
    const q = letterSessions(p, g).filter(s => s.n >= 4);
    const last2 = q.slice(-2);
    if (last2.length === 2 && last2.every(s => s.ok / s.n >= p.plan.crit)) {
      p.plan.learned.push(g);
      logChange(p, `Correspondencia «${showG(g)}» resuelta: al menos el ${pct(p.plan.crit)} de aciertos independientes en dos sesiones. Ahora se trabaja «${showG(currentLetter(p) || "-")}».`, "auto");
      news.push("letra " + showG(g));
    }
  }
  const st = wordStats(p);
  p.state.known = p.state.known || { read: [], write: [] };
  for (const w of Object.keys(st)) {
    if (readMastered(st, w) && !p.state.known.read.includes(w)) { p.state.known.read.push(w); news.push(w); }
    if (writeMastered(st, w) && !p.state.known.write.includes(w)) { p.state.known.write.push(w); news.push(w + " (escrita)"); }
  }
  return news;
}
function logChange(p, what, who = "adult") { p.changes.unshift({ t: Date.now(), what, who }); if (p.changes.length > 300) p.changes.length = 300; }

/* ===== Student stage ===== */
let S = null; // current session
function stageShell() {
  const p = S.p;
  const ctl = h("div", { class: "controls", "data-groupbox": "ctl" });
  const add = (icon, label, fn, cue) => { const b = h("button", { class: "ctl", "data-sel": "", "data-group": "ctl", "data-cue": cue || label, "data-groupcue": "botones" }, h("span", { class: "i", "aria-hidden": "true" }, icon), label); b._act = fn; ctl.append(b); return b; };
  S.listenBtn = add("👂", "Escucha", () => S.onListen && S.onListen());
  add("⏸️", "Pausa", pauseSession);
  if (p.pres.showAjuda !== false) add("🙋", "Ayuda", askHelp, "Pide ayuda");
  if (p.pres.commUrl) add("💬", "Comunicador", openCommunicator);
  if (p.pres.showAcabar !== false) add("🏁", "Terminar", () => endSession("acabat"));
  const main = h("div", { class: "stage-main", id: "sm" });
  const stage = h("div", { class: "stage", role: "main" }, main, ctl);
  return { stage, main, ctl };
}
function mountStage(nodes) {
  const app = $("#app"); app.replaceChildren();
  const { stage, main } = stageShell();
  main.append(...nodes);
  if (stage.querySelector(".msgline")) stage.classList.add("message-stage");
  app.append(stage, cornerExit());
  return { stage, main };
}
function cornerExit() {
  const c = h("div", { class: "corner", role: "button", tabindex: "0", "aria-label": "Zona de adulto: mantén pulsado tres segundos o pulsa Intro" }, h("span", { class: "fill" }));
  let t0 = 0, raf = null;
  c.addEventListener("keydown", ev => { if (ev.key === "Enter") { ev.preventDefault(); adultGate(S ? S.p : null, () => { if (S) abortSession(); }); } });
  const stop = () => { cancelAnimationFrame(raf); c.style.removeProperty("--p"); c.firstChild.style.removeProperty("--p"); };
  c.addEventListener("pointerdown", ev => {
    ev.preventDefault(); t0 = performance.now();
    const step = () => {
      const pr = Math.min(1, (performance.now() - t0) / 3000); c.firstChild.style.setProperty("--p", pr);
      if (pr >= 1) { stop(); adultGate(S ? S.p : null, () => { if (S) abortSession(); }); return; }
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  });
  ["pointerup", "pointerleave", "pointercancel"].forEach(e => c.addEventListener(e, stop));
  return c;
}
function speechBubble(text) { return h("div", { class: "row", style: "justify-content:center" }, h("span", { class: "guide", "aria-hidden": "true" }, S.p.pres.guide || "🐘"), h("div", { class: "speech" }, text)); }
function bindStage(onCue,opts={}) { Access.bind($("#app"), { ...opts, onCue: onCue || (c => Voice.say(c, { volume: 0.7 })) }); }

function startStudent(p) {
  normalizeActivities(p);
  const available=Object.values(availableActivities(p)).some(Boolean);
  if(!available){adultHome(p,'plan');document.querySelector('.settings-content')?.prepend(h('p',{class:'note',role:'status'},"No hay ninguna actividad disponible. Activa una actividad en el Plan o revisa las correspondencias que tiene activadas el alumno."));return;}
  applyPresentation(p);Tone.play('start');Access.setConfig(p.access);
  S={p,sid:uid(),start:Date.now(),trials:[],requeue:[],n:0,s:{streak:0,errs:0},paused:false,ended:false,helpReq:false,seen:{}};
  const welcomeSession=S;const btn=h('button',{class:'big-start','data-sel':'','data-cue':"Comenzamos"},"Comenzamos");
  btn._act=()=>{Voice.stop();runSession();};
  const intro=guidesEnabled(p)?"Hola, "+p.name+'! '+guideIntroduction(p):"Hola, "+p.name+"! ¿Comenzamos?";
  mountStage([speechBubble(intro),btn]);$('#app .controls').hidden=true;bindStage(undefined,{suspend:true});
  Voice.say(guidesEnabled(p)?["¡Hola!",guideIntroduction(p)]:["¡Hola!","Comenzamos."]).finally(()=>{if(S===welcomeSession&&S.n===0&&!S.ended&&!S.paused)Access.resumePresentation();});
}
function applyPresentation(p) {
  document.body.classList.remove('workspace-theme');
  if(!GUIDES.some(g=>g[0]===p.pres.guide)){p.pres.guide=GUIDES[0][0];Store.save();}
  const size = { m: "7.5rem", l: "9.5rem", xl: "12rem" }[p.pres.tile || "l"];
  document.documentElement.style.setProperty("--tile", size);
  document.body.classList.toggle("reduce-motion", !!p.pres.reduceMotion);
  Voice.pick(p.pres.voiceURI); Voice.rate = p.pres.rate || 0.9; Voice.volume = p.pres.volume ?? 1; Tone.on = p.pres.sounds !== false;
}

/* ===== Session engine ===== */
function slotPlan(n) { const a = ["warm", "warm"]; for (let i = 0; i < n - 3; i++) a.push("work"); a.push("close"); return a; }
async function runSession() {
  const ses = S; const p = ses.p; const plan = slotPlan(p.plan.trials || 12);
  p.sessions.push({ id: ses.sid, start: ses.start, mode: p.access.mode, device: navigator.platform || "", trials: 0, end: null, how: null });
  Store.save();
  for (let i = 0; i < plan.length && !ses.ended; i++) {
    let item = null;
    if (plan[i] === "work" && ses.requeue.length && Math.random() < 0.5) item = ses.requeue.shift();
    if (!item) item = makeItem(p, plan[i]);
    if (!item) continue;
    const rec = await runItem(item);
    if (!rec || ses.ended) break;
    if (rec.errored && !item.requeued) ses.requeue.push({ ...item, requeued: true });
  }
  while (ses.requeue.length && !ses.ended) { const it = ses.requeue.shift(); const r = await runItem(it); if (!r) break; }
  if (ses.ended) return;
  if (!ses.ended && S === ses) endSession("complet");
}
function runItem(item) {
  S.n++;
  if (item.tpl === "T11") return runBuild(item);
  return runChoice(item);
}
function weightedPick(opts) { const tot = opts.reduce((a, o) => a + o[1], 0); let r = Math.random() * tot; for (const o of opts) { r -= o[1]; if (r <= 0) return o[0]; } return opts[0][0]; }
// Default Central Catalan sounds shared by more than one teaching grapheme.
function soundKey(g){return ({v:'b','c·':'s'})[g]||g;}
function initialSoundWords(p){const ex=new Set(p.plan.excluded);return WORDS.filter(w=>w.word!==guideWord(p)&&['N1','N2'].includes(w.level)&&hasPic(w.word)&&!ex.has(w.word)&&!DIGRAPHS.includes(w.g[0]));}
function rhymeFamilies(p){const ex=new Set([...p.plan.excluded,guideWord(p)]);return RHYMES.map(f=>f.filter(w=>!ex.has(w)&&hasPic(w))).filter(f=>f.length);}
function availableActivities(p){
 const a=p.plan.acts,L=p.plan.learned,readable=readableWords(p),families=rhymeFamilies(p),initials=initialSoundWords(p),counts={},pictures=new Set(usableWords(p).map(w=>pictureKey(w.word,p))).size;
 for(const w of initials){const g=soundKey(w.g[0]);counts[g]=(counts[g]||0)+1;}
 return{t8:!!(a.t8&&(currentLetter(p)||L.length)),t9:!!(a.t9&&L.length>=4&&readable.length&&pictures>=2),t11:!!(a.t11&&L.length>=4&&readable.some(w=>w.g.length<=6)),t1:!!(a.t1&&Object.keys(counts).length>=2&&Object.values(counts).some(n=>n>=2)),t2:!!(a.t2&&(families.length>=2||families.some(f=>f.length>=2)))};
}
function makeItem(p, kind) {
  const a = p.plan.acts, L = p.plan.learned, cur = currentLetter(p);
  const can = availableActivities(p);
  let tpl;
  if (kind === "warm" || kind === "close") {
    const opts = [];
    if (can.t8 && L.length) opts.push(["t8r", 3]);
    if (can.t9) opts.push(["t9r", 2]);
    if (can.t2) opts.push(["t2", 1]);
    if (can.t1) opts.push(["t1", 1]);
    if (!opts.length) { if(can.t8)opts.push(["t8",1]);else if(can.t11)opts.push(["t11",1]);else return null; }
    tpl = weightedPick(opts);
  } else {
    const opts = [];
    if (can.t8 && cur) opts.push(["t8", 3]);
    if (can.t8 && L.length >= 2) opts.push(["t8r", 1]);
    if (can.t9) opts.push(["t9", 3]);
    if (can.t11) opts.push(["t11", 2]);
    if (can.t1) opts.push(["t1", 1]);
    if (can.t2) opts.push(["t2", 1]);
    if (!opts.length) return null;
    tpl = weightedPick(opts);
  }
  try {
    if (tpl === "t8") return itemT8(p, cur || pick(L), kind);
    if (tpl === "t8r") return itemT8(p, pick(L.length ? L : [cur]), kind);
    if (tpl === "t9" || tpl === "t9r") return itemT9(p, tpl === "t9r");
    if (tpl === "t11") return itemT11(p);
    if (tpl === "t1") return itemT1(p);
    if (tpl === "t2") return itemT2(p);
  } catch (e) { console.warn(e); }
  return null;
}

/* ----- item builders (content and distractor rules) ----- */
function itemT8(p, g, kind) {
  const L = p.plan.learned.filter(x => x !== g);
  const compatible = x => showG(x) !== showG(g) && soundKey(x) !== soundKey(g);
  let pool = L.filter(compatible);
  if (pool.length < 3) pool = pool.concat(LETTER_ORDER.filter(x => !pool.includes(x) && compatible(x)).slice(0, 3 - pool.length + 2));
  const n = p.plan.options || 4;
  const opts = shuffle([g, ...shuffle(pool).slice(0, n - 1)]);
  const isNew = g === currentLetter(p);
  const prev = p.log.filter(t => t.tpl === "T8" && t.target === g).length;
  const prompt = Voice.hasRec("so:" + g) ? ["Cuál hace", { rec: "so:" + g }] :
    VOWELS.has(g) ? [`¿Cuál es la ${g}?`] : KEYWORD[g] ? [`¿Qué letra representa el primer sonido de ${KEYWORD[g]}?`] : FINAL_KEYWORD[g] ? [`¿Qué letra representa el último sonido de ${FINAL_KEYWORD[g]}?`] : [`¿Cuál es la ${g}?`];
  return {
    tpl: "T8", ex: "E8.1", skill: "lletra", target: g, kind: isNew ? "nova" : kind === "work" ? "repaso" : kind,
    promptText: VOWELS.has(g) ? "¿Cuál es esta letra?" : "¿Qué letra representa este sonido?",
    prompt, options: opts.map(x => ({ value: x, node: h("span", { class: "let" }, showG(x)) })),
    correct: g, startHelp: 0, cueOptions: false,
    hint: lvl => { if (lvl === 2) { const t = document.querySelector(`.tile[data-v="${CSS.escape(g)}"]`); t && t.classList.add("hint"); } },
    onOk: ["¡Muy bien!", ...soundParts(g)],
  };
}
function similarity(a, b) {
  let s = 0; const A = a.g, B = b.g;
  if (A.length === B.length) s += 2;
  for (let i = 0; i < Math.min(A.length, B.length); i++) if (A[i] === B[i]) s += 2;
  if (A[A.length - 1] === B[B.length - 1]) s += 1;
  return s;
}
function errorCode(target, chosen) {
  const A = WORD[target]?.g, B = WORD[chosen]?.g; if (!A || !B) return "ERR-ALTRE";
  if (A.length === B.length) {
    const diff = A.map((g, i) => g !== B[i] ? i : -1).filter(i => i >= 0);
    if (diff.length === 1) { const i = diff[0]; if (i === 0) return "ERR-INI"; if (i === A.length - 1) return "ERR-FIN"; return "ERR-MED"; }
  }
  return "ERR-ALTRE";
}
function chooseTarget(p, list, review) {
  const st = wordStats(p);
  const learning = list.filter(w => !readMastered(st, w.word));
  const mastered = list.filter(w => readMastered(st, w.word));
  const src = review ? (mastered.length ? mastered : list) : (learning.length && Math.random() < 0.7 ? learning : list);
  return pick(src);
}
function distractorWords(p, target, n) {
  const gw = guideWord(p);
  const ex = new Set(p.plan.excluded);
  const pool = WORDS.filter(w => w.word !== target.word && w.word !== gw && hasPic(w.word) && !ex.has(w.word) && LEVELS.indexOf(w.level) <= Math.max(3, LEVELS.indexOf(target.level)));
  const scored = shuffle(pool).map(w => [w, similarity(target, w)]).sort((a, b) => b[1] - a[1]);
  const seen=new Set([pictureKey(target.word,p)]);
  return scored.map(x=>x[0]).filter(w=>{const key=pictureKey(w.word,p);if(seen.has(key))return false;seen.add(key);return true;}).slice(0,n);
}
function itemT9(p, review) {
  const list = readableWords(p); const target = chooseTarget(p, list, review);
  const opts = shuffle([target, ...distractorWords(p, target, 3)]);
  const sLvl = review || TaskSupport.mode(p)!=='auto' ? 0 : (p.state.sRead ?? 3);
  return {
    tpl: "T9", ex: sLvl > 0 ? "E9.1" : "E9.2", skill: "lectura", target: target.word, word: target.word, s: sLvl, kind: review ? "repaso" : "ensenyament",
    promptText: "Lee. ¿Qué imagen es?", prompt: ["Lee la palabra. ¿Qué imagen es?"],
    stimulusWord: target, nameOptions: p.pres.nameImages !== false,
    options: opts.map(w => ({ value: w.word, node: pic(w.word), cue: w.word })),
    correct: target.word, startHelp: 0, cueOptions: true,
    hint: lvl => { if (lvl === 2) return lightLetters(target, true); },
    onOk: ["¡Sí!", target.word],
  };
}
function itemT1(p) {
  const cand = initialSoundWords(p);
  const first = w => soundKey(w.g[0]);
  const byFirst = {}; cand.forEach(w => (byFirst[first(w)] = byFirst[first(w)] || []).push(w));
  const keys = Object.keys(byFirst).filter(k => byFirst[k].length >= 2);
  const k = pick(keys); const [key, target] = shuffle(byFirst[k]);
  const others = shuffle(cand.filter(w => first(w) !== k && pictureKey(w.word,p)!==pictureKey(target.word,p)));
  const ds = []; for (const w of others) { if (ds.length >= 3) break; if (!ds.some(d => first(d) === first(w) || pictureKey(d.word,p)===pictureKey(w.word,p))) ds.push(w); }
  const opts = shuffle([target, ...ds]);
  return {
    tpl: "T1", ex: "E5.1", skill: "so inicial", target: target.word, key: key.word, kind: "ensenyament",
    promptText: `¿Cuál empieza como «${key.word}»?`, prompt: [`¿Cuál empieza como ${key.word}?`],
    nameOptions: true, options: opts.map(w => ({ value: w.word, node: pic(w.word), cue: w.word })),
    correct: target.word, startHelp: 0, cueOptions: true,
    hint: lvl => { if (lvl === 2) return Voice.say([key.word, { pause: 300 }, target.word], { rate: 0.6 }); },
    onOk: ["¡Sí!", `${target.word} empieza como ${key.word}.`],
  };
}
function itemT2(p) {
  const families=rhymeFamilies(p),positive=families.filter(f=>f.length>=2);
  if(families.length<2&&!positive.length)return null;
  const rhyme=families.length<2||(positive.length>0&&Math.random()<.5);
  let a,b;
  if(rhyme){[a,b]=shuffle(pick(positive));}
  else{const[f1,f2]=shuffle(families);a=pick(f1);b=pick(f2);}
  const yes = h("span", { class: "lbl" }, "👍 sí"), no = h("span", { class: "lbl" }, "👎 no");
  return {
    tpl: "T2", ex: "E4.1", skill: "rima", target: rhyme ? "sí" : "no", pair: a + "-" + b, kind: "ensenyament",
    promptText: `¿Riman «${a}» y «${b}»?`, prompt: [`¿Riman ${a} y ${b}?`],
    stimulusPics: [a, b],
    options: [{ value: "sí", node: yes, cue: "sí", cls: "yes" }, { value: "no", node: no, cue: "no", cls: "no" }],
    correct: rhyme ? "sí" : "no", startHelp: 0, cueOptions: true,
    hint: lvl => { if (lvl === 2) return Voice.say([a, { pause: 400 }, b], { rate: 0.6 }); },
    onOk: rhyme ? ["¡Sí, riman!", a, b] : ["Muy bien, no riman."],
  };
}
function itemT11(p) {
  const st = wordStats(p);
  const list = readableWords(p).filter(w => w.g.length <= 6);
  const pref = list.filter(w => readMastered(st, w.word) && !writeMastered(st, w.word));
  const target = pick(pref.length && Math.random() < 0.7 ? pref : list);
  const extra = shuffle(p.plan.learned.filter(g => !target.g.includes(g))).slice(0, 2);
  return { tpl: "T11", ex: "E10.2", skill: "escriptura", target: target.word, word: target.word, w: target, keys: shuffle([...new Set([...target.g, ...extra])]), kind: "ensenyament" };
}
function exerciseLetterCase(p){return p?.pres?.letterCase==='upper'?'upper':'lower';}
function letterCaseSetting(p){
 const preview=h('div',{class:'letter-case-preview','aria-hidden':'true'});
 const refresh=()=>{preview.textContent=exerciseLetterCase(p)==='upper'?'A B C · SOL':'a b c · sol';};
 const select=sel(exerciseLetterCase(p),[['lower','Minúscules · a b c'],['upper','Majúscules (lletra de pal) · A B C']],value=>{p.pres.letterCase=value;save(p,"Letra de los ejercicios: "+(value==='upper'?"mayúsculas":"minúsculas"));refresh();});
 select.setAttribute('data-letter-case-choice','');refresh();
 return h('section',{class:'stack letter-case-settings'},field("Letra de los ejercicios",select,"Se aplica a las letras y palabras de las actividades. Los enunciados mantienen el formato actual."),preview);
}
const LetterHighlights={
 sequence:0,nodes:new Map(),
 clear(owner){for(const[node,id]of this.nodes)if(owner===undefined||id===owner){node.classList.remove('lit');this.nodes.delete(node);}},
 mark(node,owner){this.clear(owner);this.nodes.set(node,owner);node.classList.add('lit');}
};
async function lightLetters(w,withSound,elements=null){
 if(withSound)Voice.stop();
 LetterHighlights.clear();
 const owner=++LetterHighlights.sequence,token=Voice.token,bankVoice=withSound?RecordedBank.voice():null;
 const spans=elements?[...elements]:[...document.querySelectorAll('.stim-word .g')];
 if(withSound)GuideMotion.speech++;
 try{
  for(let i=0;i<Math.min(spans.length,w.g.length);i++){
   if(token!==Voice.token||owner!==LetterHighlights.sequence||!spans[i].isConnected)return false;
   LetterHighlights.mark(spans[i],owner);
   if(withSound&&Voice.hasRec('so:'+w.g[i]))await Voice.playRec('so:'+w.g[i],{bankVoice});else await sleep(650);
   if(token!==Voice.token||owner!==LetterHighlights.sequence)return false;
   if(withSound&&i<spans.length-1&&!(await Voice.waitBetween()))return false;
  }
  return true;
 }finally{LetterHighlights.clear(owner);if(withSound)GuideMotion.speech--;}
}

/* ----- generic choice template runner (T1, T2, T8, T9) ----- */

/* Adult-controlled repetition and help. Legacy profiles keep adaptive timing. */
const TaskSupport={
 mode(p){return ['auto','repeat','manual'].includes(p.pres.supportMode)?p.pres.supportMode:'auto';},
 delay(p,factor=1){const adaptive=waitMs(p)*factor;const value=Number(p.pres.supportWaitSeconds??30);return p.pres.supportTiming==='fixed'&&Number.isFinite(value)?Math.max(adaptive,Math.max(5,Math.min(3600,value))*1000):adaptive;}
};

function waitMs(p) {
  const rts = p.log.filter(t => t.ok && t.rt).slice(-20).map(t => t.rt).sort((a, b) => a - b);
  const med = rts.length ? rts[Math.floor(rts.length / 2)] : 0;
  const a = p.access; let floor = 9000;
  if (["auto", "step1", "step2"].includes(a.mode)) floor = (Access.entries.length + 1) * (a.interval || 2) * 1000 * (a.mode === "auto" ? a.cycles || 2 : 1) + 4000;
  if (a.mode === "dwell") floor = 9000 + a.dwell * 1000;
  return Math.max(floor, med * 1.5);
}
function runChoice(it) {
  return new Promise(resolve => {
    const p = S.p;
    const nodes = [speechBubble(it.promptText)];
    if (it.stimulusWord) {
      const w = h("div", { class: "stim-word", "data-groupbox": "word", lang: "es" });
      it.stimulusWord.g.forEach((g, i) => {
        const span = h(it.s === 2 ? "button" : "span", { class: "g" + (it.s === 2 ? " tile-letter" : ""), "data-gi": i }, showG(g));
        if (it.s === 2) { span.setAttribute("data-sel", ""); span.setAttribute("data-group", "word"); span.style.cssText = "border:0;background:none;font:inherit;cursor:pointer;color:inherit"; span._act = () => { Voice.stop(); Voice.playRec("so:" + g); span.classList.add("lit"); setTimeout(() => span.classList.remove("lit"), 700); Access.restartAfter(); }; }
        w.append(span);
      });
      const stim = h("div", { class: "stimulus" }, w);
      if (it.s === 1) { const b = h("button", { class: "ctl", "data-sel": "", "data-cue": "Escucha la palabra" }, h("span", { class: "i" }, "🔊"), "Escúchala"); b._act = () => { Voice.say(it.stimulusWord.word, { rate: 0.7 }); listens++; }; stim.append(b); }
      nodes.push(stim);
    }
    if (it.stimulusPics) nodes.push(h("div", { class: "stimulus" }, ...it.stimulusPics.map(w => hasPic(w) ? h("div", { class: "stim-pic", "aria-label": w }, pic(w)) : null)));
    // keep correct answer from repeating the same position more than twice in a row
    let opts = it.options.slice();
    if (S.lastPos != null && S.lastPos2 === S.lastPos) {
      const ci = opts.findIndex(o => o.value === it.correct);
      if (ci === S.lastPos && opts.length > 1) { const j = (ci + 1) % opts.length; [opts[ci], opts[j]] = [opts[j], opts[ci]]; }
    }
    const pos = opts.findIndex(o => o.value === it.correct); S.lastPos2 = S.lastPos; S.lastPos = pos;
    const ans = h("div", { class: "answers" });
    const tiles = opts.map(o => {
      const t = h("button", { class: "tile" + (o.cls ? " " + o.cls : ""), "data-sel": "", "data-v": o.value, "aria-label": it.cueOptions ? o.cue || o.value : "opción", "data-cue": it.cueOptions ? (o.cue || "") : null }, o.node || h("span", { class: "wrd" }, o.value));
      t._act = () => choose(o.value, t); ans.append(t); return t;
    });
    nodes.push(ans);
    mountStage(nodes,it.tpl);
    let help = 0, firstErr = null, errors = 0, done = false, listens = 0, timer = null, t0 = 0, sels = 0, model = false;
    const rec = { id: uid(), sid: S.sid, t: Date.now(), tpl: it.tpl, ex: it.ex, skill: it.skill, target: it.target, word: it.word || null, kind: it.kind, s: it.s != null ? "S" + it.s : null, options: opts.map(o => o.value), access: p.access.mode, itemVer: 1, valid: true };
    const say = () => Voice.say(it.prompt);

    const applyHelp = async lvl => {
      if(done||S!==presentationSession||S.ended)return;
      GuideMotion.cue(lvl===1?4:5);
      help = Math.max(help, lvl);
      if (lvl === 1) await say();
      if (lvl === 2) { if(it.hint)await it.hint(2); await Voice.say(it.prompt, { rate: 0.75 }); }
      if (lvl === 3) {
        const others = tiles.filter(t => t.dataset.v !== it.correct);
        const keep = pick(others); others.forEach(t => { if (t !== keep) t.classList.add("dim"); });
        Access.refresh(); await say();
      }
      if (lvl === 4) {
        model = true; const ct = tiles.find(t => t.dataset.v === it.correct); ct.classList.add("model", "hint");
        await Voice.say(["Es esta.", { pause: 200 }, ...[].concat(it.prompt)]);
      }
    };
    let supportBusy=false;
    const schedule = () => {
      clearTimeout(timer);
      if(done||TaskSupport.mode(p)==='manual'||(TaskSupport.mode(p)==='auto'&&help>=4))return;
      timer = setTimeout(async () => {
        if(done||S!==presentationSession||S.ended)return;
        if(S.paused||supportBusy)return schedule();
        supportBusy=true;
        try{if(TaskSupport.mode(p)==='repeat'){GuideMotion.cue(4);await say();}else await applyHelp(help+1);}
        finally{supportBusy=false;schedule();}
      }, TaskSupport.delay(p));
    };
    S.onListen=async()=>{if(done||supportBusy)return;clearTimeout(timer);supportBusy=true;listens++;try{GuideMotion.cue(4);await say();}finally{supportBusy=false;schedule();}};
    S.onHelp=async()=>{if(done||supportBusy)return;clearTimeout(timer);supportBusy=true;try{await applyHelp(Math.max(2,Math.min(4,help+1)));}finally{supportBusy=false;schedule();}};
    const finish = ok => {
      done = true; clearTimeout(timer);
      Object.assign(rec, {
        answer: firstErr ?? it.correct, ok, indep: ok && help === 0 && (it.s == null || it.s === 0),
        help: "A" + help, err: firstErr != null ? (it.tpl === "T8" ? "ERR-LLETRA" : it.tpl === "T9" ? errorCode(it.correct, firstErr) : "ERR-" + it.tpl) : null,
        rt: Date.now() - t0, listens, sels: Access.stats.sels, cycles: Access.stats.cycles, helpRequested: S.helpReq || undefined,
        errored: errors > 0,
      });
      S.helpReq = false;
      if (it.tpl === "T9" && it.s != null && it.kind !== "repàs") {
        const st = S.s;
        if (ok && help === 0) { st.streak++; st.errs = 0; if (st.streak >= 3 && p.state.sRead > 0) { p.state.sRead--; st.streak = 0; } }
        else { st.errs++; st.streak = 0; if (st.errs >= 2 && p.state.sRead < 3) { p.state.sRead++; st.errs = 0; } }
      }
      p.log.push(rec); S.trials.push(rec);
      const ss = p.sessions.find(x => x.id === S.sid); if (ss) ss.trials = S.trials.length;
      Store.save();
    };
    async function choose(v, t) {
      if (done) return;
      if (v === it.correct) {
        finish(errors === 0 && !model);
        t.classList.add("right"); Tone.play("ok");
        await Voice.feedback(it.onOk);
        await sleep(Math.max(400, Feedback.gapMs()));
        resolve(rec);
      } else {
        errors++; if (firstErr == null) firstErr = v;
        clearTimeout(timer);
        if(TaskSupport.mode(p)==='auto'){
          t.classList.add("dim");Access.refresh();
          supportBusy=true;
          try{await applyHelp(help<2?2:Math.min(4,help+1));}finally{supportBusy=false;}
        }else{t.classList.add('answer-error');setTimeout(()=>t.classList.remove('answer-error'),700);}
        schedule();
      }
    }
    S.abortTrial = () => { if (!done) { done = true; clearTimeout(timer); resolve(null); } };
    const presentationSession=S;
    let initialPresentation=true,presentationRun=0;
    S.pauseTrial=()=>{clearTimeout(timer);presentationRun++;supportBusy=false;};
    S.resumeTrial=()=>{if(initialPresentation){Access.suspended=true;present();}else schedule();};
    bindStage(undefined,{suspend:true});
    async function present(){
      const version=++presentationRun;
      const current=()=>!done&&S===presentationSession&&!S.ended&&!S.paused&&version===presentationRun;
      Access.locked=true;supportBusy=true;
      try{
        await say();if(!current())return;
        if(it.s===3&&it.stimulusWord){
          if(!(await lightLetters(it.stimulusWord,true))||!current())return;
          await Voice.say([it.stimulusWord.word],{rate:.55});if(!current())return;
          if(await Voice.waitBetween()){if(!current())return;await Voice.say([it.stimulusWord.word]);}
          if(!current())return;
        }
        if(it.nameOptions&&await Voice.waitBetween()){
          if(!current())return;
          for(const tt of tiles){
            if(!current())return;tt.classList.add('hint');
            try{await Voice.say(tt.dataset.cue||tt.dataset.v);}finally{tt.classList.remove('hint');}
            if(!current())return;
            if(tt!==tiles.at(-1)&&!(await Voice.waitBetween()))return;
          }
        }
        if(!current())return;
        initialPresentation=false;t0=Date.now();Access.resumePresentation();schedule();
      }finally{if(version===presentationRun){supportBusy=false;Access.locked=false;}}
    }
    present();
  });
}

/* ----- T11: build the word with letters ----- */
function runBuild(it) {
  return new Promise(resolve => {
    const p = S.p; const target = it.w;
    const typed = [];
    let typedReadingToken=null;
    const slots = h("div", { class: "slots", "aria-live": "polite" });
    const drawSlots = () => {if(typedReadingToken===Voice.token)Voice.stop();slots.replaceChildren(...target.g.map((_, i) => h("span", { class: "slot" }, typed[i] ? showG(typed[i]) : "")), ...typed.slice(target.g.length).map(g => h("span", { class: "slot" }, showG(g))));};
    drawSlots();
    const kb = h("div", { class: "kbd" });
    const row1 = h("div", { class: "krow", "data-groupbox": "k1" }), row2 = h("div", { class: "krow", "data-groupbox": "k2" });
    let keys = it.keys.slice();
    const drawKeys = () => {
      row1.replaceChildren(...keys.map(g => { const b = h("button", { class: "key", "data-sel": "", "data-group": keys.length > 4 ? "k1" : null, "data-v": g, "aria-label": "lletra" }, showG(g)); b._act = () => { typed.push(g); drawSlots(); schedule(); Access.restartAfter(); }; return b; }));
    };
    drawKeys();
    const fn = (label, act, cue) => { const b = h("button", { class: "key fn", "data-sel": "", "data-group": "k2", "data-cue": cue || label }, label); b._act = act; return b; };
    row2.append(
      fn("⌫ Borra", () => { typed.pop(); drawSlots(); schedule(); Access.restartAfter(); }, "Borra"),
      fn("👂 Lo que he escrito", async () => {
        if(done||(supportBusy&&typedReadingToken===null))return;
        clearTimeout(timer);supportBusy=true;
        const playback=lightLetters({g:typed.slice()},true,[...slots.children].slice(0,typed.length));
        const token=Voice.token;typedReadingToken=token;
        try{await playback;}finally{if(typedReadingToken===token){typedReadingToken=null;supportBusy=false;if(!done&&S===presentationSession&&!S.ended){schedule();if(!S.paused)Access.restartAfter();}}}
      }, "Escucha lo que he escrito"),
      fn("✔ Hecho", () => check(), "Hecho"),
    );
    kb.append(row1);
    row2.classList.add("writing-actions");
    const pic1 = h("div", { class: "stim-pic", "aria-label": target.word }, pic(target.word));
    mountStage([speechBubble("Escribe la palabra."), h("div", { class: "writing-layout" }, h("div", { class: "writing-main" }, h("div", { class: "stimulus" }, pic1), slots, kb), row2)],"T11");
    let help = 0, errors = 0, firstErr = null, done = false, timer = null, t0 = Date.now(), listens = 0;
    const say = () => Voice.say(["Escribe", target.word]);

    const rec = { id: uid(), sid: S.sid, t: Date.now(), tpl: "T11", ex: it.ex, skill: "escriptura", target: target.word, word: target.word, kind: it.kind, access: p.access.mode, itemVer: 1, valid: true };
    const applyHelp = async lvl => {
      if(done||S!==presentationSession||S.ended)return;
      GuideMotion.cue(lvl===1?4:5);
      help = Math.max(help, lvl);
      if (lvl === 1) await say();
      if (lvl === 2) { const nextG = target.g[0]; const k = row1.querySelector(`[data-v="${CSS.escape(nextG)}"]`); k && k.classList.add("hint"); await Voice.say(["Escribe", target.word], { rate: 0.6 }); }
      if (lvl === 3) { keys = [...new Set(target.g)]; drawKeys(); Access.refresh(); }
      if (lvl === 4) { const m = h("div", { class: "stim-word" }, target.word); slots.before(m); await Voice.say(["Mira com s'escriu.", target.word]); await sleep(3000); m.remove(); }
    };
    let supportBusy=false;
    const schedule=()=>{
      clearTimeout(timer);
      if(done||TaskSupport.mode(p)==='manual'||(TaskSupport.mode(p)==='auto'&&help>=4))return;
      timer=setTimeout(async()=>{
        if(done||S!==presentationSession||S.ended)return;if(S.paused||supportBusy)return schedule();supportBusy=true;
        try{if(TaskSupport.mode(p)==='repeat'){GuideMotion.cue(4);await say();}else await applyHelp(help+1);}
        finally{supportBusy=false;schedule();}
      },TaskSupport.delay(p,1.6));
    };
    S.onListen=async()=>{if(done||supportBusy)return;clearTimeout(timer);supportBusy=true;listens++;try{GuideMotion.cue(4);await say();}finally{supportBusy=false;schedule();}};
    S.onHelp=async()=>{if(done||supportBusy)return;clearTimeout(timer);supportBusy=true;try{await applyHelp(Math.max(2,Math.min(4,help+1)));}finally{supportBusy=false;schedule();}};
    async function check() {
      if (done) return;
      const ok = typed.join("|") === target.g.join("|");
      if (ok) {
        done = true; clearTimeout(timer);
        Object.assign(rec, { answer: typed.map(showG).join(""), ok: errors === 0, indep: errors === 0 && help === 0, help: "A" + help, err: firstErr !== null ? "ERR-ESCR" : null, rt: Date.now() - t0, listens, sels: Access.stats.sels, cycles: Access.stats.cycles, helpRequested: S.helpReq || undefined, errored: errors > 0, typedFirst: firstErr });
        S.helpReq=false; p.log.push(rec); S.trials.push(rec); const session=p.sessions.find(x=>x.id===S.sid);if(session)session.trials=S.trials.length; Store.save();
        Tone.play("ok"); slots.classList.add("right");
        await Voice.feedback(["¡Muy bien!", target.word]); await sleep(Math.max(300, Feedback.gapMs())); resolve(rec);
      } else {
        errors++; if (firstErr === null) firstErr = typed.map(showG).join("");
        clearTimeout(timer);
        if(TaskSupport.mode(p)==='auto'){
          supportBusy=true;
          try{
            if(Feedback.mode()==="voice")await Voice.say("Mira-ho bé.");await Voice.say(target.word);
            typed.length=0;drawSlots();await applyHelp(help<2?2:Math.min(4,help+1));
          }finally{supportBusy=false;}
        }else{slots.classList.add('answer-error');setTimeout(()=>slots.classList.remove('answer-error'),700);}
        schedule();Access.restartAfter();
      }
    }
    S.abortTrial = () => { if (!done) { done = true; clearTimeout(timer); resolve(null); } };
    const presentationSession=S;
    let initialPresentation=true,presentationRun=0;
    S.pauseTrial=()=>{clearTimeout(timer);presentationRun++;supportBusy=false;};
    S.resumeTrial=()=>{if(initialPresentation){Access.suspended=true;present();}else schedule();};
    bindStage(c => Voice.say(c, { volume: 0.7 }),{suspend:true});
    async function present(){
      const version=++presentationRun;supportBusy=true;
      try{await say();}finally{
        if(version===presentationRun){supportBusy=false;
          if(!done&&S===presentationSession&&!S.ended&&!S.paused){initialPresentation=false;t0=Date.now();Access.resumePresentation();schedule();}
        }
      }
    }
    present();
  });
}

/* ----- student controls ----- */
function pauseSession() {
  S.paused = true;S.pauseTrial?.(); Voice.stop(); Tone.play("pause");
  const prevRoot = $("#app"),pausedSession=S,trialStats={...Access.stats};
  const go = h("button", { class: "big-start", "data-sel": "", "data-cue": "Continuar" }, "▶ Continuar");
  const ov = h("div", { class: "overlay", role: "dialog", "aria-label": "Pausa" }, h("div", { class: "reward" }, h("div", { class: "guide" }, S.p.pres.guide || "🐘"), h("div", { class: "speech" }, "Descansamos un poco."), go));
  go._act = () => { ov.remove(); S.paused = false; Tone.play("resume"); Access.bind(prevRoot, { onCue: S.trialCue || (c => Voice.say(c, { volume: 0.7 })) });Access.stats=trialStats;S.resumeTrial?.(); };
  document.body.append(ov);
  Access.bind(ov, { suspend:true,onCue: c => Voice.say(c, { volume: 0.7 }) });
  Voice.say("Descansamos un poco.").finally(()=>{if(S===pausedSession&&S.paused&&ov.isConnected)Access.resumePresentation();});trapDialogFocus(ov,()=>go._act(),go);
}
function askHelp() {
  S.helpReq = true; Tone.play("help");
  const b = h("div", { class: "bubble-help", role: "status" }, "🙋 He pedido ayuda");
  document.body.append(b); setTimeout(() => b.remove(), 7000);
  if(S.onHelp) S.onHelp(); else Voice.say("He pedido ayuda.");
  if (S.trials.length || true) { logChange(S.p, "El alumno ha pedido ayuda durante la sesión.", "alumne"); Store.save(); }
  Access.restartAfter();
}
function openCommunicator() {
  const a = h("a", { href: S.p.pres.commUrl, target: "_blank", rel: "noopener noreferrer", referrerpolicy: "no-referrer" }); document.body.append(a); a.click(); a.remove();
  pauseSession();
}
function abortSession() {
  if (!S || S.ended) return;
  S.ended = true; Voice.stop(); Access.clear();
  const ss = S.p.sessions.find(x => x.id === S.sid); if (ss) { ss.end = Date.now(); ss.how = ss.how || "interrompuda"; }
  applyMastery(S.p); Store.save(); S.abortTrial && S.abortTrial();
}
function endSession(how) {
  if (!S || S.ended) return;
  S.ended = true; Voice.stop(); S.abortTrial && S.abortTrial();
  const p = S.p; const ss = p.sessions.find(x => x.id === S.sid); if (ss) { ss.end = Date.now(); ss.how = how; }
  const news = applyMastery(p); Store.save();
  const readOk = [...new Set(S.trials.filter(t => t.tpl === "T9" && t.ok).map(t => t.word))];
  const again = h("button", { class: "big-start", "data-sel": "", "data-cue": "Otra vez" }, "Otra vez");
  again._act = () => startStudent(p);
  const app = $("#app"); app.replaceChildren();
  const box = h("div", { class: "stage" }, h("div", { class: "stage-main" }, h("div", { class: "reward" },
    h("div", { class: "guide", style: "font-size:6rem" }, p.pres.guide || "🐘"),
    h("div", { class: "speech" }, how === "acabat" ? `De acuerdo, ${p.name}. Lo dejamos aquí.` : `¡Muy bien, ${p.name}!`),
    readOk.length ? h("div", {}, h("p", { class: "muted" }, "Hoy has practicado:"), h("div", { class: "words" }, ...readOk.map(w => h("span", {}, pic(w), w)))) : null,
    news.length ? h("p", {}, "Práctica añadida: ", news.join(", ")) : null,
    again)));
  app.append(box, cornerExit());
  const finishedSession=S;Access.bind(app, { suspend:true,onCue: c => Voice.say(c, { volume: 0.7 }) });
  Tone.play("finish");
  Voice.feedback(how === "acabat" ? "De acuerdo. Lo dejamos aquí." : "¡Muy bien!").finally(()=>{if(S===finishedSession&&S.ended)Access.resumePresentation();});
}

/* ===== Profiles ===== */
const ACTIVE_ACTIVITIES=['t1','t2','t8','t9','t11'];
function normalizeActivities(p){
 const old=p.plan.acts||{};
 const next=Object.fromEntries(ACTIVE_ACTIVITIES.map(key=>[key,old[key]!==false]));
 if(Object.keys(old).length!==ACTIVE_ACTIVITIES.length||ACTIVE_ACTIVITIES.some(key=>old[key]!==next[key])){
  p.plan.acts=next;
  if(Store.data?.profiles?.[p.id]===p)Store.save();
 }
 return p;
}

function newProfile(name, avatar, pwHash) {
  return {
    id: uid(), name, avatar: avatar || pick(AVATARS), pwHash, created: Date.now(), example: false,
    access: { ...ACCESS_DEFAULTS },
    pres: { tile: "l", rate: 0.9, volume: 1, sounds: true, nameImages: true, reduceMotion: false, imageStyle: "contour", letterCase: "lower", guideEnabled: true, guideAnimated: true, guide: "🐘", commUrl: "", showAcabar: true, showAjuda: true },
    plan: { learned: [], acts: { t1: true, t2: true, t8: true, t9: true, t11: true }, trials: 12, crit: 0.8, options: 4, excluded: [] },
    state: { sRead: 3, known: { read: [], write: [] } },
    log: [], sessions: [], changes: [],
  };
}
const profiles = () => Object.values(Store.data.profiles).sort((a, b) => (b.example ? -1 : 0) - (a.example ? -1 : 0) || a.name.localeCompare(b.name));

// Example profile with simulated data (clearly labelled), so adults can see every screen before using a real profile.
function buildExample() {
  const p = newProfile("Pau", "🦁", null); p.example = true;
  p.plan.learned = ["a", "s", "l", "o", "m", "e"];
  const day = 864e5, now = Date.now(); let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const readable = WORDS.filter(w => w.g.every(g => p.plan.learned.includes(g)) && EMOJI[w.word]);
  const rates = [0.35, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.85];
  rates.forEach((r, si) => {
    const sid = "ex" + si, t = now - (rates.length - si) * 2 * day;
    p.sessions.push({ id: sid, start: t, end: t + 14 * 60e3, mode: "auto", trials: 0, how: "complet" });
    const push = (o) => { p.log.push({ id: uid(), sid, t: t + p.log.length * 1000, access: "auto", itemVer: 1, valid: true, listens: 0, rt: 4000 + rnd() * 6000, ...o }); };
    for (let k = 0; k < 6; k++) {
      const ok = k < Math.round(r * 6), hl = ok ? 0 : 2 + Math.floor(rnd() * 3);
      push({ tpl: "T8", ex: "E8.1", skill: "lletra", target: "r", kind: "nova", ok, indep: ok, help: "A" + (ok ? 0 : hl), err: ok ? null : "ERR-LLETRA", answer: ok ? "r" : pick(["l", "m"]) });
    }
    for (let k = 0; k < 4; k++) {
      const w = readable[Math.floor(rnd() * readable.length)]; const ok = rnd() < r + 0.05; const s = si < 3 ? 2 : si < 6 ? 1 : 0;
      const err = ok ? null : (rnd() < 0.6 ? "ERR-FIN" : "ERR-INI");
      push({ tpl: "T9", ex: s ? "E9.1" : "E9.2", skill: "lectura", target: w.word, word: w.word, s: "S" + s, kind: "ensenyament", ok, indep: ok && s === 0, help: ok ? "A0" : "A2", err });
    }
    push({ tpl: "T2", ex: "E4.1", skill: "rima", target: "sí", kind: "ensenyament", ok: rnd() < 0.8, indep: true, help: "A0" });
    p.sessions[si].trials = p.log.filter(x => x.sid === sid).length;
  });
  p.state.sRead = 0;
  applyMastery(p);
  p.changes.push({ t: now - 16 * day, what: "Perfil de exploración creado sin datos de aprendizaje simulados.", who: "auto" });
  return p;
}

/* ===== Navigation ===== */
const clearOverlays = () => document.querySelectorAll(".overlay, .bubble-help").forEach(x => x.remove());
let CUR = null; // profile open in the adult zone
function showStart() {
  S = null; CUR = null; clearOverlays(); Voice.stop(); Access.clear(); Access.setConfig({ mode: "direct" });
  document.documentElement.style.removeProperty("--tile"); document.body.classList.remove("reduce-motion");
  const app = $("#app"); app.replaceChildren();
  const list = h("div", { class: "profiles" }, ...profiles().map(p => {
    const c = h("button", { class: "pcard", type: "button" }, h("span", { class: "av" }, p.avatar), h("b", {}, p.name), p.example ? h("span", { class: "tag" }, "perfil de exploración") : h("span", { class: "muted" }, p.sessions.length ? "Última sesión: " + fmtDate(p.sessions[p.sessions.length - 1].start) : "Todavía sin sesiones"));
    c.onclick = () => adultGate(p, null); return c;
  }), (() => { const c = h("button", { class: "pcard", type: "button" }, h("span", { class: "av" }, "＋"), h("b", {}, "Crea un perfil"), h("span", { class: "muted" }, "para un alumno nuevo")); c.onclick = createProfileForm; return c; })());
  app.append(h("div", { class: "wrap adult stack" },
    h("header", {}, h("div", { class: "brand" }, "LECAA", h("small", {}, "Lectura y escritura para alumnos que usan CAA"))),
    h("p", {}, "Elige el perfil del alumno. Cualquier adulto que conozca la contraseña puede gestionarlo."),
    list,
    !Store.ok ? h("p", { class: "note" }, "Este navegador no permite guardar datos. Las sesiones no se conservarán al cerrar la página.") : null,
    h("p", { class: "muted", style: "font-size:14px" }, "Los datos se guardan solo en este navegador y dispositivo. Haz copias desde Opciones avanzadas › Datos."),
  ));
}
function createProfileForm() {
  const app = $("#app"); app.replaceChildren();
  let av = AVATARS[0];
  const name = h("input", { type: "text", maxlength: 40, autocomplete: "off" });
  const pw = h("input", { type: "password", autocomplete: "new-password" });
  const pw2 = h("input", { type: "password", autocomplete: "new-password" });
  const err = h("p", { class: "note", hidden: true });
  const avs = h("div", { class: "row" }, ...AVATARS.map((a,i) => { const b = h("button", { type: "button", class: "btn ghost", "aria-label":"Emblema "+(i+1), "aria-pressed": a === av ? "true" : "false", style: "width:64px;height:64px;padding:4px" }, avatarImage(a)); b.onclick = () => { av = a; avs.querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b ? "true" : "false")); avs.querySelectorAll("button").forEach(x => x.style.background = x === b ? "var(--focus-soft)" : ""); }; return b; }));
  avs.firstChild.style.background = "var(--focus-soft)";
  const form = h("form", { class: "card stack" },
    h("label", { class: "f" }, "Nombre del alumno", name),
    h("div", { class: "f" }, h("b", { style: "font-size:14px" }, "Imagen del perfil"), avs),
    h("label", { class: "f" }, "Contraseña para la zona de adulto", h("span", { class: "h" }, "Mínimo 4 caracteres. Compártela entre los adultos que acompañan al alumno."), pw),
    h("label", { class: "f" }, "Repite la contraseña", pw2),
    err,
    h("div", { class: "row" }, h("button", { class: "btn", type: "submit" }, "Crea el perfil"), (() => { const b = h("button", { class: "btn ghost", type: "button" }, "Cancela"); b.onclick = showStart; return b; })()));
  form.addEventListener("submit", async ev => {
    ev.preventDefault();
    const n = name.value.trim();
    const bad = !n ? "Escribe el nombre." : pw.value.length < 4 ? "La contraseña debe tener al menos 4 caracteres." : pw.value !== pw2.value ? "Las contraseñas no coinciden." : null;
    if (bad) { err.textContent = bad; err.hidden = false; return; }
    const p = newProfile(n, av, await hashPw(pw.value));
    logChange(p, "Perfil creado.");
    Store.data.profiles[p.id] = p; Store.save();
    await Media.loadProfile(p.id);
    CUR = p; adultHome(p, "plan");
  });
  app.append(h("div", { class: "wrap adult stack" }, h("header", {}, h("h1", {}, "Perfil nuevo")), form,
    h("p", { class: "muted" }, "Después de crearlo, indica qué correspondencias tiene activadas el alumno (Plan) y cómo accede (Acceso).")));
  name.focus();
}
function trapDialogFocus(ov,close,initial){
 const opener=document.activeElement;ov.setAttribute('aria-modal','true');
 ov.addEventListener('keydown',ev=>{
  if(ev.key==='Escape'){ev.preventDefault();ev.stopPropagation();close();if(opener?.isConnected)opener.focus();return;}
  if(ev.key!=='Tab')return;
  const items=[...ov.querySelectorAll('button,input,select,a[href],[tabindex="0"]')].filter(e=>!e.disabled&&e.offsetParent!==null),first=items[0],last=items.at(-1);
  if(ev.shiftKey&&document.activeElement===first){ev.preventDefault();last?.focus();}
  else if(!ev.shiftKey&&document.activeElement===last){ev.preventDefault();first?.focus();}
 });
 initial?.focus();
}
// Password gate for the adult zone (also reached from the student stage with the 3-second corner hold).
function adultGate(p, onEnter) {
  if (!p) return showStart();
  const pw = h("input", { type: "password", autocomplete: "current-password", "aria-label": "Contraseña" });
  const err = h("p", { class: "note", hidden: true }, "Contraseña incorrecta.");
  const ov = h("div", { class: "overlay", role: "dialog", "aria-modal": "true", "aria-label": "Zona de adulto" });
  const prevRoot = Access.root, prevCue = Access.onCue;
  const close = () => { ov.remove(); if (S && !S.ended && prevRoot) { S.paused = false; Access.bind(prevRoot, { onCue: prevCue });S.resumeTrial?.(); } };
  const enter = async () => {
    ov.remove(); onEnter && onEnter();
    if (Media.pid !== p.id) await Media.loadProfile(p.id);
    CUR = p; adultHome(p);
  };
  const form = h("form", { class: "modal" },
    h("h2", {}, "Zona de adulto · ", p.name),
    p.example ? h("p", { class: "muted" }, "Perfil de exploración: no tiene contraseña.") : h("label", { class: "f" }, "Contraseña", pw),
    err,
    h("div", { class: "row" }, h("button", { class: "btn", type: "submit" }, "Entra"), (() => { const b = h("button", { class: "btn ghost", type: "button" }, S && !S.ended ? "Vuelve a la sesión" : "Cancela"); b.onclick = close; return b; })()));
  form.addEventListener("submit", async ev => {
    ev.preventDefault();
    if (p.example || (await hashPw(pw.value)) === p.pwHash) enter();
    else { err.hidden = false; pw.select(); }
  });
  if (S && !S.ended) { S.paused = true;S.pauseTrial?.(); Voice.stop(); Access.clear(); }
  ov.append(form); document.body.append(ov);
  trapDialogFocus(ov,close,p.example?form.querySelector('button[type="submit"]'):pw);
}

const TABS = [["acc", "Acceso"], ["pres", "Presentación"], ["plan", "Plan"], ["words", "Palabras e imágenes"], ["snd", "Sonidos grabados"], ["data", "Datos"], ["hist", "Historial"]];
function showTab(body, p, tab) {
  if(!['progress',...TABS.map(([key])=>key)].includes(tab))tab='acc';
  body.replaceChildren();
  if (tab === "progress") body.append(progressView(p));
  else {
    const tabs = h("div", { class: "tabs", role: "tablist" }, ...TABS.map(([k, l]) => { const b = h("button", { type: "button", role: "tab", "aria-selected": k === tab ? "true" : "false" }, l); b.onclick = () => showTab(body, p, k); return b; }));
    const view = { acc: accessView, pres: presView, plan: planView, words: wordsView, snd: soundsView, data: dataView, hist: histView }[tab](p, () => showTab(body, p, tab));
    body.append(h("h2", {}, "Opciones avanzadas"), tabs, view);
  }
  body.scrollIntoView({ behavior: "auto", block: "start" });
}
const save = (p, what) => { if (what) logChange(p, what); Store.save(); };

/* ----- Com va? ----- */
function sessionStats(p) {
  return p.sessions.filter(s => s.trials > 0).map(s => {
    const tr = p.log.filter(t => t.sid === s.id && t.valid !== false);
    const nw = tr.filter(t => t.tpl === "T8" && t.kind === "nova");
    const rd = tr.filter(t => t.tpl === "T9");
    return { s, n: tr.length, newN: nw.length, newOk: nw.filter(t => t.indep).length, newTarget: nw[0]?.target, rdN: rd.length, rdOk: rd.filter(t => t.ok).length, all: tr.filter(t => t.indep).length };
  });
}
function chartSVG(points, crit) {
  const W = 640, H = 220, L = 36, R = 34, T = 12, B = 30, n = points.length;
  const x = i => L + (n <= 1 ? (W - L - R) / 2 : i * (W - L - R) / (n - 1)), y = v => T + (1 - v) * (H - T - B);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Porcentaje de aciertos independientes por sesión">`;
  for (const v of [0, 0.5, 1]) s += `<line class="axis" x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v * 100}%</text>`;
  s += `<line class="crit" x1="${L}" x2="${W - R}" y1="${y(crit)}" y2="${y(crit)}"/><text x="${L + 6}" y="${y(crit) - 5}">criteri ${pct(crit)}</text>`;
  const pts = points.filter(p => p.v != null);
  if (pts.length > 1) s += `<polyline class="ln" points="${pts.map(p => x(p.i) + "," + y(p.v)).join(" ")}"/>`;
  for (const p of pts) s += `<circle class="pt" cx="${x(p.i)}" cy="${y(p.v)}" r="5"><title>LECAA CAST · 0.6.5</title></circle>`;
  points.forEach(p => { s += `<text x="${x(p.i)}" y="${H - 10}" text-anchor="middle">${p.label}</text>`; });
  return s + "</svg>";
}
function hypotheses(p) {
  const sids = p.sessions.slice(-3).map(s => s.id);
  const tr = p.log.filter(t => sids.includes(t.sid) && t.valid !== false);
  const c = k => tr.filter(t => t.err === k).length;
  const out = [];
  const rd = tr.filter(t => t.tpl === "T9");
  if (c("ERR-FIN") >= 3 && c("ERR-FIN") > c("ERR-INI")) out.push(["Se han registrado elecciones que difieren en el final de la palabra.", "En las últimas sesiones, en " + c("ERR-FIN") + " errores de lectura, la imagen elegida solo se diferenciaba por el final. Revisa las respuestas y observa cómo usa el apoyo A2, que resalta las letras."]);
  if (c("ERR-INI") >= 3 && c("ERR-INI") >= c("ERR-FIN")) out.push(["Se han registrado elecciones que difieren en la primera letra.", c("ERR-INI") + " errores de lectura, la imagen elegida solo cambiaba la primera letra."]);
  if (c("ERR-MED") >= 3) out.push(["Se han registrado elecciones que difieren en una letra central.", c("ERR-MED") + " errores con una diferencia solo en una letra central."]);
  const lt = tr.filter(t => t.err === "ERR-LLETRA");
  if (lt.length >= 3) { const conf = {}; lt.forEach(t => { if (t.answer) conf[t.answer] = (conf[t.answer] || 0) + 1; }); const top = Object.entries(conf).sort((a, b) => b[1] - a[1])[0]; if (top && top[1] >= 2) out.push([`Se han registrado elecciones de «${showG(top[0])}» ante «${showG(lt[0].target)}».`, `Ha elegido «${showG(top[0])}» ${top[1]} veces cuando se pedía «${showG(lt[0].target)}».`]); }
  const helped = tr.filter(t => t.help && t.help !== "A0").length;
  if (tr.length >= 10 && helped / tr.length > 0.5) out.push(["Se ha utilizado ayuda en parte de los ítems.", `Ha utilizado ayuda en el ${pct(helped / tr.length)} de los ítems. Revisa el ritmo de barrido o el tiempo de fijación y observa el acceso antes de cambiar el plan.`]);
  if (rd.length >= 6 && rd.every(t => t.ok)) out.push(["Las lecturas recientes registradas se han resuelto correctamente.", "Todas las lecturas recientes han sido correctas."]);
  return out;
}
function progressView(p) {
  const st = sessionStats(p), cur = currentLetter(p);
  const curSessions = cur ? letterSessions(p, cur) : [];
  const pts = st.slice(-10).map((x, i) => ({ i, label: fmtDate(x.s.start), v: x.newN ? x.newOk / x.newN : null }));
  const known = p.state.known || { read: [], write: [] };
  const last = p.sessions[p.sessions.length - 1];
  const helpDist = ["A0", "A1", "A2", "A3", "A4"].map(a => [a, p.log.filter(t => t.help === a).length]);
  const tot = helpDist.reduce((a, b) => a + b[1], 0) || 1;
  const hyp = hypotheses(p);
  const sum = h("div", { class: "grid2" },
    h("div", { class: "card stack" }, h("h3", {}, "Correspondencias"),
      h("p", {}, cur ? h("span", {}, "Ahora trabaja ", h("b", { style: "font-family:var(--font-learn);font-size:1.3rem" }, "«" + showG(cur) + "»"), `. Últimas sesiones con esta correspondencia: ${curSessions.slice(-2).map(s => pct(s.ok / s.n)).join(" y ") || "ninguna todavía"} de aciertos independientes (criterio: ${pct(p.plan.crit)} en dos sesiones).`) : "Tiene activada toda la secuencia de correspondencias."),
      h("div", { class: "letters" }, ...LETTER_ORDER.map(g => h("span", { class: "tag" + (p.plan.learned.includes(g) ? " ok" : g === cur ? "" : ""), style: g === cur || p.plan.learned.includes(g) ? "" : "background:var(--bg);color:var(--muted)" }, showG(g) + (g === "c·" || g === "g·" ? " (e,i)" : ""))))),
    h("div", { class: "card stack" }, h("h3", {}, "Palabras"),
      h("p", {}, `Palabras resueltas en lectura: ${known.read.length}. Palabras resueltas en construcción: ${known.write.length}. (Aciertos independientes en dos sesiones distintas, dentro de las condiciones practicadas.)`),
      known.read.length ? h("p", { style: "font-family:var(--font-learn);font-size:1.15rem" }, known.read.join(" · ")) : null,
      h("p", { class: "muted" }, `El apoyo se registra por palabra y condición. Consulta o cambia cada apoyo en el Plan.`)),
    h("div", { class: "card stack" }, h("h3", {}, "Sesiones"),
      h("p", {}, `${p.sessions.length} sesiones. Última: ${last ? fmtDateTime(last.start) : "ninguna"}.`),
      h("p", {}, "Ayuda utilizada en todos los ítems:"),
      h("div", { class: "stack", style: "gap:4px" }, ...helpDist.map(([a, n]) => h("div", { class: "row", style: "gap:8px;flex-wrap:nowrap" }, h("span", { style: "width:28px" }, a), h("span", { style: `height:12px;border-radius:6px;background:var(--accent);width:${Math.max(2, n / tot * 100)}%` }), h("span", { class: "muted", style: "font-size:13px" }, n)))),
      h("p", { class: "muted", style: "font-size:13px" }, "A0 sin ayuda · A1 repetición neutra · A2 pista · A3 menos opciones · A4 modelo. Se conserva toda la secuencia de ayudas; una repetición neutra A1 no invalida por sí sola la independencia."))
  );
  return h("div", { class: "stack" },
    h("h2", {}, "¿Cómo va?"),
    p.example ? h("p", { class: "note" }, "Este perfil permite explorar la aplicación. No contiene resultados de aprendizaje simulados.") : null,
    sum,
    h("div", { class: "card chart" }, h("h3", {}, "Aciertos independientes con la correspondencia nueva, por sesión"), pts.length ? h("div", { html: chartSVG(pts, p.plan.crit) }) : h("p", { class: "muted" }, "Todavía no hay sesiones.")),
    h("div", { class: "card stack" }, h("h3", {}, "Observaciones para revisar"),
      hyp.length ? h("div", { class: "stack" }, ...hyp.map(([a, b]) => h("div", {}, h("b", {}, a), h("p", { class: "muted", style: "margin:2px 0 0" }, b)))) : h("p", { class: "muted" }, "No hay observaciones destacadas en las tres últimas sesiones."),
      h("p", { class: "muted", style: "font-size:13px" }, "Son observaciones de las respuestas registradas, no diagnósticos ni explicaciones causales. Observa al alumno y su acceso antes de cambiar el plan.")),
    h("div", { class: "card" }, h("h3", {}, "Sesiones recientes"), h("div", { class: "tablewrap" }, h("table", {},
      h("thead", {}, h("tr", {}, h("th", {}, "Fecha"), h("th", {}, "Ítems"), h("th", {}, "Correspondencia nueva"), h("th", {}, "Lectura"), h("th", {}, "Acceso"), h("th", {}, "Final"))),
      h("tbody", {}, ...st.slice(-12).reverse().map(x => h("tr", {}, h("td", {}, fmtDateTime(x.s.start)), h("td", {}, x.n), h("td", {}, x.newN ? `${x.newOk}/${x.newN} «${showG(x.newTarget)}»` : "–"), h("td", {}, x.rdN ? `${x.rdOk}/${x.rdN}` : "–"), h("td", {}, (MODE_NAMES[x.s.mode] || "").split(" ")[0] + " " + ((MODE_NAMES[x.s.mode] || "").split(" ")[1] || "")), h("td", {}, x.s.how || "–"))))))),
  );
}

/* ----- form helpers ----- */
function field(label, input, help) { return h("label", { class: "f" }, label, help ? h("span", { class: "h" }, help) : null, input); }
function num(val, min, max, step, onchange) { const i = h("input", { type: "number", min, max, step, value: val }); i.onchange = () => { const v = Math.min(max, Math.max(min, parseFloat(i.value) || min)); i.value = v; onchange(v); }; return i; }
function sel(val, opts, onchange) { const s = h("select", {}, ...opts.map(([v, l]) => h("option", { value: v, selected: String(v) === String(val) }, l))); s.onchange = () => onchange(s.value); return s; }
function chk(label, val, onchange) { const i = h("input", { type: "checkbox", checked: !!val }); i.onchange = () => onchange(i.checked); i.style.flex = "none"; return h("label", { class: "row", style: "gap:8px;font-weight:400;flex-wrap:nowrap;align-items:flex-start" }, i, h("span", { style: "min-width:0" }, label)); }

/* ----- Accés ----- */
function accessView(p, rerender) {
  const a = p.access;
  const set = (k, v, txt) => { a[k] = v; save(p, `Acceso: ${txt || k} → ${v}`); };
  const m = a.mode, scan = ["auto", "step1", "step2"].includes(m);
  const keyName = k => k === " " ? "Espacio" : k;
  const keyInput = (k) => { const b = h("button", { class: "btn ghost small", type: "button" }, keyName(a[k])); b.onclick = () => { b.textContent = "Pulsa el pulsador…"; const f = ev => { ev.preventDefault(); ev.stopPropagation(); document.removeEventListener("keydown", f, true); set(k, ev.key, k === "key1" ? "tecla del pulsador 1" : "tecla del pulsador 2"); b.textContent = keyName(ev.key); }; document.addEventListener("keydown", f, true); }; return b; };
  const parts = [
    field("Cómo accede el alumno", sel(m, Object.entries(MODE_NAMES), v => { set("mode", v, "mode"); rerender(); })),
  ];
  if (m === "dwell") parts.push(field("Tiempo de fijación (segundos)", num(a.dwell, 0.3, 5, 0.1, v => set("dwell", v, "tiempo de fijación")), "Cuánto tiempo debe mirar un elemento para seleccionarlo."));
  if (scan) {
    parts.push(field("Velocidad: segundos por elemento", num(a.interval, 0.5, 10, 0.1, v => set("interval", v, "intervalo de barrido"))));
    parts.push(field("Tiempo extra en el primer elemento (segundos)", num(a.firstExtra, 0, 5, 0.1, v => set("firstExtra", v, "tiempo extra en el primer elemento"))));
    if (m === "auto") parts.push(field("Vueltas antes de detenerse", num(a.cycles, 1, 6, 1, v => set("cycles", v, "voltes")), "Si no pulsa, el barrido se detiene y se reanuda con una nueva pulsación."));
    if (m === "step1") parts.push(field("Selección automática después de (segundos)", num(a.autoSelect, 0.5, 10, 0.1, v => set("autoSelect", v, "selección automática")), "Con un solo pulsador paso a paso: pulsar avanza; si se espera, se selecciona."));
    parts.push(field("Duración mínima de la pulsación (segundos)", num(a.minPress, 0, 2, 0.05, v => set("minPress", v, "duración mínima")), "0 = cualquier pulsación. Útil si hay pulsaciones accidentales breves."));
    parts.push(field("Tiempo sin aceptar pulsaciones después de una pulsación (segundos)", num(a.lockout, 0, 3, 0.05, v => set("lockout", v, "bloqueo entre pulsaciones")), "Evita pulsaciones dobles."));
    parts.push(h("div", { class: "row" }, h("span", {}, "Tecla del pulsador 1:"), keyInput("key1"), m === "step2" ? h("span", {}, "Pulsador 2 (seleccionar):") : null, m === "step2" ? keyInput("key2") : null));
    parts.push(chk("Un clic o toque en la pantalla también cuenta como pulsador (clic derecho = pulsador 2)", a.clickAsSwitch, v => set("clickAsSwitch", v, "clic como pulsador")));
    parts.push(chk("Pista auditiva al enfocar cada elemento", a.cueAudio, v => set("cueAudio", v, "pista auditiva")));
  }
  if (m === "dwellswitch") parts.push(h("div", { class: "row" }, h("span", {}, "Tecla del pulsador:"), keyInput("key1")));
  if (m !== "direct") parts.push(field("Pausa después de seleccionar (segundos)", num(a.postSelect, 0.2, 5, 0.1, v => set("postSelect", v, "pausa después de seleccionar")), "Tiempo durante el que no se puede volver a seleccionar nada."));
  // Try-out area
  const tryBox = h("div", { class: "card stack" }, h("h3", {}, "Prueba"), h("p", { class: "muted" }, "Prueba aquí la configuración antes de empezar una sesión."));
  const out = h("p", { "aria-live": "polite" }, " ");
  const area = h("div", { class: "answers", style: "--tile:6rem" }, ...["🍎", "🚗", "🐄"].map((e, i) => { const t = h("button", { class: "tile", "data-sel": "", "data-cue": ["manzana", "coche", "vaca"][i] }, h("span", { class: "pic" }, e)); t._act = () => { out.textContent = "Seleccionado: " + ["manzana", "coche", "vaca"][i]; Access.restartAfter(); }; return t; }));
  const go = h("button", { class: "btn", type: "button" }, "Activa la prueba"); go.onclick = () => { Access.setConfig(a); Access.bind(area, { onCue: c => a.cueAudio && Voice.say(c, { volume: 0.7 }) }); out.textContent = scan ? "Utiliza el pulsador (" + keyName(a.key1) + ")." : "Selecciona una imagen."; };
  tryBox.append(go, area, out);
  return h("div", { class: "grid2" }, h("div", { class: "card stack" }, ...parts,
    h("p", { class: "muted", style: "font-size:13px" }, "Los valores predeterminados son orientativos y no están validados con alumnos. Ajústalos observando al alumno.")), tryBox);
}

/* ----- Presentació ----- */
function presView(p, rerender) {
  const s = p.pres;
  const set = (k, v, txt) => { s[k] = v; save(p, `Presentación: ${txt} → ${v}`); };
  const name = h("input", { type: "text", value: p.name }); name.onchange = () => { if (name.value.trim()) { p.name = name.value.trim(); save(p, "Nombre cambiado"); } };
  return h("div", { class: "grid2" },
    h("div", { class: "card stack" },
      field("Nombre", name),
      field("Imagen del perfil", sel(p.avatar, AVATARS.map((a,i) => [a, "Emblema "+(i+1)]), v => { p.avatar = v; save(p, "Imagen del perfil"); })),
      field("Tamaño de las imágenes y letras", sel(s.tile || "l", [["m", "Mediana"], ["l", "Grande"], ["xl", "Muy grande"]], v => set("tile", v, "mida"))),
      field("Personaje guía", sel(s.guide, GUIDES.map(g => [g[0], g[0] + " " + g[1]]), v => set("guide", v, "guia")), "Si el guía representa una palabra del corpus, esa palabra no aparece en las actividades mientras sea el guía."),
      field("Velocidad de la voz", sel(s.rate, [[0.7, "Lenta"], [0.9, "Normal"], [1.1, "Rápida"]], v => set("rate", +v, "velocidad de la voz"))),
      field("Volumen", sel(s.volume, [[0.5, "Bajo"], [0.8, "Mitjà"], [1, "Alto"]], v => set("volume", +v, "volum")))),
    h("div", { class: "card stack" },
      chk("Decir el nombre de cada imagen antes de responder", s.nameImages !== false, v => set("nameImages", v, "decir el nombre de las imágenes")),
      chk("Sonidos de acierto", s.sounds !== false, v => set("sounds", v, "sons")),
      chk("Reducir movimiento y animaciones", s.reduceMotion, v => set("reduceMotion", v, "reducir movimiento")),
      chk("Mostrar el botón «Terminar» al alumno", s.showAcabar !== false, v => set("showAcabar", v, "botón acabar")),
      chk("Mostrar el botón «Ayuda» al alumno", s.showAjuda !== false, v => set("showAjuda", v, "botón ayuda")),
      (() => { const i = h("input", { type: "url", value: s.commUrl || "", placeholder: "https://…" }); i.onchange = () => set("commUrl", i.value.trim(), "comunicador"); return field("Dirección del comunicador del alumno (opcional)", i, "Si el alumno utiliza un comunicador web, aparecerá un botón «Comunicador» que lo abre en una pestaña nueva y pone la sesión en pausa."); })(),
      h("p", { class: "muted", style: "font-size:13px" }, "El contraste, el zoom y el lector de pantalla se configuran en el sistema operativo del dispositivo.")));
}

/* ----- Pla ----- */
function planView(p, rerender) {
  const pl = p.plan;
  const letters = h("div", { class: "letters" }, ...LETTER_ORDER.map((g, i) => {
    const c = h("input", { type: "checkbox", checked: pl.learned.includes(g) });
    c.onchange = () => {
      // Keep the sequence contiguous: marking a letter marks all earlier ones; unmarking unmarks later ones.
      pl.learned = c.checked ? LETTER_ORDER.slice(0, i + 1).filter(x => pl.learned.includes(x) || LETTER_ORDER.indexOf(x) <= i) : LETTER_ORDER.slice(0, i).filter(x => pl.learned.includes(x));
      save(p, `Plan: correspondencias activadas manualmente (${pl.learned.map(showG).join(" ") || "ninguna"})`); rerender();
    };
    return h("label", { title: GROUP_OF[g] }, c, showG(g) + (g === "c·" || g === "g·" ? "(e,i)" : ""));
  }));
  const acts = [["t8", "Letra y sonido (T8)", "Asociar cada correspondencia con su sonido en el contexto indicado."], ["t9", "Lee y elige (T9)", "Leer una palabra y elegir su imagen entre opciones. Se ofrece cuando sus correspondencias están activadas."], ["t11", "Construye la palabra (T11)", "Construir una palabra con un teclado reducido."], ["t1", "Escucha y elige (T1)", "Conciencia fonológica: qué palabra empieza como…"], ["t2", "Igual o diferente (T2)", "Conciencia fonológica: ¿riman?"]];
  const cur = currentLetter(pl ? p : p);
  return h("div", { class: "stack" },
    h("div", { class: "card stack" }, h("h3", {}, "Correspondencias activadas"),
      h("p", { class: "muted" }, "Siguen la secuencia del programa. La activación permite practicar; no equivale a una evaluación de dominio. Aquí puedes ajustar las correspondencias activadas."),
      letters,
      h("p", {}, cur ? h("span", {}, "Correspondencia nueva que se trabaja: ", h("b", { style: "font-family:var(--font-learn);font-size:1.2rem" }, "«" + showG(cur) + "»")) : "Secuencia completa."),
      h("p", { class: "muted" }, `Con estas correspondencias están disponibles ${readableWords(p).length} palabras del corpus con imagen.`)),
    h("div", { class: "grid2" },
      h("div", { class: "card stack" }, h("h3", {}, "Actividades"), ...acts.map(([k, l, d]) => h("div", {}, chk(h("span", {}, h("b", {}, l), h("br"), h("span", { class: "muted", style: "font-size:13px" }, d)), pl.acts[k], v => { pl.acts[k] = v; save(p, `Plan: ${l} ${v ? "activada" : "desactivada"}`); })))),
      h("div", { class: "card stack" }, h("h3", {}, "Sesión y criterios"),
        field("Ítems por sesión", num(pl.trials, 5, 30, 1, v => { pl.trials = v; save(p, `Plan: ítems por sesión → ${v}`); }), "Incluye 2 ítems de calentamiento y 1 de cierre."),
        field("Opciones por ítem en Letra y sonido", sel(pl.options || 4, [[2, "2"], [3, "3"], [4, "4"]], v => { pl.options = +v; save(p, `Plan: opciones por ítem → ${v}`); })),
        field("Criterio de avance", sel(pl.crit, [[0.7, "70%"], [0.8, "80 % (valor operativo ajustable)"], [0.9, "90%"]], v => { pl.crit = +v; save(p, `Plan: criterio → ${pct(+v)}`); }), "Porcentaje de aciertos independientes en dos sesiones distintas. Es un criterio operativo del programa, no una medida validada de dominio."),
        field("Apoyo de lectura", sel(p.state.sRead ?? 3, [[3, "S3 · lectura modelada"], [2, "S2 · apoyo para cada correspondencia"], [1, "S1 · puede escuchar la palabra"], [0, "S0 · lectura sin apoyo"]], v => { p.state.sRead = +v; save(p, `Plan: apoyo de lectura → S${v}`); }), "Los apoyos se registran por palabra y condición. Se puede modificar el apoyo según las respuestas y la observación del alumno."))));
}

/* ----- Paraules i imatges ----- */
function wordsView(p, rerender) {
  let level = "N1", q = "";
  const grid = h("div", { class: "wordgrid" });
  const fileIn = h("input", { type: "file", accept: "image/*", hidden: true });
  let target = null;
  fileIn.onchange = async () => { const f = fileIn.files[0]; if (!f || !target) return; await Media.put(p.id, "img:" + target, f); save(p, `Imagen propia para «${target}»`); fileIn.value = ""; draw(); };
  const st = wordStats(p);
  const draw = () => {
    const ex = new Set(p.plan.excluded);
    const list = WORDS.filter(w => (q ? w.word.includes(q) : w.level === level));
    grid.replaceChildren(...list.map(w => {
      const up = h("button", { class: "btn ghost small", type: "button" }, Media.urls["img:" + w.word] ? "Cambia" : "Sube una foto"); up.onclick = () => { target = w.word; fileIn.click(); };
      const exc = h("input", { type: "checkbox", checked: !ex.has(w.word), title: "Usar esta palabra" });
      exc.onchange = () => { p.plan.excluded = exc.checked ? p.plan.excluded.filter(x => x !== w.word) : [...p.plan.excluded, w.word]; save(p, `Palabra «${w.word}» ${exc.checked ? "incluida" : "excluida"}`); };
      const s = st[w.word];
      return h("div", { class: "wcell", style: decodable(p, w) ? "" : "opacity:.65" }, h("span", { class: "wp" }, pic(w.word,p) || h("span", { class: "muted", style: "font-size:11px" }, "sin imagen")),
        h("div", { class: "stack", style: "gap:2px;min-width:0" }, h("b", {}, w.word), illustrationStyle(p)==='arasaac'&&!Media.urls["img:"+w.word]?(ARASAAC_WORDS[w.word].source?h("a",{class:"arasaac-word-source",href:ARASAAC_WORDS[w.word].source,target:"_blank",rel:"noopener noreferrer"},"ARASAAC · "+ARASAAC_WORDS[w.word].label):h("span",{class:"arasaac-word-source"},"PNG aportado · "+w.word)):null, h("span", { class: "muted" }, w.syl + (s ? ` · ${s.read.size}/2 lect.` : "")), h("div", { class: "row", style: "gap:6px" }, h("label", { class: "row", style: "gap:3px" }, exc, "usar"), up),
          Media.urls["img:" + w.word] ? (() => { const d = h("button", { class: "btn danger small", type: "button" }, "Quita"); d.onclick = async () => { await Media.del(p.id, "img:" + w.word); save(p, `Imagen propia de «${w.word}» eliminada`); draw(); }; return d; })() : null));
    }));
  };
  const lv = sel(level, LEVELS.map(l => [l, l + " · " + (CORPUS.find(c => c[1] === l) ? "" : "") + WORDS.filter(w => w.level === l).length + " palabras"]), v => { level = v; draw(); });
  const search = h("input", { type: "text", placeholder: "Busca una palabra" }); search.oninput = () => { q = search.value.trim().toLowerCase(); draw(); };
  draw();
  return h("div", { class: "stack" },
    h("p", { class: "note" }, "El vocabulario incluye tres estilos: Sencillas, Detalladas y ARASAAC. Elige el estilo en Presentación. Puedes añadir fotografías propias para personalizar palabras concretas; estas tienen prioridad sobre la colección."),
    h("div", { class: "row" }, h("div", { style: "flex:1;min-width:180px" }, field("Nivel", lv)), h("div", { style: "flex:1;min-width:180px" }, field("Busca", search))),
    h("p", { class: "muted", style: "font-size:13px" }, "Las palabras más claras son las que están disponibles con las correspondencias activadas."),
    grid, fileIn);
}

/* ----- Sons gravats ----- */
function soundsView(p, rerender) {
  const fileIn = h("input", { type: "file", accept: "audio/*", hidden: true }); let target = null;
  fileIn.onchange = async () => { const f = fileIn.files[0]; if (!f || !target) return; await Media.put(p.id, "rec:" + target, f); save(p, `Sonido grabado para «${target.replace("so:", "")}»`); fileIn.value = ""; rerender(); };
  const row = (k, label, hint) => {
    const has = Voice.hasRec(k);
    const up = h("button", { class: "btn ghost small", type: "button" }, has ? "Cambia" : "Sube audio"); up.onclick = () => { target = k; fileIn.click(); };
    return h("tr", {}, h("td", { style: "font-family:var(--font-learn);font-size:1.3rem" }, label), h("td", { class: "muted" }, hint),
      h("td", {}, has ? h("span", { class: "tag ok" }, Media.urls["rec:"+k] ? "personalitzat" : "incorporat") : h("span", { class: "tag warn" }, "sin grabación")),
      h("td", {}, h("div", { class: "row", style: "gap:6px" }, has ? h("button", { class: "btn ghost small", type: "button", "aria-label":"Escucha el sonido de "+label, onclick: () => {Voice.stop();Voice.playRec(k);} }, "▶") : null, up,
        Media.urls["rec:"+k] ? (() => { const d = h("button", { class: "btn danger small", type: "button" }, "Quita"); d.onclick = async () => { await Media.del(p.id, "rec:" + k); save(p, "Sonido grabado eliminado"); rerender(); }; return d; })() : null)));
  };
  return h("div", { class: "stack" },
    h("p", { class: "note" }, "Las locuciones en castellano, con voz femenina y masculina, están pendientes de producción e incorporación. Cada sonido aislado deberá revisarse fonéticamente. Puedes incorporar grabaciones personalizadas."),
    h("div", { class: "card tablewrap" }, h("table", {}, h("thead", {}, h("tr", {}, h("th", {}, "Letra"), h("th", {}, "Cómo suena"), h("th", {}, "Estado"), h("th", {}, ""))),
      h("tbody", {}, ...LETTER_ORDER.map(g => row("so:" + g, showG(g) + (g === "c·" || g === "g·" ? " (e,i)" : ""), VOWELS.has(g) ? "vocal" : KEYWORD[g] ? "primer sonido de «" + KEYWORD[g] + "»" : FINAL_KEYWORD[g] ? "último sonido de «" + FINAL_KEYWORD[g] + "»" : ""))))),
    fileIn);
}

/* ----- Dades ----- */
function dataView(p, rerender) {
  // change password
  const pw1 = h("input", { type: "password", autocomplete: "new-password" }), pw2 = h("input", { type: "password", autocomplete: "new-password" });
  const pwMsg = h("p", { class: "muted", "aria-live": "polite" });
  const pwBtn = h("button", { class: "btn ghost", type: "button" }, "Cambia la contraseña");
  pwBtn.onclick = async () => { if (pw1.value.length < 4 || pw1.value !== pw2.value) { pwMsg.textContent = "Mínim 4 caràcters i han de coincidir."; return; } p.pwHash = await hashPw(pw1.value); p.example = p.example && false; save(p, "Contraseña cambiada"); pwMsg.textContent = "Contraseña cambiada."; pw1.value = pw2.value = ""; };
  // invalidate a session
  const sessSel = sel("", [["", "Elige una sesión…"], ...p.sessions.slice().reverse().map(s => [s.id, fmtDateTime(s.start) + " · " + (s.trials || 0) + " ítems" + (s.invalid ? " (no válida)" : "")])], () => {});
  const invBtn = h("button", { class: "btn ghost", type: "button" }, "Marca-la com a no vàlida");
  invBtn.onclick = () => { const sid = sessSel.value; const s = p.sessions.find(x => x.id === sid); if (!s) return; s.invalid = true; p.log.forEach(t => { if (t.sid === sid) t.valid = false; }); save(p, `Sesión del ${fmtDateTime(s.start)} marcada como no válida (no cuenta para el progreso)`); rerender(); };
  // delete profile (in-page confirmation)
  const del = h("button", { class: "btn danger", type: "button" }, "Borra este perfil");
  const confirmBox = h("div", { class: "note stack", hidden: true }, h("p", { style: "margin:0" }, `Se borrarán todos los datos de ${p.name} de este dispositivo. No se puede deshacer. Haz antes una copia.`),
    h("div", { class: "row" }, (() => { const b = h("button", { class: "btn danger", type: "button" }, "Sí, bórralo"); b.onclick = async () => { delete Store.data.profiles[p.id]; Store.save(); await Media.removeProfile(p.id); showStart(); }; return b; })(), (() => { const b = h("button", { class: "btn ghost", type: "button" }, "No"); b.onclick = () => confirmBox.hidden = true; return b; })()));
  del.onclick = () => confirmBox.hidden = false;
  return h("div", { class: "grid2" },
    backupProfileCard(p),
    h("div", { class: "card stack" }, h("h3", {}, "Sesión no válida"), h("p", { class: "muted" }, "Si una sesión no refleja la actuación del alumno (malestar, problemas técnicos o la ha realizado otra persona), márcala como no válida para que no cuente para el progreso."), sessSel, invBtn),
    h("div", { class: "card stack" }, h("h3", {}, "Contraseña"), field("Nueva contraseña", pw1), field("Repítela", pw2), pwBtn, pwMsg),
    h("div", { class: "card stack" }, h("h3", {}, "Borrar"), del, confirmBox));
}

/* ----- Historial ----- */
function histView(p) {
  return h("div", { class: "card" }, h("p", { class: "muted" }, "Todos los cambios de configuración y avances automáticos, con su fecha. Permite que los adultos que comparten el perfil sepan qué ha cambiado."),
    p.changes.length ? h("div", { class: "tablewrap" }, h("table", {}, h("tbody", {}, ...p.changes.map(c => h("tr", {}, h("td", { style: "white-space:nowrap" }, fmtDateTime(c.t)), h("td", {}, c.what), h("td", { class: "muted" }, c.who === "auto" ? "aplicación" : c.who === "alumne" ? "alumne" : "adult")))))) : h("p", {}, "Todavía no hay cambios."));
}

