/* ===== Access layer =====
   Every way of accessing turns into three events: focus, select, (cancel).
   Templates only mark selectable elements with data-sel and an optional data-group;
   they never know which access method is active. */
const ACCESS_DEFAULTS = {
  mode: "direct",          // direct | dwell | dwellswitch | auto | step1 | step2
  dwell: 1.0, postSelect: 1.0,
  interval: 2.0, firstExtra: 1.0, cycles: 2, minPress: 0, lockout: 0.3, autoSelect: 2.5,
  key1: " ", key2: "Enter", clickAsSwitch: false, cueAudio: true,
};
const MODE_NAMES = {
  direct: "Selección directa (pantalla táctil, ratón o lector ocular que hace clic)",
  dwell: "Lector ocular con tiempo de fijación",
  dwellswitch: "Mirada para enfocar y pulsador para seleccionar",
  auto: "Barrido automático con un pulsador",
  step1: "Barrido paso a paso con un pulsador",
  step2: "Barrido paso a paso con dos pulsadores",
};
const Access = {
  cfg: { ...ACCESS_DEFAULTS }, root: null, entries: [], level: null, idx: -1, cycle: 0,
  timer: null, locked: false, suspended: false, focusedEl: null, stopped: false, onCue: null, stats: { sels: 0, cycles: 0 },
  keyDownAt: 0, lastPress: 0, dwellT: null, dwellEl: null,
  setConfig(c) { this.cfg = { ...ACCESS_DEFAULTS, ...c }; },
  isScan() { return ["auto", "step1", "step2"].includes(this.cfg.mode); },
  // Build the scan order: ungrouped items one by one, then each data-group as one entry.
  bind(root, opts = {}) {
