 book:'<path d="M3 5c3-1 6-1 9 1v15c-3-2-6-2-9-1V5Zm18 0c-3-1-6-1-9 1v15c3-2 6-2 9-1V5Z"/><path d="M6 9h3M15 9h3M6 12h3M15 12h3"/>',
