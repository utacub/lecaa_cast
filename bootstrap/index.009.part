  cancelDwell() { if (this.dwellT) cancelAnimationFrame(this.dwellT); this.dwellT = null; if (this.dwellEl) this.dwellEl.querySelectorAll(".dwell-ring").forEach(r => r.remove()); this.dwellEl = null; },
