  },
  clear() {
    this.scanEpoch=(this.scanEpoch||0)+1; clearTimeout(this.timer); this.timer = null; this.cancelDwell();
    if (this.focusedEl) this.focusedEl.classList.remove("focused");
    document.querySelectorAll(".group-focused").forEach(x => x.classList.remove("group-focused"));
    this.focusedEl = null; this.root = null; this.entries = []; this.suspended=false;this.pendingWhich=0;
  },
  resumePresentation() {
    if(!this.suspended)return;
    this.suspended=false;
    if(this.isScan())this.startScan(Math.max((this.cfg.interval||2)*1000,Feedback.gapMs()));
  },
  setFocus(e, isGroup) {
