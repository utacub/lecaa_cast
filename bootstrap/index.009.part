    if (isGroup) { (e.box || e.group[0].parentElement).classList.add("group-focused"); if (this.cfg.cueAudio && this.onCue && e.group[0].dataset.groupcue) return this.onCue(e.group[0].dataset.groupcue); return; }
    this.focusedEl = e; e.classList.add("focused");
