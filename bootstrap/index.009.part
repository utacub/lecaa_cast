// Grapheme teaching order from the method (G1-G6). c· and g· are c/g before e, i.
const LETTER_ORDER = ["K01","K02","K03","K04","K05","K06","K07","K08","K09","K10","K11","K12","K13","K14","K15","K16","K17","K18","K19","K20","K21","K22","K23","K24","K25","K26","K27","K28","K29","K30"];
const GROUP_OF = {"K01":"a","K02":"s","K03":"l","K04":"o","K05":"m","K06":"e","K07":"r inicial","K08":"p","K09":"i","K10":"t","K11":"n","K12":"u","K13":"c ante a o u, l o r; coda","K14":"g ante a o u, l o r","K15":"d","K16":"f","K17":"r simple","K18":"rr","K19":"b","K20":"v","K21":"c ante e i","K22":"z","K23":"qu","K24":"j","K25":"g ante e i","K26":"gu davant e i","K27":"ll","K28":"ch","K29":"ñ","K30":"y"};
// How each grapheme is shown and how the consonant sound is cued when no recording exists.
const SHOW = {"K01":"a","K02":"s","K03":"l","K04":"o","K05":"m","K06":"e","K07":"r","K08":"p","K09":"i","K10":"t","K11":"n","K12":"u","K13":"c","K14":"g","K15":"d","K16":"f","K17":"r","K18":"rr","K19":"b","K20":"v","K21":"c","K22":"z","K23":"qu","K24":"j","K25":"g","K26":"gu","K27":"ll","K28":"ch","K29":"ñ","K30":"y"};
const KEYWORD = { s:"sol", l:"lupa", m:"mar", r:"rei", p:"pa", t:"tap", n:"nas", c:"cuc", g:"gat", d:"dit", f:"fum", b:"bou", v:"vaca", "c·":"cel", "g·":"gel", ll:"llum" };
const FINAL_KEYWORD = { ny:"pany", ix:"peix", ig:"raig" };
