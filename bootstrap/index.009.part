// Rhyme families (same sound from the stressed vowel), taken from E4.1 of the method.
const RHYMES = [["gat","plat","blat","prat"],["sol","col","bol"],["pot","got","clot"],["pit","dit","nit","llit","crit"],["mar","bar"],["peu","neu","creu"],["riu","niu"],["cap","tap"],["cuc","suc"],["llum","fum"],["cel","gel","mel"],["nas","vas"],["fill","grill"],["llop","glop"],["pa","gra"]];
// Profile pictures: never a guide character and never a corpus word, so the student does not mix them up.
const AVATARS = ["🐻","🐼","🦁","🐨","🐧","🦄","🦖","🚀","🌈","🎨"];
// Guide characters: [emoji, spoken name, corpus word if the animal is also a corpus word].
// A corpus-word guide is kept out of the activities while it is the guide.
const GUIDES = [["🐘","Elefante",null],["🦔","Erizo","erizo"],["🐿️","Ardilla","ardilla"],["🦫","Castor",null],["🐝","Abeja","abeja"],["🤖","Robot",null],["🦊","Zorro","zorro"],["🐢","Tortuga","tortuga"],["🐙","Pulpo","pulpo"]];
const guideWord = p => guidesEnabled(p) ? (GUIDES.find(g => g[0] === p.pres.guide) || [])[2] || null : null;
const DIGRAPHS = ["l·l","ll","ny","rr","ss","tx","tg"];

function graphemes(w) {
  if(CAST_DATA.corpus[w])return CAST_DATA.corpus[w].units.slice();
  const out = [];
  for (let i = 0; i < w.length;) {
    const rest = w.slice(i);
    const d = DIGRAPHS.find(x => rest.startsWith(x));
    if (d) { out.push(d); i += d.length; continue; }
    const two = rest.slice(0, 2), next = rest[2] || "";
    if ((two === "qu" || two === "gu") && /[eiéèí]/.test(next)) { out.push(two); i += 2; continue; }
    if (two === "ix" && i > 0 && i + 2 === w.length && /[aeou]/.test(w[i - 1])) { out.push("ix"); i += 2; continue; }
    if (two === "ig" && i > 0 && i + 2 === w.length && /[aeou]/.test(w[i - 1])) { out.push("ig"); i += 2; continue; }
    const ch = w[i];
    if ((ch === "c" || ch === "g") && /[eiéèí]/.test(rest[1] || "")) { out.push(ch + "·"); i += 1; continue; }
    out.push(ch); i += 1;
  }
  return out;
}
const showG = g => SHOW[g] || g;
const WORDS = CORPUS.map(([id, level, word, syl]) => ({ id, level, word, syl, g: graphemes(word) }));
const WORD = Object.fromEntries(WORDS.map(w => [w.word, w]));
const LEVELS = ["N1","N2","N3","N4","N5","N6","N7","N8","N9","N10","N11","N12"];

/* ===== Utilities ===== */
const $ = (s, r = document) => r.querySelector(s);
function h(tag, attrs = {}, ...kids) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (v == null || v === false) continue;
    if (k === "class") e.className = v;
    else if (k === "style") e.style.cssText = v;
    else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
    else if (k === "html") e.innerHTML = v;
