 async function present(){
  const run=++epoch;busy=true;Access.locked=true;const ok=()=>live(run);
  try{
   await Voice.say(prompt);if(!ok())return;
   if(it.s===3&&wordNode){
    supportActivated.push({level:3,type:'planned_model'});revealed=true;
    if(!(await castLightUnits(it.stimulusWord.g,unitElements(),it.word,ok))||!ok())return;
    await Voice.say([it.word],{rate:.55});if(!ok())return;
    if(await Voice.waitBetween()){if(!ok())return;await Voice.say([it.word]);}if(!ok())return;
   }
   if(it.nameOptions&&await Voice.waitBetween()){
    for(const t of tiles){if(!ok())return;t.classList.add('hint');try{await Voice.say([t.dataset.cue||t.dataset.v]);}finally{t.classList.remove('hint');}if(!ok())return;if(t!==tiles.at(-1)&&!(await Voice.waitBetween()))return;}
   }
   if(!ok())return;initial=false;t0=Date.now();Access.resumePresentation();
  }finally{preview||=Voice.failureCount!==baseFailures;if(run===epoch){busy=false;Access.locked=false;if(ok())schedule();}}
 }
 present();
});}
