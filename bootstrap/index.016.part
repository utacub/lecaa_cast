};
Voice.speakText=async function(text,opt={}){if(!String(text||'').trim())return false;return this.playRec(String(text),opt);};
Voice.say=async function(parts,opt={}){
 this.stop();this.lastParts=[].concat(parts);const my=this.token,bankVoice=RecordedBank.voice();let spoken=false,paused=false;
 GuideMotion.speech++;
 try{for(const part of this.lastParts){if(my!==this.token)return;if(part&&typeof part==='object'&&part.pause){await sleep(Math.max(part.pause,Feedback.gapMs()));paused=true;continue;}if(spoken&&!paused){await sleep(Feedback.gapMs());if(my!==this.token)return;}paused=false;const key=typeof part==='string'?part:part?.rec;if(key)spoken=(await this.playRec(key,{...opt,bankVoice}))||spoken;}}
 finally{GuideMotion.speech=Math.max(0,GuideMotion.speech-1);}
