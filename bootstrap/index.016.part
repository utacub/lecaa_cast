progressView=function(p){const valid=p.log.filter(t=>t.valid!==false&&!t.familiarization),pending=p.log.filter(t=>t.valid===false),st=wordStats(p),read=Object.keys(st).filter(w=>readMastered(st,w)),write=Object.keys(st).filter(w=>writeMastered(st,w));return h('div',{class:'stack'},h('h2',{},'Seguimiento'),h('p',{class:'note'},'Indicadores de las tareas y condiciones utilizadas. No equivalen a lectura generalizada ni a escritura libre.'),h('div',{class:'grid2'},h('div',{class:'card stack'},h('h3',{},'Oportunidades'),h('p',{},valid.length+' actividades válidas · '+pending.length+' exploraciones o cierres sin respuesta excluidos de los indicadores.')),h('div',{class:'card stack'},h('h3',{},'Primeras respuestas'),h('p',{},valid.filter(t=>t.firstCorrect??t.ok).length+' correctas · '+valid.filter(t=>t.indep).length+' sin pista.')),h('div',{class:'card stack'},h('h3',{},'Palabras resueltas en dos sesiones'),h('p',{},'Lectura en T9: '+read.length),h('p',{},read.join(' · ')||'Todavía ninguna.'),h('p',{},'Construcción en T11: '+write.length),h('p',{},write.join(' · ')||'Todavía ninguna.'))),h('div',{class:'card tablewrap'},h('table',{},h('thead',{},h('tr',{},...['Actividad','Oportunidades válidas','Primer intento correcto','Sin pista'].map(t=>h('th',{},t)))),h('tbody',{},...['T8','T9','T11','T1','T2'].map(t=>{const a=valid.filter(r=>r.tpl===t);return h('tr',{},h('td',{},t),h('td',{},a.length),h('td',{},a.filter(r=>r.firstCorrect??r.ok).length),h('td',{},a.filter(r=>r.indep).length));})))),h('details',{class:'card'},h('summary',{},'Últimas actividades y condiciones'),...p.log.slice(-30).reverse().map(r=>h('p',{},`${fmtDateTime(r.t)} · ${r.tpl} · ${r.word||showG(r.target)} · ${r.valid===false?'excluida: '+r.invalidReason:r.indep?'primer intento sin pista':r.firstCorrect?'primer intento correcto · apoyo disponible '+(r.s||'A0')+' · activado '+(r.supportActivated?.map(x=>'S'+x.level).join(', ')||'ninguno'):'primer intento incorrecto'} · ${r.helpHistory?.map(x=>'A'+x).join(' → ')||'sin ayuda A'}`,r.valid===false?null:h('button',{class:'btn ghost small',onclick:()=>{r.valid=false;r.indep=false;r.invalidReason='adult_accidental_selection';r.events??=[];r.events.push({type:'adult_invalidation',at:Date.now()});if(r.word){const support=castSupport(p,r.word);support.pending=null;support.success=support.errors=0;}save(p,'Actividad invalidada por selección accidental: '+r.id);adultHome(p,'progress');}},'Excluir selección accidental')))));};
const castStart=showStart;showStart=function(){S=null;document.getElementById('speech-unavailable')?.remove();castStart();};
const castEnd=endSession; /* Session endings retain the translated v45.1 lifecycle. */


/* CAST 0.6.1: complete negative-rhyme feedback supplied by the user. */
const castNegativeFeedback={"id":"ui.rhyme_no_feedback","category":"ui","text":"Muy bien, no riman.","delivery":"natural","language":"es-ES","status":"available","reviewNote":"Locución completa aportada por el usuario el 22 de octubre de 2026. Sin recortes ni montaje.","voices":{"female":{"src":"data:audio/mpeg;base64,","start":0,"end":2.324898,"approved":true,"status":"available_imported","version":"cast-audio-20261022-b15250ecf97c4fe7","baseVersionRequired":true,"importSource":{"file":"LECAA_CAST_locucio_femenina_pendent.mp3","sha256":"b15250ecf97c4fe71e49ef923d8de75ad181f984476b7728415eb95b4765aafa","wholeFile":true,"text":"Muy bien, no riman.","start":0,"end":2.324898}}}};
CAST_AUDIO.entries.push(castNegativeFeedback);CastAudio.entries.set(castNegativeFeedback.id,castNegativeFeedback);CastAudio.index.set(RecordedBank.norm(castNegativeFeedback.text),castNegativeFeedback.id);
const auditNewProfile=newProfile;newProfile=(...args)=>{const p=auditNewProfile(...args);p.pres.auditMechanicsVersion=6;return p;};
const auditStartStudent=startStudent;
startStudent=function(p){if(p.pres.recordedVoice!=='female'){p.pres.recordedVoice='female';save(p,'Voz sintética femenina de ElevenLabs.');}return auditStartStudent(p);};

const auditPresView=presView;presView=function(p,rerender){const v=auditPresView(p,rerender);const labels=[...v.querySelectorAll('label.f')],timing=labels.find(l=>l.firstChild?.textContent==='Tiempo de espera')?.querySelector('select'),seconds=labels.find(l=>l.firstChild?.textContent==='Espera mínima en modo fijo (segundos)')?.querySelector('input');if(timing)timing.disabled=TaskSupport.mode(p)==='manual';if(seconds)seconds.disabled=TaskSupport.mode(p)==='manual'||p.pres.supportTiming!=='fixed';return v;};
const castMechanicsLoad=Store.load.bind(Store);
Store.load=function(){const result=castMechanicsLoad();let changed=false;for(const p of Object.values(this.data.profiles||{})){if(p.programme==='LECAA-CAST'&&(p.pres.auditMechanicsVersion||0)<6){const explicit=(p.changes||[]).some(c=>/feedbackMode|^Feedback:/.test(c.what||''));if(p.pres.feedbackMode==='bell'&&!explicit)p.pres.feedbackMode='voice';p.state.sRead=p.state.defaultReadSupport??p.state.sRead??3;p.pres.auditMechanicsVersion=6;p.pres.castMechanicsVersion=6;logChange(p,'CAST 0.6: mecánica revisada con LECAA v45.1. Se conservan los ajustes explícitos y el historial.','auto');changed=true;}}if(changed)this.save();return result;};


/* CAST 0.6.2: one synthetic female voice; legacy profile choices remain usable. */
const femaleOnlyLoad=Store.load.bind(Store);
Store.load=function(){const result=femaleOnlyLoad();let changed=false;for(const p of Object.values(this.data.profiles||{})){if(p.programme==='LECAA-CAST'&&p.pres.recordedVoice!=='female'){p.pres.recordedVoice='female';logChange(p,'Voz sintética femenina de ElevenLabs.','auto');changed=true;}}if(changed)this.save();return result;};
const femaleOnlyRestore=LocalBackups.profile.bind(LocalBackups);
LocalBackups.profile=function(value){const p=femaleOnlyRestore(value);p.pres.recordedVoice='female';return p;};
CAST_AUDIO.counts.entries=CAST_AUDIO.entries.length;
CAST_AUDIO.counts.byCategory=Object.fromEntries([...new Set(CAST_AUDIO.entries.map(e=>e.category))].map(c=>[c,CAST_AUDIO.entries.filter(e=>e.category===c).length]));
CAST_AUDIO.counts.entryVoiceSlots=CAST_AUDIO.entries.length;
CAST_AUDIO.counts.derivedVoiceSlots=CAST_AUDIO.derivedClips.length;

/* ===== Boot ===== */
(async function boot() {
  Store.load();
  // Guides and profile pictures changed (2026-10-12): move old choices to valid ones.
  for (const p of Object.values(Store.data.profiles)) { normalizeActivities(p);p.pres.letterCase=exerciseLetterCase(p);if(typeof p.pres.guideEnabled!=='boolean')p.pres.guideEnabled=true;if(typeof p.pres.guideAnimated!=='boolean')p.pres.guideAnimated=true; if (!['contour','matte','arasaac'].includes(p.pres.imageStyle)) p.pres.imageStyle = 'contour'; if (!GUIDES.some(g => g[0] === p.pres.guide)) p.pres.guide = GUIDES[0][0]; if (!AVATARS.includes(p.avatar)) p.avatar = AVATARS[0]; }
  if (!Object.values(Store.data.profiles).some(p => p.example)) { const ex = buildExample(); Store.data.profiles[ex.id] = ex; Store.save(); }
  Store.save();
  Voice.init();
  await Media.open();
  showStart();
})();

</script>

<script>
/* PWA shell only. Exercise mechanics and embedded media are unchanged from 0.6.3. */
(() => {
  if (!('serviceWorker' in navigator) || !/^https?:$/.test(location.protocol)) return;
  let prompt = null, status = 'Preparando el uso sin conexión… La primera descarga incluye todas las imágenes y los audios (unos 97 MB).', failed = false;
  const render = () => {
    const host = document.querySelector('.launch-inner');
    if (!host) return;
    let panel = host.querySelector('.pwa-tools');
    if (!panel) {
      panel = document.createElement('section'); panel.className = 'pwa-tools'; panel.setAttribute('aria-label', 'Instalación y uso sin conexión');
      const install = document.createElement('button'); install.type = 'button'; install.className = 'btn ghost small'; install.dataset.pwaInstall = ''; install.textContent = 'Instalar LECAA CAST';
      install.onclick = async () => { const event = prompt; if (!event) return; prompt = null; render(); await event.prompt(); await event.userChoice; };
      const message = document.createElement('p'); message.dataset.pwaStatus = ''; message.setAttribute('role', 'status');
      const retry = document.createElement('button'); retry.type = 'button'; retry.className = 'btn ghost small'; retry.dataset.pwaRetry = ''; retry.textContent = 'Reintentar descarga'; retry.onclick = register;
      const details = document.createElement('details'); const summary = document.createElement('summary'); summary.textContent = 'Cómo instalar y usar sin conexión';
      const help = document.createElement('p'); help.textContent = 'En Chrome o Edge, usa «Instalar LECAA CAST» o la opción de instalación del navegador. En iPhone o iPad, abre esta página en Safari y elige Compartir › Añadir a la pantalla de inicio (activa «Abrir como app web» si aparece). Espera al mensaje «Lista para usar sin conexión» antes de desconectarte. Los perfiles y las sesiones se guardan solo en este navegador y dispositivo; conserva tus copias de seguridad. Una instalación en otro navegador no transfiere los perfiles.';
      details.append(summary, help); panel.append(install, message, retry, details); host.append(panel);
    }
    panel.querySelector('[data-pwa-install]').hidden = !prompt || matchMedia('(display-mode: standalone)').matches;
    panel.querySelector('[data-pwa-status]').textContent = status;
    panel.querySelector('[data-pwa-retry]').hidden = !failed;
  };
  const ready = async () => {
    const reg = await navigator.serviceWorker.ready;
    const channel = new MessageChannel();
    channel.port1.onmessage = e => {
      if (e.data?.type === 'LECAA_CAST_READY') { status = 'Lista para usar sin conexión: imágenes y audios incluidos.'; failed = false; render(); }
    };
    reg.active?.postMessage({type:'LECAA_CAST_STATUS'}, [channel.port2]);
  };
  async function register() {
    failed = false; status = 'Preparando el uso sin conexión… La primera descarga incluye todas las imágenes y los audios (unos 97 MB).'; render();
    try {
      const reg = await navigator.serviceWorker.register('/lecaa_cast/sw.js', {scope:'/lecaa_cast/', updateViaCache:'none'});
      const watch = () => {
        const worker = reg.installing;
        worker?.addEventListener('statechange', () => {
          if (worker.state === 'redundant') { failed = true; status = 'No se ha completado la descarga sin conexión. Mantén la conexión y vuelve a intentarlo. Puedes seguir usando LECAA CAST online.'; render(); }
          if (worker.state === 'installed' && navigator.serviceWorker.controller) { status = 'Nueva versión descargada. Cierra todas las ventanas de LECAA CAST y vuelve a abrir la aplicación para actualizarla.'; render(); }
        });
      };
      watch(); reg.addEventListener('updatefound', watch);
      if (reg.waiting) { status = 'Nueva versión descargada. Cierra todas las ventanas de LECAA CAST y vuelve a abrir la aplicación para actualizarla.'; render(); }
      else ready().catch(() => {});
    } catch (e) { failed = true; status = 'No se ha podido preparar el uso sin conexión. Puedes seguir usando LECAA CAST online; comprueba la conexión y el espacio disponible.'; render(); }
  }
  window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); prompt = e; render(); });
  window.addEventListener('appinstalled', () => { prompt = null; render(); });
  navigator.serviceWorker.addEventListener('controllerchange', () => ready().catch(() => {}));
  // Home only: never add controls to the student stage or modify scanning targets.
  const original = showStart;
  showStart = function(...args) { const result = original.apply(this, args); render(); return result; };
  render(); register();
})();

</script>
</body></html>
