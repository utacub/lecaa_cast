 voices(){return ['female'];}
};
for(const e of CAST_AUDIO.entries)if(['word','ui','initial_prompt','write_prompt','rhyme_prompt','initial_feedback','guide'].includes(e.category))CastAudio.index.set(RecordedBank.norm(e.text),e.id);
for(const e of CAST_AUDIO.entries)if(e.delivery==='natural')if(!CastAudio.index.has(RecordedBank.norm(e.text)))CastAudio.index.set(RecordedBank.norm(e.text),e.id);
for(const [text,id]of Object.entries({'Empezamos':'ui.start','¡Hola! Empezamos a leer y escribir.':'ui.welcome','Pide ayuda':'ui.help','Terminar':'ui.end','Escucha la palabra':'ui.listen','Opciones de respuesta':'ui.options'}))CastAudio.index.set(RecordedBank.norm(text),id);
RecordedBank.voice=function(){const v=CastAudio.voices();return v.length===2?v[Voice.bankTurn++%2]:v[0];};
Voice.failureCount=0;Voice.init=()=>{};Voice.getCatalanVoices=()=>[];Voice.hasSynth=()=>false;
Voice.reportMissing=function(key){this.failureCount++;this.missingSpeech.add(String(key));let note=document.getElementById('speech-unavailable');if(!note){note=h('p',{id:'speech-unavailable',class:'note',role:'status',style:'position:fixed;bottom:8px;left:16px;right:16px;z-index:100;font-size:14px;pointer-events:none'});document.body.append(note);}note.textContent='Vista de revisión · locuciones pendientes. Esta actividad no genera resultados de aprendizaje válidos.';};
Voice.hasRec=key=>{const id=CastAudio.resolve(key);return !!id&&CastAudio.voices().every(v=>!!CastAudio.clip(id,v));};
Voice.playRec=async function(key,opt={}){
 const id=CastAudio.resolve(key),voice=opt.bankVoice||RecordedBank.voice(),clip=id&&CastAudio.clip(id,voice),token=this.token;S?.recordAudio?.({id:id||null,key,voice,status:clip?'available':'pending',version:clip?.version||RecordedBank.profile()?.pres?.castAudioReview?.[voice+':'+id]?.version||CastAudio.entries.get(id)?.voices[voice]?.version||null,start:clip?.start??null,end:Number.isFinite(clip?.end)?clip.end:null});
 if(!clip){this.reportMissing(key);return false;}
 if(id.startsWith('slow.')){const unitCount=WORD[CastAudio.entries.get(id).word]?.g.length,segments=clip.highlightSegments;let last=-Infinity;const covered=new Set();const aligned=Array.isArray(segments)&&segments.length&&segments.every(s=>{const ok=Number.isFinite(s.start)&&Number.isFinite(s.end)&&s.start>=last&&s.end>s.start&&Array.isArray(s.unitIndices)&&s.unitIndices.every(i=>Number.isInteger(i)&&i>=0&&i<unitCount);last=s.end;s.unitIndices?.forEach(i=>covered.add(i));return ok;})&&covered.size===unitCount;if(!aligned)this.reportMissing('alignment:'+id);}
