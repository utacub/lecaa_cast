/* Accessible trial lifecycle, planned supports and first-attempt evidence. */
function castClock(expire){let elapsed=0,total=0,last=0,timer=null;return{start(){if(timer)return;last=performance.now();timer=setInterval(()=>{const now=performance.now();if(!Voice.audio&&!S?.paused&&!Access.locked&&!Access.suspended){if(this.ready?.()!==false)elapsed+=now-last;total+=now-last;}last=now;if(elapsed>=this.limit&&this.expireEnabled?.()!==false){this.stop();expire();}},100);},stop(){clearInterval(timer);timer=null;},reset(limit){this.stop();elapsed=0;this.limit=limit;this.start();},get elapsed(){return elapsed;},get total(){return total;},limit:30000};}
function castScanFloor(p){return ['auto','step1','step2'].includes(p.access.mode)?(Access.entries.length+1)*(p.access.interval||2)*1000:0;}
async function castReadConnected(word,node){const spans=node?[...node.querySelectorAll('[data-gi]')]:[],id='slow.'+WORD[word].id;const timer=setInterval(()=>{const active=Voice.castPlaying;let indices=[];if(active?.id===id&&Voice.audio)indices=(active.clip.highlightSegments||[]).filter(s=>Voice.audio.currentTime>=s.start&&Voice.audio.currentTime<s.end).flatMap(s=>s.unitIndices);spans.forEach((s,i)=>s.classList.toggle('lit',indices.includes(i)));},40);try{await Voice.say([{rec:'cast:slow:'+word},word]);}finally{clearInterval(timer);spans.forEach(s=>s.classList.remove('lit'));}}
/* CAST 0.4: interaction mechanics ported from LECAA v45.1.
   The Spanish item banks, images and embedded recordings are unchanged. */
function castUnitKey(units,index,word=null){
 const exact=word&&CAST_DATA.corpus[word];
 let phone=exact?.unitPhones[index],g=units[index],next=units[index+1]||'';
 if(!phone){
  phone=({c:/^[ei]/.test(next)?'θ':'k',g:/^[ei]/.test(next)?'x':'g',qu:'k',gu:'g',j:'x',z:'θ',v:'b',ll:'ʝ',y:'ʝ',ch:'tʃ',ñ:'ɲ',rr:'r',r:index===0||/[nls]$/.test(units[index-1]||'')?'r':'ɾ'})[g]||g;
 }
