,field('Velocidad de la voz',sel(s.rate??.9,[[.7,'Lenta'],[.9,'Normal'],[1.1,'Rápida']],v=>set('rate',+v))),chk('Sonidos de selección y ayuda',s.sounds!==false,v=>set('sounds',v)),field('Confirmación',sel(s.feedbackMode||'voice',[['bell','Campana'],['voice','Locución'],['visual','Solo visual']],v=>set('feedbackMode',v))),field('Pausa entre locuciones (segundos)',num(s.speechGap??1,0,5,.25,v=>set('speechGap',v))),field('Repetición y ayuda',sel(s.supportMode||'auto',[['manual','Manual'],['repeat','Repetición automática'],['auto','Ayudas automáticas graduadas']],v=>{set('supportMode',v);rerender();})),field('Tiempo de espera',sel(s.supportTiming||'adaptive',[['adaptive','Adaptado al acceso y al historial'],['fixed','Mínimo fijado por el adulto']],v=>{set('supportTiming',v);rerender();})),field('Espera mínima en modo fijo (segundos)',num(s.supportWaitSeconds??30,5,3600,1,v=>set('supportWaitSeconds',v)),'Comienza tras la presentación completa. La espera se adapta al acceso y a las respuestas anteriores, como en LECAA v45.1.'),chk('Nombrar las cuatro imágenes de T9 antes de responder',s.nameImages!==false,v=>set('nameImages',v)),chk('Reducir transiciones',s.reduceMotion,v=>set('reduceMotion',v)),chk('Mostrar «Acabar»',s.showAcabar!==false,v=>set('showAcabar',v)),chk('Mostrar «Ayuda»',s.showAjuda!==false,v=>set('showAjuda',v)),(()=>{const i=h('input',{type:'url',value:s.commUrl||'',placeholder:'https://…'});i.onchange=()=>set('commUrl',i.value.trim());return field('Comunicador web',i);})()));};
soundsView=function(p,rerender){let query='',voice='female';const list=h('div',{class:'stack'}),q=h('input',{type:'search',placeholder:'Buscar por texto o identificador'}),draw=()=>{const entries=CAST_AUDIO.entries.filter(e=>(e.id+' '+e.text).toLowerCase().includes(query)).slice(0,60);list.replaceChildren(...entries.map(e=>{const id=voice+':'+e.id,review=p.pres.castAudioReview?.[id],upload=h('input',{type:'file',accept:'audio/*'});upload.onchange=async()=>{if(!upload.files[0])return;const stored=await Media.put(p.id,'rec:cast:'+voice+':'+e.id,upload.files[0]);if(!stored){list.prepend(h('p',{class:'note',role:'alert'},'No se ha podido guardar el audio. Revisa el espacio disponible y vuelve a intentarlo.'));return;}p.pres.castAudioReview??={};p.pres.castAudioReview[id]={approved:false,version:Date.now(),start:0,end:null,highlightSegments:null};save(p,'Audio incorporado: '+id);draw();};const play=h('button',{class:'btn ghost small',onclick:async()=>{const src=Media.urls['rec:cast:'+voice+':'+e.id]||e.voices[voice].src;if(src){Voice.stop();const a=new Audio(src);a.volume=p.pres.volume??1;Voice.audio=a;a.onended=()=>{if(Voice.audio===a)Voice.audio=null;};await a.play().catch(()=>{});}}},'Escuchar');return h('div',{class:'card stack'},h('b',{},e.text),h('code',{},e.id),e.reviewNote?h('p',{class:'muted'},e.reviewNote):e.voices[voice]?.origin?h('p',{class:'muted'},'Fonema sintético compartido con LECAA en catalán. Grabación conservada sin modificar.'):null,h('div',{class:'row'},upload,play),chk('Grabación revisada y aprobada',review?.approved??e.voices[voice].approved,v=>{p.pres.castAudioReview??={};p.pres.castAudioReview[id]={...review,approved:v,baseVersion:e.voices[voice]?.version};save(p,'Revisión de audio '+id);}),e.delivery==='slow_connected'?h('p',{class:'muted'},'Este modelo necesita además la alineación temporal real de todas las unidades; el archivo de planificación contiene el esquema.'):null);}));};q.oninput=()=>{query=q.value.toLowerCase();draw();};const downlo