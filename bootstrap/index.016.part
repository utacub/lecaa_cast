 body.append(h('header',{class:'guide-introduction'},h('p',{class:'guide-kicker'},'UTAC · '+GUIDE_DOCUMENT.updated),h('h3',{},"Aprender a leer y escribir con CAA"),h('p',{},"Una guía para situar LECAA CAST dentro de una enseñanza más amplia y consultar los fundamentos de las actividades. Puedes abrir cada apartado por separado."),h('div',{class:'guide-evidence-key'},h('span',{class:'caa'},"Evidencia con CAA"),h('span',{class:'altres'},"Evidencia de otras poblaciones"))),h('div',{class:'guide-layout'},index,h('article',{class:'guide-article','aria-label':"Contenido de la guía"},...sections,refs)));
