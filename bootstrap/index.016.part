 ses.pauseTrial=()=>{event('pause');stop();epoch++;busy=false;typedReading=false;LetterHighlights.clear();};
 ses.resumeTrial=()=>{event('resume');if(!current())return;if(initial){interrupted=null;Access.suspended=true;present();}else if(interrupted){const action=interrupted;interrupted=null;perform(action).then(restart);}else restart();};
