 const para=text=>h('p',{},...guideInline(text,goToReference));
 const block=data=>{
  if(data.type==='p')return para(data.text);
  if(data.type==='heading')return h('h4',{},data.text);
  if(data.type==='list')return h('ul',{},...data.items.map(text=>h('li',{},...guideInline(text,goToReference))));
  if(data.type==='evidence')return h('div',{class:'guide-evidence '+data.kind,'data-evidence':data.kind},h('p',{class:'guide-evidence-label'},data.kind==='caa'?"Evidencia con personas que utilizan CAA":"Evidencia procedente de otras poblaciones"),h('h5',{},data.title),...data.paragraphs.map(para));
  if(data.type==='table')return h('div',{class:'guide-table-scroll',tabindex:'0','aria-label':"Pauta de observación y revisión del acceso"},h('table',{},h('thead',{},h('tr',{},...data.head.map(text=>h('th',{scope:'col'},text)))),h('tbody',{},...data.rows.map(row=>h('tr',{},...row.map(text=>h('td',{},text)))))));
  return null;
 };
 const descriptions={comencar:"Una niña pequeña en silla de ruedas mira un monitor orientado hacia ella con el apoyo de un maestro.",abast:"Libro ilustrado, letras móviles, lápiz y tablero de comunicación sobre una mesa.",evidencia:"Un niño pequeño selecciona un pictograma en una cuadrícula extensa mientras una profesional toma notas.",activitats:"Letras móviles para construir la palabra sol junto a una imagen y un pulsador.",acces:"Dos alumnos responden con selección directa y un pulsador en una actividad compartida.",'mes-enlla':"Dos niños pequeños participan en lectura compartida con un adulto y un cuaderno de comunicación con muchas casillas.",llengues:"Libros, letras, un globo terráqueo y materiales de comunicación.",limits:"Libros, un cuaderno de observación y una lupa representan la consulta y revisión de fuentes."};
