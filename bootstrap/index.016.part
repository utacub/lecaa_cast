 body.append(h('div',{class:'about-layout'},h('div',{class:'about-copy'},h('p',{class:'guide-kicker'},"Lectura · Escritura · Comunicación"),h('h3',{},"Un recurso más para aprender el código escrito"),...GUIDE_DOCUMENT.about.map(text=>h('p',{},text)),openGuide),guideFigure('about',"Dos niños de cinco a siete años comparten un cuento con una maestra y un cuaderno de comunicación con una cuadrícula extensa.")));
}
function guideReferenceEntry(r){
 const title='publisher' in r?h('em',{},r.title):r.title;
 const publication='publisher' in r?['. '+r.publisher+'. ']:['. ',h('em',{},r.journal),r.publication.startsWith("Publicación")?'. ':', ',...guidePublication(r.publication),'. '];
 return h('li',{id:'guide-ref-'+r.id,tabindex:'-1','data-reference-id':r.id},r.authors+' ('+r.year+'). ',title,...publication,creditLink(r.url,r.url));
}
function guidePublication(text){
