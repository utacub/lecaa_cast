async function castLightUnits(units,elements,word=null,live=()=>true){
 Voice.stop();LetterHighlights.clear();
 const owner=++LetterHighlights.sequence,token=Voice.token,bankVoice=RecordedBank.voice();
 GuideMotion.speech++;
 try{
  for(let i=0;i<Math.min(units.length,elements.length);i++){
   if(!live()||token!==Voice.token||!elements[i].isConnected)return false;
   LetterHighlights.mark(elements[i],owner);
   await Voice.playRec(castUnitKey(units,i,word),{bankVoice});
   if(!live()||token!==Voice.token)return false;
   if(i<units.length-1&&!(await Voice.waitBetween()))return false;
  }
  return true;
 }finally{LetterHighlights.clear(owner);GuideMotion.speech=Math.max(0,GuideMotion.speech-1);}
}
function castTrial(it,writing){return new Promise(resolve=>{
 const ses=S,p=ses.p,baseFailures=Voice.failureCount,started=Date.now();
