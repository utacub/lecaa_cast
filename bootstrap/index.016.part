/* Spanish speech plus explicitly mapped shared female phonemes from Catalan v45.1. */
RecordedBank.norm=t=>String(t).normalize('NFC').toLocaleLowerCase('es').replace(/[’‘]/g,"'").replace(/[¡!¿?.,:;«»]/g,'').replace(/\s+/g,' ').trim();
const CastAudio={
 entries:new Map(CAST_AUDIO.entries.map(e=>[e.id,e])),derived:new Map(CAST_AUDIO.derivedClips.map(e=>[e.id,e])),index:new Map(),
 resolve(key){
  if(this.entries.has(key)||this.derived.has(key))return key;
  if(key==='cast:tap-context')return 'phoneme.ɾ';
  if(key.startsWith('cast:phoneme:'))return 'phoneme.'+key.slice(13);
  if(key.startsWith('cast:letter-name:'))return 'letter.'+key.slice(17);
  for(const [prefix,category] of [['cast:initial:','initial_model.'],['cast:slow:','slow.'],['cast:rhyme:','rhyme_model.']])if(key.startsWith(prefix)){const w=key.slice(prefix.length),id=category+WORD[w]?.id;return this.entries.has(id)?id:'word.'+WORD[w]?.id;}
  if(key.startsWith('cast:context:')){const x=key.slice(13).split(':'),i=Number(x.pop()),w=x.join(':');return CAST_AUDIO.taskMap.T9[w]?.units[i]?.clips[0];}
  if(key.startsWith('cast:syllable:')){const x=key.slice(14).split(':'),i=Number(x.pop()),w=x.join(':');return 'syllable.'+WORD[w]?.id+'.'+(i+1);}
  return this.index.get(RecordedBank.norm(key));
 },
 clip(id,voice,p=RecordedBank.profile()){
  const e=this.entries.get(id),review=p?.pres?.castAudioReview?.[voice+':'+id];
  if(e){const v=e.voices[voice],custom=Media.urls['rec:cast:'+voice+':'+id],r=custom||!v?.baseVersionRequired||review?.baseVersion===v?.version?review:null,src=custom||v?.src;if(!src||!(r?.approved??v?.approved))return null;return{src,start:r?.start??v?.start??0,end:r?.end??v?.end??Infinity,highlightSegments:r?.highlightSegments??v?.highlightSegments,version:r?.version||v?.version};}
  const d=this.derived.get(id),a=p?.pres?.castAlignments?.[voice+':'+id]||d?.voices[voice];
  if(!d||!a?.approved||!Number.isFinite(a.start)||!Number.isFinite(a.end)||a.start<0||a.end<=a.start)return null;
