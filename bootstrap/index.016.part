 const events=[],event=(type,details={})=>events.push({type,at:Date.now(),...details}),helpHistory=[],supportActivated=[],typed=[],tiles=[],keys=writing?it.keys.slice():[],nodes=[],prompt=writing?[`Escribe ${it.word}.`]:it.prompt;
 const current=()=>!done&&S===ses&&!ses.ended;
