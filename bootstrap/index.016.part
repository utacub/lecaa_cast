 function record(administrative=false){const firstCorrect=first?.correct===true;return{id:uid(),sid:ses.sid,t:started,tpl:it.tpl,ex:it.ex,skill:it.skill,target:it.target,word:it.word||null,kind:it.kind,s:it.s==null?null:'S'+it.s,options:writing?keys.slice():it.options.map(o=>o.value),access:p.access.mode,answer:first?.answer??null,finalAnswer:lastAnswer,ok:firstCorrect&&(writing||help<4),firstCorrect,indep:firstCorrect&&!revealed&&help===0&&(it.s==null||it.s===0),help:'A'+help,helpHistory:helpHistory.slice(),events,revealed,err:first&&!first.correct?(writing?'ERR-ESCR':it.tpl==='T8'?'ERR-LLETRA':it.tpl==='T9'?errorCode(it.correct,first.answer):'ERR-'+it.tpl):null,rt:t0?Date.now()-t0:0,listens,sels:Access.stats.sels,cycles:Access.stats.cycles,errored:errors>0,autoReviewUsed,helpRequested:ses.helpReq||undefined,supportAvailable:it.s??null,supportActivated,valid:!administrative&&!preview&&Voice.failureCount===baseFailures,invalidReason:administrative?'session_interrupted':preview||Voice.failureCount!==baseFailures?'audio_pending':null,administrative};}
 async function finish(){
  if(!current())return;done=true;stop();epoch++;Access.suspended=true;Access.scanEpoch=(Access.scanEpoch||0)+1;clearTimeout(Access.timer);Access.cancelDwell();const rec=record();ses.helpReq=false;if(it.tpl==='T9'&&it.kind!=='repaso'&&rec.valid){const st=ses.s;if(rec.ok&&help===0){st.streak++;st.errs=0;if(st.streak>=3&&p.state.sRead>0){p.state.sRead--;st.streak=0;}}else{st.errs++;st.streak=0;if(st.errs>=2&&p.state.sRead<3){p.state.sRead++;st.errs=0;}}}castLog(it,rec);GuideMotion.cue(1);
