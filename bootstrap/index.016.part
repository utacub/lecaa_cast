 }
 ses.recordAudio=details=>{if(current())event('audio_clip',details);};
 ses.onListen=async()=>{if(!allowed())return;listens++;GuideMotion.cue(4);await play(prompt);restart();};
 ses.onHelp=async()=>{if(allowed())await support(Math.max(2,Math.min(4,help+1)));};
