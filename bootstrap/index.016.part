 function schedule(){
  stop();if(!current()||ses.paused||busy||initial||TaskSupport.mode(p)==='manual'||(TaskSupport.mode(p)==='auto'&&help>=4))return;
  timer=setTimeout(async()=>{timer=null;if(!current()||TaskSupport.mode(p)==='manual')return;if(ses.paused||busy)return schedule();
   if(TaskSupport.mode(p)==='repeat')await play(prompt);else await support(help+1);
   schedule();
