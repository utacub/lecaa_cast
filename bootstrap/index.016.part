 function restart(){if(current()&&!ses.paused&&!busy){schedule();Access.restartAfter();}}
 if(wordNode){
  it.stimulusWord.g.forEach((g,i)=>{
   const b=h(it.s===2?'button':'span',{class:'g'+(it.s===2?' tile-letter':''),'data-gi':i},showG(g));
   if(it.s===2){b.setAttribute('data-sel','');b.setAttribute('data-group','word');b.setAttribute('aria-label','Sonido '+(i+1));b.style.cssText='border:0;background:none;font:inherit;cursor:pointer;color:inherit';
    b._act=async()=>{if(!allowed())return;listens++;revealed=true;supportActivated.push({level:2,type:'unit_sound',unit:i});await perform(async()=>{b.classList.add('lit');try{await Voice.say([{rec:castUnitKey(it.stimulusWord.g,i,it.word)}]);}finally{b.classList.remove('lit');}});restart();};
   }wordNode.append(b);
  });
  const stim=h('div',{class:'stimulus'},wordNode);
  if(it.s===1){const b=h('button',{class:'ctl','data-sel':'','data-cue':'Escúchala'},icon('listen'),'Escúchala');b._act=async()=>{if(!allowed())return;listens++;revealed=true;supportActivated.push({level:1,type:'whole_word'});await play([it.word],{rate:.7});restart();};stim.append(b);}
  nodes.push(stim);
 }
 if(it.stimulusPics)nodes.push(h('div',{class:'stimulus'},...it.stimulusPics.map(w=>h('div',{class:'stim-pic','aria-label':w},pic(w)))));
 const editAllowed=()=>allowed()||(typedReading&&current()&&!ses.paused&&!Access.suspended);
 function cancelReview(){if(typedReading){epoch++;Voice.stop();LetterHighlights.clear();typedReading=false;busy=false;interrupted=null;}}
 const drawKeys=()=>keysRow.replaceChildren(...keys.map(g=>{
  const b=h('button',{class:'key','data-sel':'','data-group':keys.length>4?'k1':null,'data-v':g,'aria-label':'Letra '+g},showG(g));
  b._act=()=>{if(!editAllowed())return;cancelReview();event('edit',{action:'add',unit:g});typed.push(g);drawSlots();restart();};return b;
 }));
 if(writing){
  slots=h('div',{class:'slots','aria-live':'polite'});keysRow=h('div',{class:'krow','data-groupbox':'k1'});const kb=h('div',{class:'kbd'},keysRow);drawSlots();drawKeys();
  const fn=(label,cue,act)=>{const b=h('button',{class:'key fn','data-sel':'','data-group':'k2','data-cue':cue},label);b._act=act;return b;};
  const actions=h('div',{class:'krow writing-actions','data-groupbox':'k2'},
   fn('⌫ Borrar','Borrar',()=>{if(!editAllowed())return;cancelReview();event('edit',{action:'delete',unit:typed.at(-1)});typed.pop();drawSlots();restart();}),
   fn('👂 Lo que he escrito','Lo que he escrito',async()=>{if(!allowed())return;autoReviewUsed=true;listens++;const snapshot=typed.slice();typedReading=true;const run=epoch;try{await perform(async ok=>{if(!snapshot.length)await Voice.say([{rec:'ui.empty'}]);else await castLightUnits(snapshot,[...slots.children].slice(0,snapshot.length),CAST_DATA.corpus[snapshot.join('')]?snapshot.join(''):null,ok);});}finally{if(run===epoch){typedReading=false;restart();}}}),
   fn('✔ Hecho','Hecho',()=>choose(typed.join(''),null)));
  nodes.push(h('div',{class:'writing-layout'},h('div',{class:'writing-main'},h('div',{class:'stimulus'},h('div',{class:'stim-pic','aria-label':it.word},pic(it.word))),slots,kb),actions));
  if(p.pres.reviewWriting===false)actions.children[1].remove();
 }else{
  const ans=h('div',{class:'answers'});
  it.options.forEach((o,i)=>{const t=h('button',{class:'tile'+(o.cls?' '+o.cls:''),'data-sel':'','data-v':o.value,'aria-label':it.cueOptions?o.cue||o.value:'Opción '+(i+1),'data-cue':it.cueOptions?o.cue||o.value:null},o.node);t._act=()=>choose(o.value,t);tiles.push(t);ans.append(t);});nodes.push(ans);
 }
 nodes.unshift(speechBubble(writing?'Escribe la palabra.':it.promptText));mountStage(nodes,it.tpl);
 async function support(level){
  if(!allowed()||level<1||level>4)return;
  help=Math.max(help,level);if(!helpHistory.includes(level))helpHistory.push(level);if(level>1)revealed=true;
  event('help',{level});GuideMotion.cue(level===1?4:5);
  await perform(async ok=>{
   if(level===1)await Voice.say(prompt);
   if(level===2){
    if(writing){keysRow.querySelector('[data-v="'+CSS.escape(it.w.g[0])+'"]')?.classList.add('hint');await Voice.say(prompt,{rate:.6});}
    else{
     if(it.tpl==='T9'){supportActivated.push({level:2,type:'unit_sequence'});if(!(await castLightUnits(it.stimulusWord.g,unitElements(),it.word,ok)))return;}
     else if(it.tpl==='T8')tiles.find(t=>t.dataset.v===it.correct)?.classList.add('hint');
     else if(it.tpl==='T1')await Voice.say([it.key,{pause:300},it.correct],{rate:.6});
     else if(it.tpl==='T2')await Voice.say([it.pairWords[0],{pause:400},it.pairWords[1]],{rate:.6});
     if(ok())await Voice.say(prompt,{rate:.75});
    }
   }
   if(level===3){
    if(writing){keys.splice(0,keys.length,...new Set(it.w.g));drawKeys();Access.refresh();}
    else{const others=tiles.filter(t=>t.dataset.v!==it.correct),keep=pick(others);others.forEach(t=>{if(t!==keep)t.classList.add('dim');});Access.refresh();await Voice.say(prompt);}
   }
   if(level===4){
    if(writing){const m=h('div',{class:'stim-word cast-write-model'},it.w.g.map(showG).join(''));slots.before(m);try{await Voice.say([{rec:'ui.write_model'},it.word]);if(ok())await sleep(3000);}finally{m.remove();}}
    else{tiles.find(t=>t.dataset.v===it.correct)?.classList.add('model','hint');await Voice.say(['Es esta.',{pause:200},...[].concat(prompt)]);}
