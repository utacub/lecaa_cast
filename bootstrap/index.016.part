itemT9=(p,review)=>{const rows=castRows9(p);if(!rows.length)return null;const st=wordStats(p);let candidates=rows;const un=rows.filter(r=>!readMastered(st,r.w)),mastered=rows.filter(r=>readMastered(st,r.w));if(review&&mastered.length)candidates=mastered;else if(!review&&un.length&&Math.random()<.7)candidates=un;const r=CAST_LEAST(candidates,r=>CAST_USED(p,r.id)),w=WORD[r.w],s=review||TaskSupport.mode(p)!=='auto'?0:(p.state.sRead??3);return {tpl:'T9',ex:s?'E9.1':'E9.2',skill:'lectura',target:r.w,word:r.w,itemId:r.id,variant:r.v?'B':'A',s,kind:review?'repaso':'enseñanza',promptText:'Lee la palabra. ¿Qué imagen es?',prompt:['Lee la palabra. ¿Qué imagen es?'],stimulusWord:w,nameOptions:p.pres.nameImages!==false,options:castOptions([r.w,...r.ds],r.w).map(v=>({value:v,node:pic(v),cue:v})),correct:r.w,firstDistractor:r.ds[0],cueOptions:true,onOk:['Sí.',r.w]};};
itemT1=p=>{const rows=castRows1(p);if(!rows.length)return null;const phones=[...new Set(rows.map(r=>CAST_DATA.corpus[r.m].initial))],phone=CAST_LEAST(phones,ph=>p.log.filter(t=>t.tpl==='T1'&&t.initial===ph&&t.valid!==false).length),phoneRows=rows.filter(r=>CAST_DATA.corpus[r.m].initial===phone),models=[...new Set(phoneRows.map(r=>r.m))],model=CAST_LEAST(models,m=>p.log.filter(t=>t.tpl==='T1'&&t.modelWord===m&&t.valid!==false).length),r=CAST_LEAST(phoneRows.filter(r=>r.m===model),r=>CAST_USED(p,r.id));return {tpl:'T1',ex:'E5.1',skill:'sonido inicial',target:r.w,key:r.m,itemId:r.id,variant:r.v?'B':'A',initial:phone,sameSyllable:CAST_DATA.t1.find(x=>x.m===r.m).sameSyllable[r.v],kind:'enseñanza',promptText:`¿Cuál empieza como ${r.m}?`,prompt:[`¿Cuál empieza como ${r.m}?`],stimulusPics:[r.m],nameOptions:true,options:castOptions([r.w,...r.ds],r.w).map(v=>({value:v,node:pic(v),cue:v})),correct:r.w,firstDistractor:r.ds[0],cueOptions:true,onOk:[`Sí. ${r.w} empieza como ${r.m}.`]};};
itemT2=p=>{let rows=castRows2(p);if(!rows.length)return null;p.state.rhymeCycle??=[];let unused=rows.filter(r=>!p.state.rhymeCycle.includes(r.id));if(!unused.length){p.state.rhymeCycle=[];unused=rows;}const yes=Math.random()<.5,pool=unused.filter(r=>r.yes===yes);rows=pool.length?pool:unused;const familyCounts={};for(const t of p.log)if(t.tpl==='T2'&&t.valid!==false)for(const family of new Set((t.pairWords||[]).map(w=>CAST_DATA.corpus[w].rime)))familyCounts[family]=(familyCounts[family]||0)+1;const r=CAST_LEAST(rows,r=>r.pair.reduce((a,w)=>a+(familyCounts[CAST_DATA.corpus[w].rime]||0),0)),[a,b]=r.pair,conj=CAST_DATA.corpus[b].initial==='i'?'e':'y',q=`¿Riman ${a} ${conj} ${b}?`;return {tpl:'T2',ex:'E4.1',skill:'rima',target:r.yes?'sí':'no',itemId:r.id,variant:r.yes?'P':'N',kind:'enseñanza',promptText:q,prompt:[q],stimulusPics:r.pair,pair:r.pair.join('|'),pairWords:r.pair,options:[{value:'sí',node:h('span',{class:'lbl'},'Sí'),cue:'Sí',cls:'yes'},{value:'no',node:h('span',{class:'lbl'},'No'),cue:'No',cls:'no'}],correct:r.yes?'sí':'no',cueOptions:true,onOk:r.yes?['Sí, riman.',a,b]:[{rec:'ui.rhyme_no_feedback'}]};};
itemT11=p=>{const rows=castRows11(p);if(!rows.length)return null;const st=wordStats(p),un=rows.filter(r=>!writeMastered(st,r.w)),pool=un.length&&Math.random()<.7?un:rows;const r=CAST_LEAST(pool,r=>CAST_USED(p,'CAST2-T11-'+WORD[r.w].id));return {tpl:'T11',ex:'E10.2',skill:'escritura',target:r.w,word:r.w,itemId:'CAST2-T11-'+WORD[r.w].id,w:WORD[r.w],keys:shuffle([...new Set([...WORD[r.w].g,...r.extras])]),kind:'enseñanza'};};
makeItem=function(p, kind) {
  const a = p.plan.acts, L = p.plan.learned, cur = currentLetter(p);
  const can = availableActivities(p);
  let tpl;
  if (kind === "warm" || kind === "close") {
    const opts = [];
    if (can.t8 && L.length) opts.push(["t8r", 3]);
    if (can.t9) opts.push(["t9r", 2]);
    if (can.t2) opts.push(["t2", 1]);
    if (can.t1) opts.push(["t1", 1]);
    if (!opts.length) { if(can.t8)opts.push(["t8",1]);else if(can.t11)opts.push(["t11",1]);else return null; }
    tpl = weightedPick(opts);
  } else {
    const opts = [];
    if (can.t8 && cur) opts.push(["t8", 3]);
    if (can.t8 && L.length >= 2) opts.push(["t8r", 1]);
    if (can.t9) opts.push(["t9", 3]);
    if (can.t11) opts.push(["t11", 2]);
    if (can.t1) opts.push(["t1", 1]);
    if (can.t2) opts.push(["t2", 1]);
    if (!opts.length) return null;
    tpl = weightedPick(opts);
  }
  try {
    if (tpl === "t8") return itemT8(p, cur || pick(L), kind);
    if (tpl === "t8r") return itemT8(p, pick(L.length ? L : [cur]), kind);
    if (tpl === "t9" || tpl === "t9r") return itemT9(p, tpl === "t9r");
    if (tpl === "t11") return itemT11(p);
    if (tpl === "t1") return itemT1(p);
    if (tpl === "t2") return itemT2(p);
  } catch (e) { console.warn(e); }
  return null;
};
runSession=async function() {
  const ses = S; const p = ses.p; const plan = slotPlan(p.plan.trials || 12);
  p.sessions.push({ id: ses.sid, start: ses.start, mode: p.access.mode, device: navigator.platform || "", trials: 0, end: null, how: null });
  Store.save();
  for (let i = 0; i < plan.length && !ses.ended; i++) {
    let item = null;
    if (plan[i] === "work" && ses.requeue.length && Math.random() < 0.5) item = ses.requeue.shift();
    if (!item) item = makeItem(p, plan[i]);
    if (!item) continue;
    const rec = await runItem(item);
    if (!rec || ses.ended) break;
    if (rec.errored && !item.requeued) ses.requeue.push({ ...item, requeued: true });
  }
  while (ses.requeue.length && !ses.ended) { const it = ses.requeue.shift(); const r = await runItem(it); if (!r) break; }
  if (ses.ended) return;
  if (!ses.ended && S === ses) endSession("complet");
};
Object.assign(TaskSupport,{
 mode(p){return ['auto','repeat','manual'].includes(p.pres.supportMode)?p.pres.supportMode:'auto';},
 delay(p,factor=1){const adaptive=waitMs(p)*factor;const value=Number(p.pres.supportWaitSeconds??30);return p.pres.supportTiming==='fixed'&&Number.isFinite(value)?Math.max(adaptive,Math.max(5,Math.min(3600,value))*1000):adaptive;}
});
function castLog(it,rec){const p=S.p;Object.assign(rec,{itemId:it.itemId,variant:it.variant??null,initial:it.initial,modelWord:it.key||null,pairWords:it.pairWords,condition:CAST_CONDITION(p),language:'es-ES',programme:'LECAA-CAST',itemVer:2,contentVersion:'CAST 2.0',appVersion:CAST_VERSION,imageCollection:p.pres.imageStyle,imageVersion:CAST_IMAGE_VERSION,images:[...new Set(CAST_ALL_WORDS(it))].map(word=>({word,collection:Media.urls['img:'+word]?'custom':p.pres.imageStyle,version:Media.urls['img:'+word]?p.pres.customImageVersions?.[word]||'unversioned':CAST_IMAGE_VERSIONS[p.pres.imageStyle]?.[word]})),audioVersion:CAST_AUDIO.schemaVersion,variety:{seseo:!!p.plan.seseo,distinguishesLLY:!!p.plan.distinguishesLLY},sameSyllable:it.sameSyllable??null,corrective:!!it.requeued,familiarization:!!it.familiarization});rec.indep=rec.indep&&rec.valid!==false;if(it.tpl==='T2'&&rec.valid!==false){p.state.rhymeCycle??=[];if(!p.state.rhymeCycle.includes(it.itemId))p.state.rhymeCycle.push(it.itemId);}if(it.tpl==='T9'&&rec.valid!==false){const st=castSupport(p,it.word);if(st.lastSid!==S.sid){st.lastSid=S.sid;if(rec.firstCorrect&&!rec.helpHistory.some(x=>x>1)&&!rec.supportActivated?.some(x=>x.level>st.level)){st.success++;st.errors=0;if(st.success>=3&&st.level>0)st.pending=st.level-1;}else if(!rec.firstCorrect){st.errors++;st.success=0;if(st.errors>=2&&st.level<3)st.pending=st.level+1;}else{st.success=st.errors=0;}}}p.log.push(rec);S.trials.push(rec);const ss=p.sessions.find(x=>x.id===S.sid);if(ss)ss.trials=S.trials.length;Store.save();}
const castNewProfile=newProfile;
newProfile=(...args)=>{const p=castNewProfile(...args);p.programme='LECAA-CAST';p.language='es-ES';Object.assign(p.pres,{recordedVoice:'female',supportMode:'auto',supportWaitSeconds:30,supportTiming:'adaptive',nameImages:true,castMechanicsVersion:6,feedbackMode:'voice',reviewWriting:true});p.state.defaultReadSupport=3;p.state.castSupport={};p.plan.structuralProfiles=['V.CV','CV.CV'];return p;};
buildExample=()=>{const p=newProfile('Ejemplo de exploración',AVATARS[0],null);p.example=true;p.plan.learned=LETTER_ORDER.slice();p.plan.structuralProfiles=[...new Set(CAST_ROWS.map(r=>r.profile))];p.state.defaultReadSupport=0;p.state.sRead=0;p.changes=[{t:Date.now(),what:'Perfil de exploración sin datos de aprendizaje simulados.',who:'auto'}];return p;};
wordStats=function(p) {
  const m = {};
  for (const t of p.log) {
    if (t.valid === false || !t.word) continue;
    const s = m[t.word] = m[t.word] || { read: new Set(), write: new Set(), readTry: 0, writeTry: 0 };
    if (t.tpl === "T9") { s.readTry++; if (t.indep) s.read.add(t.sid); }
    if (t.tpl === "T11") { s.writeTry++; if (t.indep) s.write.add(t.sid); }
  }
  return m;
};
letterSessions=function(p, g) {
  const by = new Map();
  for (const t of p.log) {
    if (t.tpl !== "T8" || t.target !== g || t.valid === false) continue;
    const s = by.get(t.sid) || { n: 0, ok: 0, t: t.t }; s.n++; if (t.indep) s.ok++; by.set(t.sid, s);
  }
  return [...by.values()].sort((a, b) => a.t - b.t);
};
applyMastery=p=>{const news=[],g=currentLetter(p);if(g){const q=letterSessions(p,g).filter(s=>s.n>=4),last=q.slice(-2);if(last.length===2&&last.every(s=>s.ok/s.n>=(p.plan.crit??.8))){p.plan.learned.push(g);news.push('Correspondencia '+showG(g));logChange(p,'Correspondencia '+showG(g)+' resuelta al '+Math.round((p.plan.crit??.8)*100)+'% en dos sesiones, con al menos cuatro oportunidades por sesión.','auto');}}const st=wordStats(p);p.state.known??={read:[],write:[]};for(const w of Object.keys(st))for(const [type,fn]of[['read',readMastered],['write',writeMastered]])if(fn(st,w)&&!p.state.known[type].includes(w)){p.state.known[type].push(w);news.push(w+' · resuelta sin ayuda en dos sesiones');}return news;};
const castRestoreProfile=LocalBackups.profile.bind(LocalBackups);
