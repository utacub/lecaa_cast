WORD_ILLUSTRATIONS.arasaac=Object.fromEntries(Object.entries(ARASAAC_WORDS).map(([word,item])=>[word,ARASAAC_IMAGES[item.id]]));
// All three collections are embedded and available offline.
const ILLUSTRATION_STYLES=[['contour',"Sencillas"],['matte',"Detalladas"],['arasaac','ARASAAC']];
const illustrationStyle=p=>ILLUSTRATION_STYLES.some(([id])=>id===p?.pres?.imageStyle)?p.pres.imageStyle:'contour';
function illustratedWord(word,p=S?.p||CUR){
 const style=illustrationStyle(p),src=WORD_ILLUSTRATIONS[style][word];
 if(!src)return null;
 const attrs={src,alt:word,draggable:'false','data-image-style':style,'data-word':word};
 if(style==='arasaac')attrs['data-arasaac-id']=ARASAAC_WORDS[word].id;
 return h('img',attrs);
}
function pic(word,p=S?.p||CUR){
 const custom=Media.urls['img:'+word];
 if(custom)return h('img',{src:custom,alt:word,draggable:'false','data-image-style':'custom'});
 return illustratedWord(word,p);
}
const PICTURE_CONCEPTS=(()=>{
 const parents={},seen=new Map(),find=w=>parents[w]===w?w:(parents[w]=find(parents[w]));
 for(const word of Object.keys(ARASAAC_WORDS))parents[word]=word;
 for(const[word,item]of Object.entries(ARASAAC_WORDS))for(const key of ['id:'+item.id,'label:'+String(item.label).normalize('NFC').toLocaleLowerCase('ca').trim()]){
  if(seen.has(key))parents[find(word)]=find(seen.get(key));else seen.set(key,word);
 }
 return Object.fromEntries(Object.keys(parents).map(word=>[word,find(word)]));
})();
function pictureKey(word,p){
 const custom=Media.urls['img:'+word];
 if(custom)return custom;
 return 'concept:'+(PICTURE_CONCEPTS[word]||word);
}
function arasaacAttribution(){
 return h('p',{class:'muted arasaac-attribution'},"Pictogramas: Sergio Palao. Propiedad: Gobierno de Aragón. Procedencia: ",h('a',{href:'https://arasaac.org/',target:'_blank',rel:'noopener noreferrer'},'ARASAAC'),". Licencia: ",h('a',{href:'https://arasaac.org/terms-of-use',target:'_blank',rel:'noopener noreferrer'},'CC BY-NC-SA'),". Uso no comercial, reconocimiento de la autoría y distribución de los materiales derivados con la misma licencia.");
}
const illustratedPresentation=presView;
presView=function(p,rerender){
 const view=illustratedPresentation(p,rerender);
 const sampleWords=['vaso','manzana','silla','oso','mesa'];
 const preview=h('div',{class:'image-style-preview','aria-live':'polite'});
 const attribution=arasaacAttribution();
 const equivalents=h('details',{class:'arasaac-equivalents'},h('summary',{},"Correspondencias de los pictogramas revisadas"),h('div',{class:'tablewrap'},h('table',{},h('thead',{},h('tr',{},h('th',{},"Palabra de LECAA CAST"),h('th',{},'Pictograma ARASAAC'))),h('tbody',{},...Object.entries(ARASAAC_EQUIVALENTS).map(([word,item])=>h('tr',{},h('td',{},word),h('td',{},h('a',{href:'https://arasaac.org/pictograms/ca/'+item.id,target:'_blank',rel:'noopener noreferrer'},item.label))))))));
 const refresh=()=>{
  preview.replaceChildren(...sampleWords.map(w=>h('figure',{},illustratedWord(w,p),h('figcaption',{},w))));
  attribution.hidden=equivalents.hidden=illustrationStyle(p)!=='arasaac';
 };
 const choice=sel(illustrationStyle(p),ILLUSTRATION_STYLES,value=>{
  p.pres.imageStyle=value;save(p,"Estilo de las imágenes: "+ILLUSTRATION_STYLES.find(([id])=>id===value)[1]);refresh();
 });
 choice.setAttribute('data-image-style-choice','');
 refresh();
 view.querySelector('.card').prepend(h('section',{class:'image-style-settings'},h('h3',{},"Imágenes de las tareas"),field("Estilo de las imágenes",choice,"Los tres estilos cubren las 300 palabras y funcionan sin conexión. La elección se conserva para este perfil; las fotografías propias tienen prioridad."),preview,attribution,equivalents));
 return view;
};



const CLASSROOM_ART="data:image/webp;base64,";
const GUIDE_CUTOUTS={"🐘":"data:image/webp;base64,","🦔":"data:image/webp;base64,","🐿️":"data:image/webp;base64,","🦫":"data:image/webp;base64,","🐝":"data:image/webp;base64,","🤖":"data:image/webp;base64,","🦊":"data:image/webp;base64,","🐢":"data:image/webp;base64,","🐙":"data:image/webp;base64,"};
function guidesEnabled(p){return p?.pres?.guideEnabled!==false;}
function guidesAnimated(p){return guidesEnabled(p)&&p?.pres?.guideAnimated!==false;}
function guideMode(p){return !guidesEnabled(p)?'none':guidesAnimated(p)?'animated':'static';}
function guideTitle(p){return (GUIDES.find(g=>g[0]===p.pres.guide)||GUIDES[0])[1];}
function guideIntroduction(p){
 const labels={'🐘':"Soy el elefante.",'🦔':"Soy el erizo.",'🐿️':"Soy la ardilla.",'🦫':"Soy el castor.",'🐝':"Soy la abeja.",'🤖':"Soy el robot.",'🦊':"Soy el zorro.",'🐢':"Soy la tortuga.",'🐙':"Soy el pulpo."};
 return labels[p.pres.guide]||labels['🐘'];
}
function guidePortrait(key){
 return h('span',{class:'guide-portrait','aria-hidden':'true'},h('img',{src:GUIDE_CUTOUTS[key]||GUIDE_CUTOUTS['🐘'],alt:'',draggable:'false'}));
}
function guideModeOptions(p,onChange){
 const group=h('div',{class:'guide-mode-options',role:'group','aria-label':"Cómo se muestra el guía"});
 const items=[['animated',"Animado",'play'],['static',"Estático",'book'],['none',"Sin guía",'no']];
 const refresh=()=>{for(const b of group.children)b.setAttribute('aria-pressed',b.dataset.guideMode===guideMode(p)?'true':'false');};
 for(const [value,label,ic]of items){
  const b=h('button',{type:'button','data-guide-mode':value},icon(ic),h('span',{},label));
  b.onclick=()=>{p.pres.guideEnabled=value!=='none';if(value!=='none')p.pres.guideAnimated=value==='animated';save(p,"Guía: "+label.toLocaleLowerCase('ca'));refresh();onChange?.();};group.append(b);
 }
 refresh();return group;
}
function guideSettingsCard(p){
 const grid=h('div',{class:'guide-options redesigned-guide-options','data-guide-picker':''});
 const caption=h('p',{class:'setting-description guide-status','aria-live':'polite'});
 const refresh=()=>{
  const enabled=guidesEnabled(p);grid.setAttribute('aria-disabled',String(!enabled));
  for(const b of grid.children){b.disabled=!enabled;b.setAttribute('aria-pressed',p.pres.guide===b.dataset.guideChoice?'true':'false');}
  caption.textContent=enabled?(guidesAnimated(p)?"El guía acompaña las actividades con sus animaciones.":"El guía se muestra como una imagen estática."):"Las actividades continúan con los enunciados y las locuciones disponibles, sin personaje.";
 };
 for(const [key,name]of GUIDES){
  const b=h('button',{class:'guide-option',type:'button','data-guide-choice':key,'aria-label':name},guidePortrait(key),h('span',{class:'guide-option-label'},name));
  b.onclick=()=>{p.pres.guide=key;save(p,"Guía: "+name);refresh();};grid.append(b);
 }
 const mode=guideModeOptions(p,refresh);refresh();
 return h('section',{class:'card stack guide-settings-card','data-guide-settings':''},h('div',{class:'settings-card-heading'},icon('message'),h('div',{},h('h3',{},"Guía de la sesión"),h('p',{class:'setting-description'},"Elige un personaje y cómo quieres que te acompañe."))),mode,caption,grid,h('p',{class:'setting-footnote'},"El modo animado respeta la preferencia de movimiento reducido del dispositivo y de la aplicación."));
}
function quickSessionSettings(p,onAdvanced){
 const portrait=h('div',{class:'quick-guide-portrait'}),guideLabel=h('strong',{});
 const select=sel(p.pres.guide||GUIDES[0][0],GUIDES.map(g=>[g[0],g[1]]),value=>{p.pres.guide=value;save(p,"Guía: "+guideTitle(p));refreshGuide();});
 select.setAttribute('data-quick-guide','');select.setAttribute('aria-label',"Personaje guía");
 const refreshGuide=()=>{
  const enabled=guidesEnabled(p);select.disabled=!enabled;
  portrait.replaceChildren(enabled?guidePortrait(p.pres.guide):h('span',{class:'no-guide-mark','aria-hidden':'true'},icon('no')));
  guideLabel.textContent=enabled?guideTitle(p):"Sin guía";
 };
 const modes=guideModeOptions(p,refreshGuide);refreshGuide();
 const pictures=h('div',{class:'quick-image-preview',role:'group','aria-label':"Muestra de las imágenes"});
 const refreshImages=()=>pictures.replaceChildren(...['manzana','oso','vaso'].map(word=>h('span',{},illustratedWord(word,p))));
 const images=sel(illustrationStyle(p),ILLUSTRATION_STYLES,value=>{p.pres.imageStyle=value;save(p,"Estilo de las imágenes: "+ILLUSTRATION_STYLES.find(([id])=>id===value)[1]);refreshImages();});
 images.setAttribute('data-quick-image-style','');images.setAttribute('aria-label',"Estilo de las imágenes");refreshImages();
 const advanced=h('button',{type:'button',class:'text-action'},"Personaliza la presentación",icon('settings'));advanced.onclick=onAdvanced;
 return h('section',{class:'quick-settings card'},h('div',{class:'settings-card-heading'},icon('settings'),h('div',{},h('h2',{},"A su gusto"),h('p',{},"Guía e imágenes para esta sesión."))),h('div',{class:'quick-guide-row'},portrait,h('div',{class:'quick-guide-fields'},guideLabel,select)),modes,h('div',{class:'quick-style-row'},h('div',{},h('label',{},"Estilo de las imágenes",images)),pictures),advanced);
}

// Run after the existing presentation extensions have supplied their controls.
const workspacePresentation=presView;
presView=function(p,rerender){
 const view=workspacePresentation(p,rerender),cards=[...view.children].filter(el=>el.classList.contains('card'));
 const general=cards[0],audio=cards[1],rest=cards.slice(2),images=general.querySelector('.image-style-settings');
 general.querySelector('.guide-options')?.closest('.f')?.remove();
 for(const el of [...general.children])if(el.tagName==='P'&&el.textContent.includes("Los guías tienen animaciones"))el.remove();
 images?.remove();
 general.prepend(h('div',{class:'settings-card-heading'},icon('leaf'),h('div',{},h('h3',{},"Perfil, letra y tamaño"),h('p',{class:'setting-description'},"Nombre, emblema, letra y tamaño de los elementos."))));
 general.append(letterCaseSetting(p));
 general.classList.add('profile-settings-card');audio?.classList.add('audio-settings-card');
 const imageCard=h('section',{class:'card image-settings-card'},images);
 view.replaceChildren(guideSettingsCard(p),imageCard,general,...(audio?[audio]:[]),...rest);
 view.classList.add('presentation-layout');return view;
};

// Keep the learner name and existing adult-access control in the shared header.
function syncSessionHeader(){
 const stage=document.querySelector('#app .stage');
 if(!stage||!S){sessionTools.replaceChildren();sessionTools.hidden=true;return;}
 const corner=document.querySelector('#app .corner')||sessionTools.querySelector('.corner');
 const name=h('span',{class:'learner-name',title:S.p.name},S.p.name);
 sessionTools.replaceChildren(name,...(corner?[corner]:[]));sessionTools.hidden=false;
}
const layoutMountStage=mountStage;
mountStage=function(...args){const result=layoutMountStage(...args);syncSessionHeader();return result;};
const layoutEndSession=endSession;
endSession=function(...args){const result=layoutEndSession(...args);syncSessionHeader();return result;};
const layoutShowStart=showStart;
showStart=function(...args){const result=layoutShowStart(...args);syncSessionHeader();return result;};
const layoutAdultHome=adultHome;
adultHome=function(...args){const result=layoutAdultHome(...args);syncSessionHeader();return result;};

const sessionTools=h('div',{class:'session-tools',hidden:true});
const institutionalHeader=h('header',{class:'institutional-header','aria-label':"UTAC · LECAA CAST"},brand(),sessionTools);
document.body.prepend(institutionalHeader);

const stopHighlightedSpeech=Voice.stop;
Voice.stop=function(...args){LetterHighlights.clear();return stopHighlightedSpeech.apply(this,args);};

/* Profiles and custom media stay on this device. No server-side account exists. */
const LocalBackups={
 clean(value){return JSON.parse(JSON.stringify(value),(k,v)=>{if(['__proto__','prototype','constructor'].includes(k))throw Error("La copia contiene campos no admitidos.");return v;});},
 profile(value){
  if(!value||typeof value!=='object'||Array.isArray(value)||typeof value.name!=='string'||!value.name.trim()||!value.plan||!Array.isArray(value.plan.learned)||!value.pres||typeof value.pres!=='object'||Array.isArray(value.pres)||!value.access||typeof value.access!=='object'||Array.isArray(value.access)||!Array.isArray(value.log)||!Array.isArray(value.sessions)||(value.pwHash!=null&&typeof value.pwHash!=='string'))throw Error("El archivo no contiene perfiles válidos de LECAA CAST.");
  const p=this.clean(value),base=newProfile(p.name.trim(),p.avatar,p.pwHash||null);
  const out={...base,...p,name:p.name.trim(),access:{...base.access,...p.access},pres:{...base.pres,...p.pres},plan:{...base.plan,...p.plan},state:{...base.state,...p.state},changes:Array.isArray(p.changes)?p.changes:[]};
  if(!Array.isArray(out.plan.excluded))out.plan.excluded=[];
  if(!out.state.known||!Array.isArray(out.state.known.read)||!Array.isArray(out.state.known.write))out.state.known={read:[],write:[]};
  if(!AVATARS.includes(out.avatar))out.avatar=AVATARS[0];
  if(!GUIDES.some(g=>g[0]===out.pres.guide))out.pres.guide=GUIDES[0][0];
  if(!['contour','matte','arasaac'].includes(out.pres.imageStyle))out.pres.imageStyle='contour';
  out.pres.letterCase=exerciseLetterCase(out);normalizeActivities(out);return out;
 },
 blob(key,url){
  if(typeof key!=='string'||!/^(img:|rec:)/.test(key)||key.includes('|')||typeof url!=='string')throw Error("Hay un material no válido en la copia.");
  const m=/^data:([^;,]*)([^,]*),([\s\S]*)$/.exec(url);
  if(!m)throw Error("La copia solo puede contener imágenes y audios incorporados al archivo.");
  const type=(m[1]||'application/octet-stream').toLowerCase();
  if(!(key.startsWith('img:')?/^image\//.test(type):/^audio\//.test(type))&&type!=='application/octet-stream')throw Error("El tipo de uno de los materiales no es válido.");
  try{if(/;base64(?:;|$)/i.test(m[2])){const raw=atob(m[3]),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);return new Blob([bytes],{type});}return new Blob([decodeURIComponent(m[3])],{type});}catch(e){throw Error("Uno de los materiales de la copia está mal codificado.");}
 },
 read(data){
  data=this.clean(data);
  let rows;
  if(data?.lecaa===3&&Array.isArray(data.profiles))rows=data.profiles;
  else if((data?.lecaa===1||data?.lecaa===2)&&data.profile)rows=[{profile:data.profile,media:data.media||{}}];
  else throw Error("Este archivo no es una copia de seguridad compatible con LECAA CAST.");
  if(!rows.length)throw Error("La copia no contiene ningún perfil.");
  return rows.map(row=>{const profile=this.profile(row.profile),media=row.media??{};if(!media||typeof media!=='object'||Array.isArray(media))throw Error("Los materiales de la copia no son válidos.");const blobs=Object.entries(media).map(([key,url])=>[key,this.blob(key,url)]);return {profile,blobs};});
 },
 async create(ids){
  const snapshots=ids.map(id=>{const p=Store.data.profiles[id];if(!p)throw Error("Un perfil ya no está en el dispositivo.");return this.clean(p);});
  if(!snapshots.length)throw Error("No hay perfiles para exportar.");
  const rows=[];for(const profile of snapshots)rows.push({profile,media:await Media.exportProfile(profile.id)});
  const meta={createdAt:new Date().toISOString(),appRevision:41};
  return rows.length===1?{lecaa:2,...meta,...rows[0]}:{lecaa:3,...meta,profiles:rows};
 },
 async export(ids){
  const data=await this.create(ids),single=ids.length===1;
  const label=single?Store.data.profiles[ids[0]].name.replace(/[^\p{L}\p{N}_-]/gu,'-'):'tots-els-perfils';
  downloadBlob(new Blob([JSON.stringify(data)],{type:'application/json'}),'LECAA_CAST-'+label+'-'+new Date().toISOString().slice(0,10)+'.json');return ids.length;
 },
 mediaTransaction(rows,remove=false){
  const entries=rows.flatMap(row=>row.blobs.map(([key,blob])=>({key:row.profile.id+'|'+key,blob})));
  if(!entries.length)return Promise.resolve();
  return new Promise((resolve,reject)=>{
   if(!Media.db)return reject(Error("Este navegador no permite guardar los materiales. No se ha importado ningún perfil."));
   try{const tx=Media.db.transaction('m','readwrite'),st=tx.objectStore('m');tx.oncomplete=()=>resolve();tx.onerror=()=>reject(Error("No se han podido guardar los materiales. Comprueba el espacio disponible."));tx.onabort=()=>reject(Error("La importación de los materiales se ha interrumpido."));for(const e of entries)remove?st.delete(e.key):st.put(e.blob,e.key);}catch(e){reject(e);}
  });
 },
 async restore(rows){
  const names=new Set(profiles().map(p=>p.name.toLocaleLowerCase('ca'))),prepared=[];
  for(const row of rows){const p=this.profile(row.profile),original=p.name;let n=1;while(names.has(p.name.toLocaleLowerCase('ca')))p.name=original+(n++===1?" (copia)":" (copia "+(n-1)+')');names.add(p.name.toLocaleLowerCase('ca'));p.id=uid();while(Store.data.profiles[p.id]||prepared.some(r=>r.profile.id===p.id))p.id=uid();logChange(p,"Perfil importado de una copia de seguridad.");prepared.push({profile:p,blobs:row.blobs});}
  await this.mediaTransaction(prepared);
  const next={...Store.data,profiles:{...Store.data.profiles}};for(const {profile}of prepared)next.profiles[profile.id]=profile;
  try{localStorage.setItem(KEY,JSON.stringify(next));}catch(e){await this.mediaTransaction(prepared,true).catch(()=>{});throw Error("No hay espacio suficiente o el navegador no permite guardar los perfiles. No se ha importado ningún perfil.");}
  Store.data=next;Store.ok=true;return prepared.map(r=>r.profile);
 }
};
// A read failure must not be reported as a successful, complete backup.
Media.exportProfile=function(pid){return new Promise((resolve,reject)=>{
 if(!this.db)return reject(Error("No se pueden leer los materiales de este navegador."));
 const out={},pending=[];
 try{const tx=this.db.transaction('m','readonly'),r=tx.objectStore('m').openCursor();
  tx.onerror=()=>reject(Error("No se han podido leer los materiales."));tx.onabort=()=>reject(Error("La lectura de los materiales se ha interrumpido."));
  tx.oncomplete=()=>Promise.all(pending).then(()=>resolve(out),reject);
  r.onerror=()=>reject(Error("No se han podido leer los materiales."));
  r.onsuccess=()=>{const cursor=r.result;if(!cursor)return;if(String(cursor.key).startsWith(pid+'|')){const key=String(cursor.key).slice(pid.length+1),blob=cursor.value;pending.push(new Promise((done,fail)=>{const fr=new FileReader();fr.onload=()=>{out[key]=fr.result;done();};fr.onerror=()=>fail(Error("No se ha podido leer uno de los materiales."));fr.readAsDataURL(blob);}));}cursor.continue();};
 }catch(e){reject(e);}
});};
function localPrivacyNote(){return h('p',{class:'local-privacy-note'},icon('lock'),"Los perfiles, el progreso, las fotografías y los audios personalizados se guardan solo en este navegador y dispositivo, también si utilizas LECAA CAST en línea. LECAA CAST no los envía a ningún servidor.");}
function localDialog(title,kind,onClose=()=>{}){
 let busy=false;
 const opener=document.activeElement,close=h('button',{class:'btn ghost small',type:'button','aria-label':"Cierra "+title.toLocaleLowerCase('ca')},"Cierra");
 const ov=h('div',{class:'overlay',role:'dialog','aria-modal':'true','aria-label':title}),body=h('div',{class:'local-dialog-body'}),modal=h('div',{class:'modal local-dialog '+kind},h('div',{class:'local-dialog-heading'},h('h2',{},title),close),body);
 const finish=()=>{if(busy)return;ov.remove();onClose();if(opener?.isConnected)opener.focus();};close.onclick=finish;
 ov.addEventListener('keydown',event=>{if(event.key==='Escape'){event.stopPropagation();finish();}if(event.key==='Tab'){const els=[...ov.querySelectorAll('button,a[href],input,select,summary,[tabindex="0"]')].filter(e=>!e.disabled&&e.offsetParent!==null);const first=els[0],last=els.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}}});
 ov.append(modal);document.body.append(ov);close.focus();return {ov,body,close:finish,setBusy(value){busy=!!value;close.disabled=busy;body.setAttribute('aria-busy',String(busy));}};
}
function backupProfileCard(p){
 const status=h('p',{'aria-live':'polite',class:'muted'}),exp=h('button',{type:'button',class:'btn','data-export-profile':p.id},"Exporta este perfil"),manage=h('button',{type:'button',class:'btn ghost','data-backup-open':''},"Importa o copia todos los perfiles");
 exp.onclick=async()=>{exp.disabled=true;try{await LocalBackups.export([p.id]);status.textContent="Copia descargada con la configuración, el progreso y los materiales personalizados.";}catch(e){status.textContent=e.message||"No se ha podido crear la copia.";}finally{exp.disabled=false;}};manage.onclick=()=>showBackups(p.id);
 return h('section',{class:'card stack backup-profile-card'},h('h3',{},"Copias de seguridad"),localPrivacyNote(),h('div',{class:'row'},exp,manage),status);
}
function showBackups(selectedId='all'){
 let imported=false,pending=null;const origin=CUR;
 const dialog=localDialog("Copias de seguridad",'backup-dialog',()=>{if(imported){if(origin)adultHome(origin,'data');else showStart();}});
 const status=h('p',{class:'backup-status','aria-live':'polite'});
 const select=sel(selectedId,[['all',"Todos los perfiles del dispositivo"],...profiles().map(p=>[p.id,p.name])],()=>{});select.setAttribute('data-backup-selection','');
 const exp=h('button',{class:'btn',type:'button','data-backup-export':''},"Descarga la copia");
 exp.onclick=async()=>{exp.disabled=true;status.textContent="Preparando la copia…";try{const ids=select.value==='all'?profiles().map(p=>p.id):[select.value];const n=await LocalBackups.export(ids);status.textContent="Copia descargada: "+n+(n===1?" perfil.":" perfiles.");}catch(e){status.textContent=e.message||"No se ha podido crear la copia.";}finally{exp.disabled=false;}};
 const file=h('input',{type:'file',accept:'.json,application/json',hidden:true,'data-backup-file':'','aria-label':"Elige una copia de seguridad de LECAA CAST"}),preview=h('div',{class:'backup-preview','aria-live':'polite'}),restore=h('button',{class:'btn',type:'button',disabled:true,'data-backup-import':''},"Importa los perfiles");
 const choose=h('button',{type:'button',class:'btn ghost'},"Elige el archivo de copia"),fileName=h('span',{class:'backup-file-name'},"Ningún archivo seleccionado");choose.onclick=()=>{file.value='';file.click();};
 file.onchange=async()=>{pending=null;restore.disabled=true;preview.replaceChildren();const f=file.files[0];fileName.textContent=f?.name||"Ningún archivo seleccionado";if(!f)return;status.textContent="Leyendo el archivo…";try{pending=LocalBackups.read(JSON.parse(await f.text()));preview.append(h('p',{},pending.length===1?"Se importará este perfil:":"Se importarán "+pending.length+" perfiles:"),h('ul',{},...pending.map(r=>h('li',{},r.profile.name))));restore.disabled=false;status.textContent="Copia preparada. Se añadirán perfiles nuevos y se conservarán los existentes. Los nombres repetidos se distinguirán con «copia».";}catch(e){status.textContent=e.message||"El archivo no es una copia válida.";}};
 restore.onclick=async()=>{if(!pending)return;restore.disabled=true;file.disabled=true;dialog.setBusy(true);status.textContent="Importando los perfiles al dispositivo…";try{const result=await LocalBackups.restore(pending);imported=true;pending=null;preview.replaceChildren(h('ul',{},...result.map(p=>h('li',{},p.name))));status.textContent="Importación completada: "+result.length+(result.length===1?" perfil añadido.":" perfiles añadidos.");}catch(e){status.textContent=e.message||"No se ha podido completar la importación.";restore.disabled=false;}finally{file.disabled=false;dialog.setBusy(false);}};
 dialog.body.append(localPrivacyNote(),h('section',{class:'backup-section stack'},h('h3',{},"Exporta"),h('p',{},"Descarga un archivo con los perfiles elegidos, la configuración, el progreso y las fotografías y audios personalizados."),field("Perfiles que quieres copiar",select),exp),h('section',{class:'backup-section stack'},h('h3',{},"Importa"),h('p',{},"En el otro dispositivo, abre este apartado, elige el archivo e importa los perfiles. Las copias deben ser compatibles con LECAA CAST; no se deben importar perfiles de la versión catalana."),h('div',{class:'row'},choose,fileName),file,preview,restore),status,h('p',{class:'muted backup-file-note'},"El archivo descargado contiene datos personales. Guárdalo en un lugar privado. Si borras los datos del navegador, necesitarás una copia para recuperar los perfiles."));
}


Voice.getCatalanVoices=function(){try{return speechSynthesis.getVoices().filter(v=>v.localService===true&&/^ca(-|_|$)/i.test(v.lang));}catch(e){return[];}};
Voice.hasSynth=function(){return this.getCatalanVoices().length>0;};

const GUIDE_DOCUMENT={"about":["LECAA CAST es una aplicación web para practicar las bases del código escrito en castellano de España. Incluye actividades de sonido inicial, rima, correspondencia entre letras y sonidos, lectura de palabras y construcción de palabras con un teclado reducido. Las respuestas se dan seleccionando: no es necesario responder oralmente. Se puede utilizar con selección directa, lector ocular o pulsadores, según la configuración de acceso.","LECAA CAST es un recurso complementario. No es un método completo de enseñanza de la lectura y la escritura ni sustituye la intervención educativa, la lectura compartida, la escritura con fines comunicativos o el trabajo de vocabulario y comprensión. En la Guía y Marco Teórico encontrarás los fundamentos y las prácticas que permiten situarlo dentro de una enseñanza más amplia.","Los fundamentos que se presentan en la guía proceden de dos ámbitos: estudios con personas que utilizan comunicación aumentativa y alternativa (CAA) e investigación con otras poblaciones. LECAA CAST, como aplicación, no cuenta con evidencia propia de eficacia; su diseño se apoya en los principios y los límites descritos en las fuentes citadas.","La aplicación se ha creado desde la Unitat de Tècniques Augmentatives i Alternatives de Comunicació (UTAC), con herramientas de inteligencia artificial. Es también un ejemplo de cómo estas herramientas pueden contribuir a crear recursos educativos accesibles. Las instituciones, las herramientas utilizadas y las licencias pueden consultarse en los Créditos."],"sections":[{"id":"comencar","title":"Cómo empezar","intro":"Una orientación breve para preparar el perfil, comprobar el acceso y acompañar las primeras sesiones.","blocks":[{"type":"heading","text":"1. Prepara un perfil"},{"type":"p","text":"En la pantalla inicial, elige «Perfil nuevo». Las opciones y los registros de cada alumno se conservan en su perfil. Desde su espacio, entra en «Opciones avanzadas» para revisar el acceso, el plan de trabajo y los materiales."},{"type":"heading","text":"2. Comprueba cómo selecciona"},{"type":"p","text":"Configura el sistema de acceso que utiliza el alumno y pruébalo antes de empezar: selección directa, mirada con tiempo de fijación, mirada con pulsador o barrido. Comprueba que puede alcanzar las opciones y activarlas de forma cómoda. En la configuración de mirada, el lector ocular debe funcionar con el software de acceso del dispositivo."},{"type":"heading","text":"3. Personaliza la presentación y los materiales"},{"type":"p","text":"En «Presentación» puedes elegir Sencillas, Detalladas o ARASAAC; la letra de los ejercicios, mayúscula o minúscula; y si el guía se muestra animado, estático o no se muestra. Revisa las palabras y las imágenes del plan: puedes excluir palabras o añadir fotografías propias. Los enunciados mantienen su formato habitual."},{"type":"heading","text":"4. Prepara el plan e inicia la sesión"},{"type":"p","text":"Indica las correspondencias que tiene activadas el alumno y revisa las actividades y los perfiles estructurales habilitados en el Plan. En «Letra y sonido» pueden presentarse dos, tres o cuatro opciones. Ajusta las repeticiones y las ayudas a su ritmo. Vuelve al resumen del perfil y pulsa «Comenzar la sesión». Durante las actividades hay controles para repetir, pedir ayuda y hacer una pausa. Las locuciones naturales femeninas están incorporadas. Los candidatos fonéticos y los modelos específicos pendientes se indican en Sonidos; una actividad sin los audios necesarios no genera resultados válidos de aprendizaje."},{"type":"heading","text":"5. Revisa el progreso y conserva una copia"},{"type":"p","text":"En «¿Cómo va?» puedes consultar las sesiones y las respuestas. Los perfiles y los materiales personales se guardan solo en este navegador y dispositivo, también cuando LECAA CAST se utiliza en línea. En «Copias de seguridad», en la pantalla inicial, puedes exportar todos los perfiles o importarlos en otro dispositivo; también puedes exportar un perfil individual desde su configuración. Conserva el archivo exportado en un lugar adecuado."}]},{"id":"abast","title":"Objetivos y alcance","intro":"Una herramienta para practicar el código escrito dentro de una enseñanza de la lectura y la escritura más amplia.","blocks":[{"type":"heading","text":"Qué se practica"},{"type":"p","text":"LECAA CAST ofrece cinco tipos de actividad: Letra y sonido, Lee y elige, Construye la palabra, Escucha y elige y ¿Riman?. El trabajo se centra en palabras y correspondencias entre grafías y sonidos. Las actividades de construcción utilizan un teclado reducido para formar la palabra propuesta; no son actividades de escritura libre."},{"type":"evidence","kind":"altres","title":"El código escrito es una parte de la lectura","paragraphs":["La investigación general sobre el aprendizaje lector destaca la importancia de la enseñanza de las correspondencias entre grafías y sonidos, pero también del lenguaje, el vocabulario y la comprensión. Leer palabras y comprender textos son objetivos relacionados que requieren una intervención más amplia que la práctica del código ([[castles2018|Castles et al., 2018]]; [[hoover1990|Hoover & Gough, 1990]])."]},{"type":"heading","text":"Oportunidades de aprender y expectativas"},{"type":"evidence","kind":"caa","title":"Las barreras también están en el entorno","paragraphs":["Las expectativas bajas, las demandas de respuesta oral, la falta de materiales accesibles y el acceso insuficiente a profesionales formados pueden limitar las oportunidades de aprender de las personas que necesitan o utilizan CAA. La revisión de Light et al. sitúa estas barreras entre los problemas que deben abordarse en la enseñanza de la alfabetización ([[light2025|Light et al., 2025]])."]},{"type":"p","text":"Utilizar CAA no define una única manera de aprender ni implica necesariamente ausencia de habla. Las características comunicativas, sensoriales, motrices y lingüísticas de los participantes varían entre estudios; por ello debe observarse a cada alumno y evitar conclusiones generales a partir de su forma de comunicación ([[collins2024|Collins et al., 2024]]; [[light2025|Light et al., 2025]])."},{"type":"heading","text":"El papel del adulto"},{"type":"p","text":"Un enfoque comprensivo incluye oportunidades de leer con otras personas, explorar libros, escribir, conversar y utilizar la lectura y la escritura en situaciones con sentido. El adulto prepara estas oportunidades, enseña, modela y adapta los materiales. Esta es la orientación educativa desarrollada por Erickson y Koppenhaver, que defiende el acceso a la alfabetización sin exigir prerrequisitos de habla o de rendimiento previo ([[erickson2020|Erickson & Koppenhaver, 2020]])."},{"type":"p","text":"Ofrecer enseñanza a todos no equivale a garantizar un mismo resultado para todos. Los datos de intervención con personas que utilizan CAA muestran posibilidades de aprendizaje, pero también variabilidad y límites en la generalización de los resultados ([[ulriksen2026b|Ulriksen et al., 2026b]])."}]},{"id":"evidencia","title":"Fundamentos y evidencia","intro":"La guía diferencia los estudios con personas que utilizan CAA de la investigación con otras poblaciones. Los resultados se interpretan dentro del alcance de cada estudio.","blocks":[{"type":"evidence","kind":"caa","title":"Qué muestra la investigación con CAA","paragraphs":["Una revisión sistemática de siete estudios de caso único, con 20 participantes, encontró resultados positivos consistentes en las correspondencias entre letras y sonidos. La descodificación presentó resultados más variables. La base de estudios es pequeña y se centra sobre todo en habilidades iniciales: no permite garantizar el aprendizaje de la lectura a cualquier persona ni establecer una duración óptima de enseñanza ([[ulriksen2026b|Ulriksen et al., 2026b]]).","En un estudio con la aplicación Accessible Literacy Learning (ALL), cuatro niños que utilizaban CAA mejoraron en las habilidades entrenadas y tres generalizaron la descodificación a palabras nuevas. La intervención la aplicaron familiares formados; estos resultados corresponden a ALL y a las condiciones de aquel estudio ([[babb2026|Babb & Caron, 2026]]).","En una intervención fónica adaptada con tres alumnos con discapacidad intelectual que necesitaban CAA, los tres mejoraron en lectura y dos también en escritura. La muestra reducida exige prudencia al extender los resultados a otros alumnos y contextos ([[linder2023|Linder et al., 2023]])."]},{"type":"evidence","kind":"altres","title":"Qué aporta la investigación con otras poblaciones","paragraphs":["Los estudios sobre lectura en otras poblaciones aportan información sobre la enseñanza explícita del código, la conciencia fonémica, la escritura y la comprensión. Aportan fundamentos relevantes, pero no demuestran por sí mismos la eficacia de una intervención concreta con personas que utilizan CAA ([[castles2018|Castles et al., 2018]]).","En un estudio sueco con 123 alumnos con discapacidad intelectual, distribuidos en cuatro grupos, solo la intervención multicomponente mostró una mejora superior en conciencia fonológica. No se observaron diferencias entre los grupos en reconocimiento de palabras ni en comprensión. Es una muestra de la necesidad de considerar tanto los resultados positivos como los que no confirman los beneficios esperados ([[palmqvist2025|Palmqvist et al., 2025]]).","Un estudio prolongado con alumnado con discapacidad intelectual observó progresos con enseñanza intensiva y sistemática, con diferencias importantes entre alumnos. Sus datos no establecen una dosis universal ni un calendario de progreso aplicable a todos los usuarios de CAA ([[allor2014|Allor et al., 2014]])."]},{"type":"heading","text":"Cómo deben leerse las conclusiones"},{"type":"list","items":["Una mejora en las palabras practicadas no demuestra, por sí sola, lectura de palabras nuevas ni comprensión de textos.","Una asociación entre dos habilidades no demuestra que una sea la causa de la otra.","El resultado de un grupo o de un estudio pequeño no determina el resultado de un alumno concreto.","Los estudios de otros programas aportan fundamentos; no son estudios de eficacia de LECAA CAST."]},{"type":"p","text":"Estas precauciones son especialmente relevantes ante la heterogeneidad de participantes, procedimientos y medidas que describen las revisiones de intervención y evaluación en CAA ([[collins2024|Collins et al., 2024]]; [[ulriksen2026b|Ulriksen et al., 2026b]])."}]},{"id":"activitats","title":"Actividades y apoyos","intro":"Los fundamentos de las correspondencias entre sonidos y grafías, la lectura de palabras, la escritura y los apoyos durante el aprendizaje.","blocks":[{"type":"heading","text":"Correspondencias entre grafías y sonidos"},{"type":"evidence","kind":"caa","title":"Una habilidad inicial con resultados consistentes","paragraphs":["La enseñanza adaptada de las correspondencias entre letras y sonidos es el componente con resultados más consistentes en la revisión de intervenciones iniciales con niños con discapacidad intelectual que utilizan CAA ([[ulriksen2026b|Ulriksen et al., 2026b]])."]},{"type":"evidence","kind":"altres","title":"Enseñanza explícita del código","paragraphs":["La investigación general ha encontrado un papel causal del conocimiento de las correspondencias entre letras y sonidos y de la conciencia fonémica en el aprendizaje lector. Esto apoya la enseñanza y la práctica de estas relaciones ([[hulme2012|Hulme et al., 2012]])."]},{"type":"heading","text":"Grafías, dígrafos y sílabas"},{"type":"evidence","kind":"altres","title":"Resultados que proceden de otras lenguas y poblaciones","paragraphs":["En un estudio con aprendices de portugués de Brasil, enseñar las subunidades grafema–fonema dio mejores resultados que enseñar sílabas enteras en diversas medidas de lectura y escritura. La población estudiada no utilizaba CAA ([[sargiani2022|Sargiani et al., 2022]]).","También se han observado beneficios de una intervención fónica con alumnado con discapacidad intelectual. Esta investigación amplía el conocimiento sobre la enseñanza del código, pero no todos sus participantes o condiciones son equivalentes a los de los estudios específicos con CAA ([[sermier2021|Sermier Dessemontet et al., 2021]])."]},{"type":"heading","text":"Unir los sonidos y reconocer la palabra"},{"type":"evidence","kind":"altres","title":"De la descodificación al reconocimiento","paragraphs":["Los modelos de aprendizaje lector describen cómo las conexiones entre grafías, sonidos y significados contribuyen a fijar las palabras en la memoria. La descodificación participa en este proceso, junto con el conocimiento lingüístico ([[ehri2014|Ehri, 2014]]; [[share1995|Share, 1995]]).","Con lectores principiantes, la fonación conectada resultó más eficaz que la segmentada para enseñar a descodificar palabras desconocidas. Este estudio no se realizó con usuarios de CAA. Además, escuchar grabaciones de sonidos separados no reproduce automáticamente la fonación conectada: los sonidos de las grafías pueden variar según el contexto de la palabra ([[gonzalez2021|Gonzalez-Frey & Ehri, 2021]])."]},{"type":"heading","text":"Conciencia fonológica junto a las letras"},{"type":"evidence","kind":"altres","title":"Relación con el código escrito","paragraphs":["Un metaanálisis encontró que la enseñanza de conciencia fonémica puede favorecer la lectura y que el trabajo con letras es una característica relevante de las intervenciones ([[ehri2001|Ehri et al., 2001]]). Un metaanálisis posterior examinó la relación entre cantidad de enseñanza y resultados en conciencia fonémica con niños de las primeras etapas escolares. Sus estimaciones no son un límite de horas ni una pauta de tratamiento para personas que utilizan CAA ([[erbeli2024|Erbeli et al., 2024]]).","En un estudio con niños de preescolar, añadir previamente enseñanza de conciencia silábica no aportó un beneficio adicional claro a la intervención fonémica. Este resultado no establece una secuencia universal, pero cuestiona que deba exigirse siempre el dominio silábico antes de introducir el trabajo fonémico ([[ukrainetz2011|Ukrainetz et al., 2011]])."]},{"type":"heading","text":"Responder seleccionando"},{"type":"evidence","kind":"caa","title":"Mostrar conocimientos sin exigir una respuesta oral","paragraphs":["Los formatos de evaluación de conocimiento escrito con CAA incluyen diferentes respuestas por selección. Debe comprobarse qué exige cada formato y si las adaptaciones permiten interpretar el rendimiento del alumno ([[collins2024|Collins et al., 2024]])."]},{"type":"p","text":"En «¿Riman?» se elige entre dos respuestas. En «Letra y sonido» el número de opciones es configurable. Si todas las opciones fueran igualmente probables y se eligiera al azar, el acierto sería del 50% con dos, aproximadamente del 33% con tres y del 25% con cuatro. Son probabilidades matemáticas, no estimaciones del comportamiento de un alumno. Un acierto aislado no es suficiente para establecer dominio."},{"type":"heading","text":"Interpretar las opciones incorrectas"},{"type":"evidence","kind":"caa","title":"Los errores dan información, pero necesitan contexto","paragraphs":["Las adaptaciones descritas en la literatura incluyen la selección cuidadosa de opciones incorrectas para explorar posibles dificultades. Una respuesta puede ser compatible con varias explicaciones: confusión de sonidos, reconocimiento de la imagen o dificultad de acceso. El análisis de errores requiere observación y no equivale a un diagnóstico ([[light2025|Light et al., 2025]])."]},{"type":"heading","text":"Escuchar, repetir y comprobar el vocabulario"},{"type":"evidence","kind":"caa","title":"Las demandas de memoria y el formato importan","paragraphs":["Card y Dodd encontraron diferencias entre tareas de conciencia fonológica en niños con parálisis cerebral con habla y sin habla. Los resultados variaron según la demanda de la tarea y no permiten afirmar que todas las personas que no hablan tengan las mismas dificultades o carezcan de representaciones fonológicas ([[card2006|Card & Dodd, 2006]])."]},{"type":"p","text":"LECAA CAST permite volver a escuchar los enunciados y presenta apoyo auditivo para las palabras, cuando las locuciones revisadas estén incorporadas. Oír el nombre de una imagen ayuda a aclarar qué palabra se le asocia, pero no comprueba, por sí solo, que el alumno la comprenda. Conviene explorar también su vocabulario y el reconocimiento de las representaciones; en alumnado con discapacidad intelectual que utiliza CAA se han observado asociaciones entre vocabulario y habilidades iniciales de lectura, sin que esto demuestre causalidad ([[ulriksen2026a|Ulriksen et al., 2026a]])."},{"type":"heading","text":"Ayudas graduadas y lectura con apoyo"},{"type":"evidence","kind":"caa","title":"Distinguir participación con ayuda y rendimiento independiente","paragraphs":["Una intervención de lectura compartida con tecnología de CAA combinó tiempo de espera, ayudas y modelado con apoyos de lectoescritura. Aumentó la participación de los niños en aquella actividad ([[holyfield2026|Holyfield et al., 2026]])."]},{"type":"evidence","kind":"altres","title":"Registrar la ayuda también puede informar","paragraphs":["Un estudio de intervención en conciencia fonológica con personas con síndrome de Down utilizó medidas que tenían en cuenta los apoyos. Este tipo de información puede complementar la distinción entre acierto y error, dentro de los procedimientos del estudio ([[hessling2022|Hessling Prahl et al., 2022]])."]},{"type":"p","text":"Al revisar una sesión de LECAA CAST, diferencia las respuestas sin ayuda de las que se han resuelto con pistas, reducción de opciones o modelo. Si la aplicación ha hecho sonar la palabra, aquella respuesta no muestra, por sí sola, que el alumno la haya descodificado de forma independiente. Los registros conservan la condición de práctica y la secuencia de ayudas."},{"type":"heading","text":"Construir palabras y escribir"},{"type":"evidence","kind":"caa","title":"Formar palabras con letras","paragraphs":["Linder et al. incluyeron adaptaciones de lectura y escritura en una intervención fónica con tres alumnos que necesitaban CAA. Dos mejoraron también en escritura. El estudio apoya la exploración de estas habilidades con formas de respuesta accesibles ([[linder2023|Linder et al., 2023]])."]},{"type":"p","text":"En «Construye la palabra», el alumno selecciona letras, puede borrar, escuchar «Lo que he escrito» y confirmar con «Hecho». Esta práctica de una palabra propuesta debe distinguirse de la escritura generativa con acceso a todo el alfabeto, que forma parte de una propuesta comprensiva de alfabetización fuera de esta actividad ([[erickson2020|Erickson & Koppenhaver, 2020]])."},{"type":"heading","text":"Práctica, repaso y continuidad"},{"type":"evidence","kind":"altres","title":"Enseñanza sistemática y seguimiento","paragraphs":["Las recomendaciones basadas en la investigación con alumnado con discapacidad intelectual incluyen enseñanza explícita y sistemática, repaso acumulativo y decisiones informadas por datos. Estos principios permiten organizar la práctica y revisar sus resultados ([[lemons2016|Lemons et al., 2016]])."]}]},{"id":"acces","title":"Acceso y personalización","intro":"La manera de responder debe permitir observar el aprendizaje sin confundir las dificultades de acceso con los conocimientos de lectura y escritura.","blocks":[{"type":"evidence","kind":"caa","title":"Adaptar la respuesta e interpretar bien la evaluación","paragraphs":["La revisión de Collins et al. describe una gran diversidad de procedimientos para medir el conocimiento escrito en estudiantes que utilizan CAA. La accesibilidad de la respuesta, las demandas de la prueba y las adaptaciones empleadas son elementos necesarios para interpretar el resultado ([[collins2024|Collins et al., 2024]])."]},{"type":"table","head":["Qué debe observarse","Qué puede revisarse"],"rows":[["Selecciones accidentales o dificultad para alcanzar una opción","Posición, tamaño y funcionamiento del sistema de acceso; tiempo de fijación o de barrido."],["La ayuda aparece antes de que el alumno termine de seleccionar","Tiempo de espera, duración del recorrido y modalidad de ayuda."],["Una imagen o una palabra no resulta familiar","Comprensión del vocabulario y adecuación de la representación; materiales personalizados."],["Resultados diferentes según las ayudas disponibles","Si se ha escuchado la palabra, se han reducido opciones o se ha mostrado un modelo."],["Cambios entre sesiones","Condiciones de acceso y participación, fatiga observada, ayudas y tiempo de trabajo real."]]},{"type":"p","text":"La tabla es una pauta de observación, no una prueba estandarizada ni una clasificación de perfiles. El objetivo es revisar las condiciones de respuesta antes de atribuir un error exclusivamente a una dificultad lectora."},{"type":"heading","text":"Un acceso diferente no define un nivel lector"},{"type":"p","text":"El uso de mirada o de pulsadores describe cómo se responde. No debe tratarse automáticamente como una pista pedagógica ni como una medida del conocimiento escrito. Al mismo tiempo, los resultados de un estudio solo deben extenderse a los sistemas de acceso que realmente se hayan estudiado; la revisión de las medidas en CAA muestra por qué deben describirse estas condiciones ([[collins2024|Collins et al., 2024]])."},{"type":"heading","text":"Opciones disponibles en LECAA CAST"},{"type":"p","text":"Cada perfil permite configurar el acceso, la presentación, las voces, las repeticiones y las ayudas, así como revisar los materiales. Prueba la configuración con el alumno y comprueba la respuesta real antes de interpretar los datos de la sesión. Las locuciones femenina y masculina de esta primera versión están pendientes de incorporación y revisión."},{"type":"heading","text":"Datos y copias de seguridad"},{"type":"p","text":"Los perfiles, el progreso, las fotografías y los audios personalizados se conservan en este navegador y dispositivo. LECAA CAST no los envía a ningún servidor. Abrir la aplicación desde otro navegador o dispositivo no traslada los perfiles: hay que exportarlos e importarlos. Borrar los datos del navegador puede eliminarlos; la copia de seguridad permite conservarlos y trasladarlos."}]},{"id":"mes-enlla","title":"Más allá de LECAA CAST","intro":"La lectura y la escritura deben tener espacio en las conversaciones, los libros, el aula y la vida cotidiana, más allá de los ejercicios de palabras.","blocks":[{"type":"heading","text":"Lectura compartida con acceso a la CAA"},{"type":"evidence","kind":"caa","title":"Participar en la lectura","paragraphs":["En un estudio con cuatro niños que se encontraban en fases iniciales de comunicación simbólica, incorporar tecnología de CAA con apoyos de lectoescritura aumentó la participación en lectura compartida. El resultado se refiere a participación, no a una demostración general de descodificación o comprensión lectora ([[holyfield2026|Holyfield et al., 2026]])."]},{"type":"p","text":"Cuando compartas un libro, mantén el sistema de comunicación al alcance, ofrece oportunidades de comentar y elegir, y deja tiempo para responder. La lectura compartida puede incluir tanto el contenido del cuento como las opiniones y los intereses del alumno ([[erickson2020|Erickson & Koppenhaver, 2020]])."},{"type":"heading","text":"Modelado con el sistema de comunicación"},{"type":"evidence","kind":"caa","title":"Una práctica estudiada para la comunicación","paragraphs":["Las revisiones de modelado asistido con CAA describen efectos positivos en habilidades comunicativas. Se trata de investigación sobre comunicación: no debe presentarse como una demostración directa de que el modelado, por sí solo, enseñe a leer. En la actividad cotidiana, el adulto puede hablar y utilizar también los símbolos del sistema de comunicación ([[biggs2018|Biggs et al., 2018]]; [[sennott2016|Sennott et al., 2016]])."]},{"type":"heading","text":"Escritura con acceso a todo el alfabeto"},{"type":"p","text":"Una propuesta comprensiva ofrece oportunidades de escritura con un «lápiz alternativo»: teclado, alfabeto con barrido o tablero de letras, según el acceso de la persona. El objetivo es poder explorar y expresar ideas, también antes de la escritura convencional. Este trabajo puede desarrollarse con otros recursos y en los contextos cotidianos del alumno ([[erickson2020|Erickson & Koppenhaver, 2020]])."},{"type":"heading","text":"Palabra escrita y salida de voz en el comunicador"},{"type":"evidence","kind":"caa","title":"Exposición a palabras en contexto comunicativo","paragraphs":["Una función de CAA que mostraba y hacía sonar la palabra escrita después de seleccionar un símbolo produjo mejoras en lectura de palabras en cuatro participantes con autismo y habla mínima o nula. Esta función es una de las vías estudiadas para vincular el uso comunicativo de los símbolos con la palabra escrita ([[caron2021|Caron et al., 2021]])."]},{"type":"heading","text":"Vocabulario, lenguaje y comprensión"},{"type":"evidence","kind":"altres","title":"Leer para entender","paragraphs":["Los modelos de lectura destacan la contribución de la descodificación y de la comprensión lingüística. El trabajo del código debe integrarse con vocabulario, conversación y comprensión de textos; practicar correspondencias o seleccionar una imagen no cubre, por sí solo, todos estos componentes ([[castles2018|Castles et al., 2018]]; [[hoover1990|Hoover & Gough, 1990]])."]},{"type":"heading","text":"Usos con sentido"},{"type":"p","text":"Los nombres, los libros de interés, las listas, las notas y las decisiones cotidianas ofrecen contextos para leer y escribir con una finalidad. Esta orientación forma parte de la propuesta comprensiva de alfabetización para estudiantes con discapacidades significativas ([[erickson2020|Erickson & Koppenhaver, 2020]])."},{"type":"heading","text":"Formación y colaboración de los adultos"},{"type":"evidence","kind":"caa","title":"Enseñar los procedimientos a quienes acompañan","paragraphs":["Después de una formación en línea sobre enseñanza de correspondencias entre letras y sonidos, los profesionales de un estudio mejoraron la fidelidad de aplicación y ocho de los nueve alumnos que utilizaban CAA mejoraron en estas correspondencias. El resultado se refiere a aquel procedimiento de formación e intervención ([[caron2022|Caron et al., 2022]]).","La investigación cualitativa con familias muestra experiencias, prioridades y necesidades de apoyo diversas. Conocerlas ayuda a situar la colaboración entre familia y profesionales; un estudio cualitativo no prueba, por sí mismo, la eficacia de una aplicación ([[leroux2024|Leroux et al., 2024]])."]},{"type":"heading","text":"Continuidad y tiempo real de enseñanza"},{"type":"evidence","kind":"altres","title":"Registrar lo que se hace realmente","paragraphs":["En el estudio de Palmqvist et al., la intervención efectivamente recibida fue inferior a la planificada. Para valorar resultados deben considerarse las oportunidades reales de práctica, y no solo la duración prevista de un programa ([[palmqvist2025|Palmqvist et al., 2025]]). Los datos de seguimiento complementan la observación del progreso a lo largo del tiempo ([[lemons2016|Lemons et al., 2016]])."]}]},{"id":"llengues","title":"Adaptaciones y otras lenguas","intro":"Una adaptación lingüística debe revisar los materiales, las correspondencias entre sonidos y grafías y las formas de respuesta.","blocks":[{"type":"heading","text":"Esta versión es en castellano de España"},{"type":"p","text":"LECAA CAST adapta el programa al castellano de España a partir de LECAA en catalán v45.1 y del programa de contenidos CAST 2.0. Conserva los cinco tipos de actividad y utiliza un corpus propio de 300 sustantivos, bancos cerrados de respuesta y las correspondencias del castellano. La pronunciación de referencia distingue /s/ y /θ/ y presenta yeísmo; si la variedad del alumno difiere, el adulto debe revisar las condiciones lingüísticas del Plan. El archivo HTML puede servir de base para otras adaptaciones, respetando las licencias y revisando sus materiales."},{"type":"evidence","kind":"altres","title":"La ortografía modifica las demandas de aprendizaje","paragraphs":["En una comparación de ortografías europeas, la adquisición inicial presentó diferencias importantes entre lenguas. Por tanto, los resultados o las secuencias empleadas en una ortografía no pueden trasladarse mecánicamente a otra ([[seymour2003|Seymour et al., 2003]])."]},{"type":"heading","text":"Qué debe revisarse en una adaptación"},{"type":"list","items":["Las correspondencias entre grafías y sonidos, los dígrafos y los cambios de pronunciación según el contexto y la variedad lingüística.","Las palabras, las rimas y las opciones de respuesta: deben corresponder a la lengua y no introducir más de una respuesta correcta.","El significado y la familiaridad de las imágenes, con las equivalencias necesarias en cada comunidad lingüística.","Los enunciados y los audios, contrastándolos con personas competentes en la lengua y su fonética.","El acceso, las configuraciones, los registros y las licencias de los materiales incorporados."]},{"type":"p","text":"Esta es una pauta para revisar una adaptación, no una garantía de equivalencia ni de eficacia. Una nueva versión necesita comprobar sus propios materiales y funcionamiento."}]},{"id":"limits","title":"Limitaciones y seguimiento","intro":"Los fundamentos de la guía ayudan a interpretar el recurso, pero no sustituyen la evaluación de la aplicación ni el seguimiento de cada alumno.","blocks":[{"type":"heading","text":"LECAA CAST no tiene estudios propios de eficacia"},{"type":"p","text":"No se dispone de un estudio que establezca la eficacia de LECAA CAST, para qué perfiles es útil o qué intensidad de uso necesita. El diseño se apoya en las fuentes citadas; estas no constituyen una validación de la aplicación."},{"type":"evidence","kind":"caa","title":"Alcance de los datos disponibles","paragraphs":["La investigación de intervención con personas que utilizan CAA todavía tiene muestras pequeñas y medidas centradas sobre todo en habilidades iniciales. Los resultados son prometedores en algunos componentes y más variables en otros, con límites para generalizar a nuevos participantes, materiales y sistemas de acceso ([[ulriksen2026b|Ulriksen et al., 2026b]])."]},{"type":"evidence","kind":"altres","title":"Prudencia en las extrapolaciones","paragraphs":["Los estudios con otras poblaciones o lenguas aportan fundamentos, pero no permiten asumir el mismo resultado ni una dosis óptima para cada usuario de CAA. Las estimaciones sobre horas de enseñanza o las comparaciones entre enfoques deben mantenerse dentro de la población y las medidas estudiadas ([[erbeli2024|Erbeli et al., 2024]]; [[sargiani2022|Sargiani et al., 2022]])."]},{"type":"heading","text":"Audios, imágenes y contenido"},{"type":"p","text":"En esta primera versión las locuciones femenina y masculina están pendientes de producción, incorporación y revisión. Las actividades que necesiten audio no deben interpretarse como práctica evaluable mientras falten las grabaciones. La síntesis de voz no garantiza una pronunciación fonética adecuada: los sonidos aislados, los modelos contextuales y la lectura conectada deberán revisarse antes de activarlos. Las imágenes tampoco garantizan la comprensión del vocabulario."},{"type":"heading","text":"Los registros son información de práctica"},{"type":"p","text":"Los gráficos y los registros de LECAA CAST describen lo realizado en la aplicación. No son una prueba estandarizada, un diagnóstico ni una evaluación completa de la comprensión lectora. Interprétalos junto con la observación, el acceso, las ayudas y las oportunidades de uso real de la lectura y la escritura ([[collins2024|Collins et al., 2024]]; [[lemons2016|Lemons et al., 2016]])."},{"type":"heading","text":"Preguntas para el seguimiento"},{"type":"list","items":["¿Qué resuelve el alumno sin ayuda y qué resuelve con apoyo?","¿El cambio se mantiene en sesiones diferentes y con materiales nuevos?","¿El acceso y la familiaridad de las imágenes permiten interpretar la respuesta?","¿El aprendizaje también se muestra en otras actividades y contextos?"]},{"type":"p","text":"Las referencias siguientes permiten consultar las fuentes de la guía. Los DOI se ofrecen como enlaces permanentes cuando están disponibles; la lectura de la guía y sus ilustraciones funciona sin conexión, pero abrir las fuentes externas requiere Internet."}]}],"references":[{"id":"allor2014","authors":"Allor, J. H., Mathes, P. G., Roberts, J. K., Cheatham, J. P., & Al Otaiba, S.","year":"2014","title":"Is scientifically based reading instruction effective for students with below-average IQs?","journal":"Exceptional Children","publication":"80(3), 287–306","doi":"10.1177/0014402914522208","url":"https://doi.org/10.1177/0014402914522208"},{"id":"babb2026","authors":"Babb, S., & Caron, J. G.","year":"2026","title":"Effects of instruction with the Accessible Literacy Learning app on three literacy skills for children who use augmentative and alternative communication","journal":"American Journal of Speech-Language Pathology","publication":"35(2), 431–447","doi":"10.1044/2025_ajslp-25-00218","url":"https://doi.org/10.1044/2025_ajslp-25-00218"},{"id":"biggs2018","authors":"Biggs, E. E., Carter, E. W., & Gilson, C. B.","year":"2018","title":"Systematic review of interventions involving aided AAC modeling for children with complex communication needs","journal":"American Journal on Intellectual and Developmental Disabilities","publication":"123(5), 443–473","doi":"10.1352/1944-7558-123.5.443","url":"https://doi.org/10.1352/1944-7558-123.5.443"},{"id":"card2006","authors":"Card, R., & Dodd, B.","year":"2006","title":"The phonological awareness abilities of children with cerebral palsy who do not speak","journal":"Augmentative and Alternative Communication","publication":"22(3), 149–159","doi":"10.1080/07434610500431694","url":"https://doi.org/10.1080/07434610500431694"},{"id":"caron2021","authors":"Caron, J., Light, J., & McNaughton, D.","year":"2021","title":"Effects of a literacy feature in an augmentative and alternative communication app on single word reading of individuals with severe autism spectrum disorders","journal":"Research and Practice for Persons with Severe Disabilities","publication":"46(1), 18–34","doi":"10.1177/1540796921992123","url":"https://doi.org/10.1177/1540796921992123"},{"id":"caron2022","authors":"Caron, J. G., O’Brien, M., & Weintraub, R.","year":"2022","title":"Online training to improve service provider implementation of letter–sound correspondence instruction for individuals who use augmentative and alternative communication","journal":"American Journal of Speech-Language Pathology","publication":"31(3), 1114–1132","doi":"10.1044/2022_ajslp-21-00142","url":"https://doi.org/10.1044/2022_ajslp-21-00142"},{"id":"castles2018","authors":"Castles, A., Rastle, K., & Nation, K.","year":"2018","title":"Ending the reading wars: Reading acquisition from novice to expert","journal":"Psychological Science in the Public Interest","publication":"19(1), 5–51","doi":"10.1177/1529100618772271","url":"https://doi.org/10.1177/1529100618772271"},{"id":"collins2024","authors":"Collins, S. C., Barton-Hulsey, A., Timm-Fulkerson, C., & Therrien, M. C. S.","year":"2024","title":"AAC & literacy: A scoping review of print knowledge measures for students who use aided augmentative and alternative communication","journal":"Journal of Developmental and Physical Disabilities","publication":"36(4), 615–645","doi":"10.1007/s10882-023-09934-4","url":"https://doi.org/10.1007/s10882-023-09934-4"},{"id":"ehri2014","authors":"Ehri, L. C.","year":"2014","title":"Orthographic mapping in the acquisition of sight word reading, spelling memory, and vocabulary learning","journal":"Scientific Studies of Reading","publication":"18(1), 5–21","doi":"10.1080/10888438.2013.819356","url":"https://doi.org/10.1080/10888438.2013.819356"},{"id":"ehri2001","authors":"Ehri, L. C., Nunes, S. R., Willows, D. M., Schuster, B. V., Yaghoub-Zadeh, Z., & Shanahan, T.","year":"2001","title":"Phonemic awareness instruction helps children learn to read: Evidence from the National Reading Panel’s meta-analysis","journal":"Reading Research Quarterly","publication":"36(3), 250–287","doi":"10.1598/rrq.36.3.2","url":"https://doi.org/10.1598/rrq.36.3.2"},{"id":"erbeli2024","authors":"Erbeli, F., Rice, M., Xu, Y., Bishop, M. E., & Goodrich, J. M.","year":"2024","title":"A meta-analysis on the optimal cumulative dosage of early phonemic awareness instruction","journal":"Scientific Studies of Reading","publication":"28(4), 345–370","doi":"10.1080/10888438.2024.2309386","url":"https://doi.org/10.1080/10888438.2024.2309386"},{"id":"erickson2020","authors":"Erickson, K. A., & Koppenhaver, D. A.","year":"2020","title":"Comprehensive literacy for all: Teaching students with significant disabilities to read and write","publisher":"Paul H. Brookes Publishing Co.","url":"https://products.brookespublishing.com/Comprehensive-Literacy-for-All-P1165.aspx"},{"id":"gonzalez2021","authors":"Gonzalez-Frey, S. M., & Ehri, L. C.","year":"2021","title":"Connected phonation is more effective than segmented phonation for teaching beginning readers to decode unfamiliar words","journal":"Scientific Studies of Reading","publication":"25(3), 272–285","doi":"10.1080/10888438.2020.1776290","url":"https://doi.org/10.1080/10888438.2020.1776290"},{"id":"hessling2022","authors":"Hessling Prahl, A., Jones, R., Schuele, C. M., & Camarata, S.","year":"2022","title":"Phonological awareness intervention using a standard treatment protocol for individuals with Down syndrome","journal":"Child Language Teaching and Therapy","publication":"38(1), 22–42","doi":"10.1177/02656590211033013","url":"https://doi.org/10.1177/02656590211033013"},{"id":"holyfield2026","authors":"Holyfield, C., Pope, L., Frick Semmler, B., DeLuca, T., Zimmerman, B., Jakobs, E., & Light, J.","year":"2026","title":"Effect of AAC technology with embedded literacy supports on the participation of children who are emerging symbolic communicators during shared reading","journal":"International Journal of Speech-Language Pathology","publication":"28(2), 374–386","doi":"10.1080/17549507.2025.2499504","url":"https://doi.org/10.1080/17549507.2025.2499504"},{"id":"hoover1990","authors":"Hoover, W. A., & Gough, P. B.","year":"1990","title":"The simple view of reading","journal":"Reading and Writing","publication":"2(2), 127–160","doi":"10.1007/bf00401799","url":"https://doi.org/10.1007/bf00401799"},{"id":"hulme2012","authors":"Hulme, C., Bowyer-Crane, C., Carroll, J. M., Duff, F. J., & Snowling, M. J.","year":"2012","title":"The causal role of phoneme awareness and letter-sound knowledge in learning to read: Combining intervention studies with mediation analyses","journal":"Psychological Science","publication":"23(6), 572–577","doi":"10.1177/0956797611435921","url":"https://doi.org/10.1177/0956797611435921"},{"id":"lemons2016","authors":"Lemons, C. J., Allor, J. H., Al Otaiba, S., & LeJeune, L. M.","year":"2016","title":"10 research-based tips for enhancing literacy instruction for students with intellectual disability","journal":"TEACHING Exceptional Children","publication":"49(1), 18–30","doi":"10.1177/0040059916662202","url":"https://doi.org/10.1177/0040059916662202"},{"id":"leroux2024","authors":"Leroux, E. L., Biggs, E. E., & Shin, D. E.","year":"2024","title":"Views of parents on supporting language and literacy for their children with complex communication needs","journal":"Language, Speech, and Hearing Services in Schools","publication":"55(1), 69–84","doi":"10.1044/2023_lshss-23-00009","url":"https://doi.org/10.1044/2023_lshss-23-00009"},{"id":"light2025","authors":"Light, J., Holyfield, C., McNaughton, D., Nieder, D., & Preece, J.","year":"2025","title":"Overcoming barriers to literacy for individuals who need or use AAC: Lived experiences, key research findings, and future directions","journal":"Augmentative and Alternative Communication","publication":"41(3), 283–294","doi":"10.1080/07434618.2025.2502032","url":"https://doi.org/10.1080/07434618.2025.2502032"},{"id":"linder2023","authors":"Linder, A.-L., Geyer, M., Atzemian, M., Meuli, N., Martinet, C., de Chambrier, A.-F., & Sermier Dessemontet, R.","year":"2023","title":"Effects of adaptations of a phonics-based reading intervention program on reading and spelling skills of students with intellectual disability who require augmentative and alternative communication","journal":"Frontiers in Education","publication":"8, Article 1190838","doi":"10.3389/feduc.2023.1190838","url":"https://doi.org/10.3389/feduc.2023.1190838"},{"id":"palmqvist2025","authors":"Palmqvist, L., Holmer, E., Samuelsson, J., Thunberg, G., Reichenberg, M., Lundälv, M., & Heimann, M.","year":"2025","title":"Comparison of the effects of single- and multicomponent reading instructions on phonological awareness and reading skills for children with intellectual disability in Sweden","journal":"Disability and Rehabilitation: Assistive Technology","publication":"20(8), 2973–2990","doi":"10.1080/17483107.2025.2519368","url":"https://doi.org/10.1080/17483107.2025.2519368"},{"id":"sargiani2022","authors":"Sargiani, R. de A., Ehri, L. C., & Maluf, M. R.","year":"2022","title":"Teaching beginners to decode consonant-vowel syllables using grapheme-phoneme subunits facilitates reading and spelling as compared with teaching whole-syllable decoding","journal":"Reading Research Quarterly","publication":"57(2), 629–648","doi":"10.1002/rrq.432","url":"https://doi.org/10.1002/rrq.432"},{"id":"sennott2016","authors":"Sennott, S. C., Light, J. C., & McNaughton, D.","year":"2016","title":"AAC modeling intervention research review","journal":"Research and Practice for Persons with Severe Disabilities","publication":"41(2), 101–115","doi":"10.1177/1540796916638822","url":"https://doi.org/10.1177/1540796916638822"},{"id":"sermier2021","authors":"Sermier Dessemontet, R., de Chambrier, A.-F., Martinet, C., Meuli, N., & Linder, A.-L.","year":"2021","title":"Effects of a phonics-based intervention on the reading skills of students with intellectual disability","journal":"Research in Developmental Disabilities","publication":"111, Article 103883","doi":"10.1016/j.ridd.2021.103883","url":"https://doi.org/10.1016/j.ridd.2021.103883"},{"id":"seymour2003","authors":"Seymour, P. H. K., Aro, M., & Erskine, J. M.","year":"2003","title":"Foundation literacy acquisition in European orthographies","journal":"British Journal of Psychology","publication":"94(2), 143–174","doi":"10.1348/000712603321661859","url":"https://doi.org/10.1348/000712603321661859"},{"id":"share1995","authors":"Share, D. L.","year":"1995","title":"Phonological recoding and self-teaching: Sine qua non of reading acquisition","journal":"Cognition","publication":"55(2), 151–218","doi":"10.1016/0010-0277(94)00645-2","url":"https://doi.org/10.1016/0010-0277(94)00645-2"},{"id":"ukrainetz2011","authors":"Ukrainetz, T. A., Nuspl, J. J., Wilkerson, K., & Beddes, S. R.","year":"2011","title":"The effects of syllable instruction on phonemic awareness in preschoolers","journal":"Early Childhood Research Quarterly","publication":"26(1), 50–60","doi":"10.1016/j.ecresq.2010.04.006","url":"https://doi.org/10.1016/j.ecresq.2010.04.006"},{"id":"ulriksen2026a","authors":"Ulriksen, L. B., Bilet-Mossige, M., Larsen, K., & Nordahl-Hansen, A.","year":"2026a","title":"Associations between receptive and expressive vocabulary and early literacy in young students with intellectual disabilities using AAC","journal":"Research in Developmental Disabilities","publication":"169, Article 105239","doi":"10.1016/j.ridd.2026.105239","url":"https://doi.org/10.1016/j.ridd.2026.105239"},{"id":"ulriksen2026b","authors":"Ulriksen, L. B., Bilet-Mossige, M., Larsen, K., & Nordahl-Hansen, A.","year":"2026b","title":"Early reading interventions for children with intellectual disabilities using AAC: A systematic review of single-case designs","journal":"Review Journal of Autism and Developmental Disorders","publication":"Publicación anticipada en línea","doi":"10.1007/s40489-026-00593-7","url":"https://doi.org/10.1007/s40489-026-00593-7"}],"updated":"Octubre de 2026"};
const GUIDE_EDITORIAL_ART={"comencar":"data:image/webp;base64,","abast":"data:image/webp;base64,","evidencia":"data:image/webp;base64,","activitats":"data:image/webp;base64,","acces":"data:image/webp;base64,","mes-enlla":"data:image/webp;base64,","llengues":"data:image/webp;base64,","limits":"data:image/webp;base64,","about":"data:image/webp;base64,