2":"data:image/png;base64,","2262":"data:image/png;base64,","8240":"data:image/png;base64,","7191":"data:image/png;base64,","7182":"data:image/png;base64,","22162":"data:image/png;base64,","7819":"data:image/png;base64,","23993":"data:image/png;base64,","11302":"data:image/png;base64,"};
WORD_ILLUSTRATIONS.arasaac=Object.fromEntries(Object.entries(ARASAAC_WORDS).map(([word,item])=>[word,ARASAAC_IMAGES[item.id]]));
// All three collections are embedded and available offline.
const ILLUSTRATION_STYLES=[['contour',"Sencillas"],['matte',"Detalladas"],['arasaac','ARASAAC']];
const illustrationStyle=p=>ILLUSTRATION_STYLES.some(([id])=>id===p?.pres?.imageStyle)?p.pres.imageStyle:'contour';
function illustratedWord(word,p=S?.p||CUR){
 const style=illustrationStyle(p),src=WORD_ILLUSTRATIONS[style][word];
 if(!src)return null;
 const attrs={src,alt:word,draggable:'false','data-image-style':style,'data-word':word};
 if(style==='arasaac')attrs['data-arasaac-id']=ARASAAC_WORDS[word].id;
 return h('img',attrs);
}
function pic(word,p=S?.p||CUR){
 const custom=Media.urls['img:'+word];
 if(custom)return h('img',{src:custom,alt:word,draggable:'false','data-image-style':'custom'});
 return illustratedWord(word,p);
}
const PICTURE_CONCEPTS=(()=>{
 const parents={},seen=new Map(),find=w=>parents[w]===w?w:(parents[w]=find(parents[w]));
 for(const word of Object.keys(ARASAAC_WORDS))parents[word]=word;
 for(const[word,item]of Object.entries(ARASAAC_WORDS))for(const key of ['id:'+item.id,'label:'+String(item.label).normalize('NFC').toLocaleLowerCase('ca').trim()]){
  if(seen.has(key))parents[find(word)]=find(seen.get(key));else seen.set(key,word);
 }
 return Object.fromEntries(Object.keys(parents).map(word=>[word,find(word)]));
})();
function pictureKey(word,p){
 const custom=Media.urls['img:'+word];
 if(custom)return custom;
 return 'concept:'+(PICTURE_CONCEPTS[word]||word);
}
function arasaacAttribution(){
 return h('p',{class:'muted arasaac-attribution'},"Pictogramas: Sergio Palao. Propiedad: Gobierno de Aragón. Procedencia: ",h('a',{href:'https://arasaac.org/',target:'_blank',rel:'noopener noreferrer'},'ARASAAC'),". Licencia: ",h('a',{href:'https://arasaac.org/terms-of-use',target:'_blank',rel:'noopener noreferrer'},'CC BY-NC-SA'),". Uso no comercial, reconocimiento de la autoría y distribución de los materiales derivados con la misma licencia.");
}
const illustratedPresentation=presView;
presView=function(p,rerender){
 const view=illustratedPresentation(p,rerender);
 const sampleWords=['vaso','manzana','silla','oso','mesa'];
 const preview=h('div',{class:'image-style-preview','aria-live':'polite'});
 const attribution=arasaacAttribution();
 const equivalents=h('details',{class:'arasaac-equivalents'},h('summary',{},"Correspondencias de los pictogramas revisadas"),h('div',{class:'tablewrap'},h('table',{},h('thead',{},h('tr',{},h('th',{},"Palabra de LECAA CAST"),h('th',{},'Pictograma ARASAAC'))),h('tbody',{},...Object.entries(ARASAAC_EQUIVALENTS).map(([word,item])=>h('tr',{},h('td',{},word),h('td',{},h('a',{href:'https://arasaac.org/pictograms/ca/'+item.id,target:'_blank',rel:'noopener noreferrer'},item.label))))))));
 const refresh=()=>{
  preview.replaceChildren(...sampleWords.map(w=>h('figure',{},illustratedWord(w,p),h('figcaption',{},w))));
  attribution.hidden=equivalents.hidden=illustrationStyle(p)!=='arasaac';
 };
 const choice=sel(illustrationStyle(p),ILLUSTRATION_STYLES,value=>{
  p.pres.imageStyle=value;save(p,"Estilo de las imágenes: "+ILLUSTRATION_STYLES.find(([id])=>id===value)[1]);refresh();
 });
 choice.setAttribute('data-image-style-choice','');
 refresh();
 view.querySelector('.card').prepend(h('section',{class:'image-style-settings'},h('h3',{},"Imágenes de las tareas"),field("Estilo de las imágenes",choice,"Los tres estilos cubren las 300 palabras y funcionan sin conexión. La elección se conserva para este perfil; las fotografías propias tienen prioridad."),preview,attribution,equivalents));
 return view;
};



